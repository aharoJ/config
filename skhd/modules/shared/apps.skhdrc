
# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  apps.skhdrc — App Launchers                                               ║
# ║  path: ~/.config/skhd/modules/shared/apps.skhdrc                           ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
# NAMESPACE: rshift (Right Shift) + letter
#
# rshift is the app-launch modifier. It's intercepted at the system level
# before any app sees it, so it never conflicts with in-app shortcuts.
# This is muscle memory — the binding-to-key mapping is stable across rebuilds.
#
# All launches go through `open` (Launch Services → launchd) to avoid
# coalition inheritance from skhd. Direct binary paths cause descendants
# (fish, claude, codex, etc.) to be TCC-attributed to skhd, generating
# spurious "skhd would like to access data" prompts.
# `open -a`  = focus existing or launch.   `open -na` = always new instance.


# ── Browsers ─────────────────────────────────────────────────────────────
rshift - g : open -na "Google Chrome" --args --new-window "https://www.google.com/"
rshift - v : open -na "Vivaldi"

# ── Utilities ────────────────────────────────────────────────────────────
rshift - f : open -a "Finder"
rshift - d : open -a "Discord"

# ── Terminal ─────────────────────────────────────────────────────────────
rshift - a : open -na "Ghostty"
# rshift - a : /Applications/Ghostty.app/Contents/MacOS/ghostty
