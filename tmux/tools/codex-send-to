#!/usr/bin/env python3
"""Worktree I03b launcher; exec the adjacent staged Rust runtime only."""
import os
from pathlib import Path
import sys

try:
    runtime = Path(__file__).resolve().with_name('angelstar-runtime')
    os.execv(str(runtime), [str(runtime), '--surface', 'codex-send-to', *sys.argv[1:]])
except OSError as error:
    print('relay: staged runtime unavailable: ' + str(error), file=sys.stderr)
    sys.exit(1)
