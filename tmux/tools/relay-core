#!/usr/bin/env python3
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import time
import unicodedata
import uuid

TOOLS = Path(__file__).resolve().parent
ROOT = Path(os.environ.get('CC_MSG_INBOX_ROOT', str(Path.home() / 'desk/tmp/inbox')))
FIELDS = ['session_name', 'window_name', 'pane_id', 'pane_pid', 'pane_current_command', 'pane_dead', 'pane_in_mode', 'cursor_x', 'cursor_y', 'pane_width', 'pane_height']


def tmux(*args, input=None):
    command = [os.environ.get('TMUX_BIN', 'tmux')]
    socket = os.environ.get('TMUX', '').split(',')[0]
    if os.environ.get('TMUX_LAB_RECORD'):
        command += ['-L', os.environ['TMUX_LAB_SOCKET'], '-f', '/dev/null']
    elif socket:
        command += ['-S', socket]
    result = subprocess.run(command + list(args), input=input, text=True, capture_output=True, timeout=5)
    if result.returncode:
        raise RuntimeError(result.stderr.strip())
    return result.stdout.rstrip('\n')


def panes():
    rows = tmux('list-panes', '-a', '-F', '\t'.join('#{' + key + '}' for key in FIELDS))
    return [dict(zip(FIELDS, row.split('\t'))) for row in rows.splitlines()]


def target(session, window, pane=''):
    sessions = [row.split('\t', 1) for row in tmux('list-sessions', '-F', '#{session_id}\t#{session_name}').splitlines()]
    ids = [sid for sid, name in sessions if name == session]
    if len(ids) != 1:
        raise ValueError('name one live exact session: ' + session)
    windows = [row.split('\t', 2) for row in tmux('list-windows', '-t', ids[0], '-F', '#{window_id}\t#{window_name}\t#{window_index}').splitlines()]
    matches = [row for row in windows if row[1] == window]
    if not matches and window.isdigit():
        matches = [row for row in windows if row[2] == window]
    if len(matches) != 1:
        raise ValueError('name one live exact window: ' + window)
    rows = tmux('list-panes', '-t', matches[0][0], '-F', '\t'.join('#{' + key + '}' for key in FIELDS))
    candidates = [dict(zip(FIELDS, row.split('\t'))) for row in rows.splitlines()]
    candidates = [row for row in candidates if row['pane_dead'] == '0' and (not pane or row['pane_id'] == pane)]
    if len(candidates) != 1:
        raise ValueError('name one live pane in ' + session + ':' + window)
    row = candidates[0]
    if row['session_name'] != session or row['window_name'] != matches[0][1]:
        raise ValueError('the named target is not a live interactive agent: ' + repr(row))
    return row


def source():
    rows = panes()
    table = {}
    for line in subprocess.run(['ps', '-axo', 'pid=,ppid='], capture_output=True, text=True, timeout=5).stdout.splitlines():
        pid, parent = line.split()
        table[int(pid)] = int(parent)
    pid = os.getpid()
    while pid > 1 and pid in table:
        matches = [row for row in rows if row['pane_pid'] == str(pid)]
        if len(matches) == 1:
            return matches[0]
        pid = table[pid]
    matches = [row for row in rows if row['pane_id'] == os.environ.get('TMUX_PANE')]
    return matches[0] if len(matches) == 1 else None


def save(path, data):
    temporary = path.with_suffix('.new')
    temporary.write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\n')
    temporary.replace(path)


def snapshot(row):
    current = target(row['session_name'], row['window_name'], row['pane_id'])
    if any(current[key] != row[key] for key in ('pane_id', 'pane_pid', 'pane_current_command')):
        raise ValueError('the named interactive pane changed')
    capture = tmux('capture-pane', '-p', '-e', '-t', current['pane_id'])
    after = target(row['session_name'], row['window_name'], row['pane_id'])
    return current, capture, current == after


def glyph(capture, y):
    rows = visible(capture).splitlines()
    if y < len(rows):
        match = re.match(r'^\s*([❯›>])', rows[y])
        if match:
            return match[1]
    for line in reversed(rows[:y + 1]):
        match = re.match(r'^\s*([❯›>])', line)
        if match:
            return match[1]
    return ''


def visible(value):
    return re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x1b\x07]*(?:\x07|\x1b\\)', '', value)


def empty(row, capture):
    if row['pane_in_mode'] != '0':
        return False
    marker = glyph(capture, int(row['cursor_y']))
    if not marker:
        return False
    result = subprocess.run([str(TOOLS / 'relay-input-guard'), marker, row['cursor_x'], row['cursor_y'], row['pane_width']], input=capture + '\n', text=True, capture_output=True, timeout=5)
    return result.returncode == 0


def keys(row, values):
    current = target(row['session_name'], row['window_name'], row['pane_id'])
    if current['pane_pid'] != row['pane_pid']:
        raise ValueError('the named pane changed before the explicit action')
    condition = '#{&&:#{==:#{pane_id},' + row['pane_id'] + '},#{==:#{pane_pid},' + row['pane_pid'] + '}}'
    command = shlex.join(['send-keys', '-t', row['pane_id'], *values]) + ' ; display-message -p -t ' + row['pane_id'] + ' "action:#{pane_id}"'
    receipt = tmux('if-shell', '-F', '-t', row['pane_id'], condition, command, 'display-message -p "changed"')
    if receipt != 'action:' + row['pane_id']:
        raise RuntimeError('explicit action target changed')


def clear(row, interrupt=False):
    if interrupt:
        keys(row, ['Escape'])
        time.sleep(.1)
    for _ in range(20):
        keys(row, ['C-e', 'C-u'])
        time.sleep(.1)
        current, capture, stable = snapshot(row)
        if stable and empty(current, capture):
            return
    raise RuntimeError('clear sent; composer is still changing in the named pane')


def cells(value):
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in 'WF' else 1 for c in value)


def payload(data, width):
    message = data['message'] if data.get('literal') else data['label'] + ': ' + data['message']
    if cells(message) <= width - 4:
        return message
    archive = Path.home() / 'desk/tmp/relay' / (data['id'][:8] + '.md')
    archive.parent.mkdir(parents=True, exist_ok=True)
    archive.write_text(message + '\n')
    return data['label'] + ': ' + ' '.join(dict.fromkeys(re.findall(r'#[A-Za-z0-9_-]+', data['message']))) + ' -- full: ' + str(archive).replace(str(Path.home()), '~')


def composer_matches(row, capture, message):
    lines = visible(capture).splitlines()
    y = int(row['cursor_y'])
    if y >= len(lines):
        return False
    marker = glyph(capture, y)
    match = re.match(r'^\s*' + re.escape(marker) + r'[ \u00a0]', lines[y]) if marker else None
    if not match or lines[y][match.end():].rstrip(' ') != message:
        return False
    if int(row['cursor_x']) != cells(lines[y][:match.end()] + message):
        return False
    if marker in ('❯', '>'):
        return y + 1 < len(lines) and re.fullmatch(r'─{8,}', lines[y + 1].strip()) is not None
    return y + 2 < len(lines) and lines[y + 1] == '' and lines[y + 2].startswith('  ')


def gate(path, row, mode, action):
    check = shlex.join(['env', 'TMUX=' + os.environ.get('TMUX', ''), 'TMUX_BIN=' + os.environ.get('TMUX_BIN', 'tmux'), *[key + '=' + os.environ[key] for key in ('TMUX_LAB_RECORD', 'TMUX_LAB_SOCKET', 'TMUX_LAB_OWNER_PID', 'TMUX_LAB_OWNER_START', 'TMUX_LAB_TOKEN') if key in os.environ], sys.executable, str(TOOLS / 'relay-core'), '--check', str(path), mode])
    condition = '#{&&:#{==:#{pane_id},' + row['pane_id'] + '},#{&&:#{==:#{pane_pid},' + row['pane_pid'] + '},#{&&:#{==:#{pane_in_mode},0},#{&&:#{==:#{cursor_x},' + row['cursor_x'] + '},#{==:#{cursor_y},' + row['cursor_y'] + '}}}}}'
    for key in ('session_name', 'window_name'):
        value = row[key].replace('#', '##').replace(',', '#,').replace('}', '#}')
        condition = '#{&&:' + condition + ',#{==:#{' + key + '},' + value + '}}'
    nested = shlex.join(['if-shell', '-F', '-t', row['pane_id'], condition, action, 'display-message -p "wait"'])
    return tmux('if-shell', '-t', row['pane_id'], check, nested, 'display-message -p "wait"')


def check(path, mode):
    data = json.loads(path.read_text())
    row, capture, stable = snapshot(data['target'])
    return stable and (empty(row, capture) if mode == 'empty' else composer_matches(row, capture, data['payload']))


def deliver(path):
    data = json.loads(path.read_text())
    row = data['target']
    lock_path = path.parent / (hashlib.sha256((os.environ.get('TMUX', '') + row['pane_id']).encode()).hexdigest() + '.lock')
    with lock_path.open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if data.get('operator'):
            clear(row, interrupt=True)
            data['operator'] = False
        data['state'] = 'waiting'
        save(path, data)
        while True:
            current, capture, stable = snapshot(row)
            if stable and empty(current, capture):
                break
            time.sleep(.25)
        message = payload(data, int(current['pane_width']))
        data['payload'] = message
        if cells(message) > int(current['pane_width']) - 4:
            raise ValueError('archive pointer needs a wider composer; full message is saved at ' + str(path))
        buffer = 'relay-' + data['id']
        tmux('load-buffer', '-b', buffer, '-', input=message)
        current, capture, stable = snapshot(row)
        if not stable or not empty(current, capture):
            tmux('delete-buffer', '-b', buffer)
            return False
        data['state'] = 'sending'
        save(path, data)
        receipt = gate(path, current, 'empty', 'paste-buffer -p -d -t ' + row['pane_id'] + ' -b ' + buffer + ' ; display-message -p -t ' + row['pane_id'] + ' "pasted:#{pane_id}"')
        if receipt == 'wait':
            tmux('delete-buffer', '-b', buffer)
            return False
        if receipt != 'pasted:' + row['pane_id']:
            raise RuntimeError('paste receipt missing; inspect ' + str(path))
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            current, capture, stable = snapshot(row)
            if stable and composer_matches(current, capture, message):
                receipt = gate(path, current, 'payload', 'send-keys -t ' + row['pane_id'] + ' Enter ; display-message -p -t ' + row['pane_id'] + ' "submitted:#{pane_id}"')
                if receipt == 'submitted:' + row['pane_id']:
                    data.update(state='delivered', submitted=time.time())
                    save(path, data)
                    return True
                if receipt != 'wait':
                    raise RuntimeError('submission receipt missing; inspect ' + str(path))
            time.sleep(.1)
        raise RuntimeError('pasted composer changed; message retained in pane; inspect ' + str(path))


def worker(path):
    try:
        while not deliver(path):
            time.sleep(.25)
    except Exception as error:
        data = json.loads(path.read_text())
        data.update(state='error', error=str(error))
        save(path, data)


def main(adapter, args):
    if args[:1] == ['--deliver']:
        worker(Path(args[1]))
        return 0
    if args in (['--help'], ['-h']) or (adapter == 'relay' and not args):
        print('usage: relay <session>:<window> <text> | relay status [id]\nCC_MSG_SESSION=<session> CC_MSG_WINDOW=<window> cc-msg <text>\nCODEX_SEND_SESSION=<session> codex-send-to <window> <text>\nAGY_SEND_SESSION=<session> agy-send-to <window> <text>')
        return 0
    if adapter == 'relay' and args[:1] == ['status']:
        for path in ROOT.glob('*/*.json'):
            try:
                data = json.loads(path.read_text())
                if 'id' in data and 'state' in data and (len(args) == 1 or data['id'].startswith(args[1])):
                    print(data['id'], data['state'], data.get('error', ''), str(path))
            except (ValueError, OSError):
                continue
        return 0
    operator = '--operator' in args or '-O' in args
    args = [value for value in args if value not in ('--operator', '-O')]
    origin = source()
    prefix = 'CC_MSG' if adapter == 'claude' else 'AGY_SEND' if adapter == 'agy' else 'CODEX_SEND'
    session = os.environ.get(prefix + '_SESSION') or (origin['session_name'] if origin else '')
    window = os.environ.get(prefix + '_WINDOW') or ('claude' if adapter == 'claude' else 'agy' if adapter == 'agy' else 'codex')
    if adapter == 'relay':
        session, window = args.pop(0).rsplit(':', 1)
    elif adapter in ('codex-to', 'agy'):
        window = args.pop(0)
    row = target(session, window, os.environ.get(prefix + '_PANE', ''))
    if args[:1] == ['--keys']:
        keys(row, args[1:])
        print('relay: explicit keys sent to', session + ':' + row['window_name'])
        return 0
    if args[:1] == ['--clear-draft']:
        clear(row, interrupt=operator)
        print('relay: cleared', session + ':' + row['window_name'])
        return 0
    if adapter == 'claude':
        allow_self = '--allow-self' in args
        args = [value for value in args if value != '--allow-self']
        if args and re.fullmatch(r'\S+:\S+', args[0]):
            raise ValueError('cc-msg takes text, not a session:window positional; set CC_MSG_SESSION and CC_MSG_WINDOW or use relay')
        if origin and row['pane_id'] == origin['pane_id'] and not allow_self:
            raise ValueError('cc-msg self-send refused; name another target or explicitly use --allow-self')
    message = ' '.join(' '.join(args).split()) if args else ' '.join(sys.stdin.read().split())
    if not message:
        raise ValueError('provide a message')
    identifier = uuid.uuid4().hex
    literal = operator and message.startswith(('/', '!'))
    if not literal and not re.search(r'#[A-Za-z0-9_-]+', message):
        message = '#' + identifier[:6] + ' ' + message
    label = origin['window_name'] + ' (' + origin['session_name'] + ':' + origin['window_name'] + ')' if origin else 'relay'
    folder = ROOT / (hashlib.sha256((session + ':' + window).encode()).hexdigest()[:16])
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / (identifier + '.json')
    save(path, dict(id=identifier, state='pending', created=time.time(), target=row, label=label, message=message, operator=operator, literal=literal))
    log = path.with_suffix('.log').open('a')
    child = subprocess.Popen([sys.executable, str(TOOLS / 'relay-core'), '--deliver', str(path)], stdout=log, stderr=log, start_new_session=True)
    log.close()
    deadline = time.monotonic() + 1
    while child.poll() is None and time.monotonic() < deadline:
        time.sleep(.05)
    data = json.loads(path.read_text())
    print('relay:', identifier, data['state'] + ';', 'record', path)
    if data['state'] == 'error':
        print(data['error'], file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    try:
        args = sys.argv[1:]
        if args[:1] == ['--check']:
            sys.exit(0 if check(Path(args[1]), args[2]) else 1)
        adapter = 'relay' if args[:1] == ['--deliver'] else args.pop(0)
        sys.exit(main(adapter, args))
    except (ValueError, IndexError, OSError, RuntimeError, subprocess.SubprocessError) as error:
        print('relay:', error, file=sys.stderr)
        sys.exit(1)
