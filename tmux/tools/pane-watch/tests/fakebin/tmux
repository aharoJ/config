#!/bin/bash
# path: ~/.config/tmux/tools/pane-watch/tests/fakebin/tmux
# description: Replay watcher fixture frames and private server identity.
# patched: provide server and process identity for watcher lock and coverage checks
# date: 2026-10-01
# Stub tmux: replays fixture frames as pane captures and answers identity/geometry queries.
fx="$PW_FIXTURE"; ctr="$PW_COUNTER"
case "${1:-}" in
  display-message)
    fmt=""; for a in "$@"; do fmt="$a"; done
    case "$fmt" in
      '#{pane_id}')     echo "%13"; exit 0 ;;
      '#{socket_path}') echo /tmp/pane-watch-test.socket; exit 0 ;;
      '#{pid}:#{pane_pid}') echo 999:100; exit 0 ;;
      '#{pane_height}:#{pid}:#{pane_pid}') if [ "${PW_HEIGHT_DYNAMIC:-0}" = "1" ]; then n=$(cat "$ctr" 2>/dev/null || echo 0); [ "$n" -ge 4 ] && echo 57:999:100 || echo 59:999:100
                        else echo "${PW_HEIGHT:-59}:999:100"; fi; exit 0 ;;
      *)                echo "0 node TEST codex /tmp/project"; exit 0 ;;
    esac ;;
  list-panes) echo "%13"; exit 0 ;;
esac
n=$(cat "$ctr" 2>/dev/null || echo 0); n=$((n+1)); echo "$n" > "$ctr"
if [ -f "$fx/FAILAFTER" ]; then fa=$(cat "$fx/FAILAFTER"); [ "$n" -gt "$fa" ] && { echo "can't find pane: %13" >&2; exit 1; }; fi
max=$(ls "$fx" | grep -oE '^[0-9]+' | sort -n | tail -1)
[ "$n" -gt "$max" ] && n=$max
if [ -f "$fx/$n.full" ]; then cat "$fx/$n.full"; else cat "$fx/$n.vis"; fi
