#!/bin/bash
# path: ~/.config/tmux/tools/pane-watch/tests/run
# description: Replay one watcher fixture using mandatory offline dependencies.
# patched: refuse missing fake dependencies and remove isolated fixture state on exit
# date: 2026-10-01
HERE="$(cd "$(dirname "$0")" && pwd)"
[ -x "$HERE/fakebin/tmux" ] && [ -x "$HERE/fakebin/sleep" ] || { echo 'missing offline watcher dependencies' >&2; exit 1; }
S="$1"; c="$2"; shift 2
scratch="$(mktemp -d "${TMPDIR:-/tmp}/pane-watch-fixture.XXXXXX")" || exit 1
trap 'rm -rf "$scratch"' EXIT
PATH="$HERE/fakebin:$PATH" PW_POLL=0 TMPDIR="$scratch" \
  PW_FIXTURE="$HERE/fx/$c" PW_COUNTER="$scratch/counter" \
  timeout 3 bash "$S" --pane %13 --ui codex "$@" 2>&1
echo "exit=$?"
