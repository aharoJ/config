sys.dont_write_bytecode = True
VERSION = '1'
IDENTIFIER = 'config-panel-dispatch'
SOURCE = Path(__file__).resolve()
TOOLS = SOURCE.parent
REPO = TOOLS.parents[1]
MAX_BYTES = 64 * 1024 * 1024
START = '#panel-start Read PROMPT.md in this folder and follow it exactly.'
KINDS = {'astra': 'codex-jsonl', 'fable': 'claude-jsonl', 'deepseek': 'claude-jsonl', 'gemini': 'agy-jsonl'}
FORBIDDEN = ('.git', 'AGENTS.md', 'CLAUDE.md', '.claude', '.codex', '.gemini')


def require(condition, message):
    if not condition:
        raise ValueError(message)


def now():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds')


def pairs(values):
    result = {}
    for key, value in values:
        require(key not in result, 'duplicate JSON key: ' + key)
        result[key] = value
    return result


def decode(data):
    depth = 0
    quoted = escaped = False
    for character in data.decode() if isinstance(data, bytes) else data:
        if quoted:
            if escaped:
                escaped = False
            elif character == '\\':
                escaped = True
            elif character == '"':
                quoted = False
        elif character == '"':
            quoted = True
        elif character in '[{':
            depth += 1
            require(depth <= 32, 'JSON depth exceeds limit')
        elif character in ']}':
            depth -= 1
    return json.loads(data, object_pairs_hook=pairs, parse_constant=lambda value: require(False, 'nonfinite JSON'))


def path_bytes(path):
    path = Path(path)
    require(path.is_absolute() and str(path) == os.path.normpath(path), 'absolute canonical path required')
    descriptors, rails = [], []
    identity = lambda value: (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_ctime_ns)
    try:
        parent = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
        descriptors.append(parent)
        for part in path.parts[1:-1]:
            before = os.stat(part, dir_fd=parent, follow_symlinks=False)
            require(stat.S_ISDIR(before.st_mode), 'symlinked/non-directory evidence ancestor')
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
            descriptors.append(child)
            held = os.fstat(child)
            require((held.st_dev, held.st_ino) == (before.st_dev, before.st_ino), 'evidence ancestor replaced')
            rails.append((parent, part, child, held.st_dev, held.st_ino))
            parent = child
        info = os.stat(path.name, dir_fd=parent, follow_symlinks=False)
        require(stat.S_ISREG(info.st_mode) and info.st_size <= MAX_BYTES, 'regular bounded evidence required')
        descriptor = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=parent)
        with os.fdopen(descriptor, 'rb') as stream:
            held = os.fstat(stream.fileno())
            data = stream.read(MAX_BYTES + 1)
            after = os.fstat(stream.fileno())
        require(identity(info) == identity(held) == identity(after) == identity(os.stat(path.name, dir_fd=parent, follow_symlinks=False)), 'evidence changed while read')
        for directory, name, child, device, inode in rails:
            named = os.stat(name, dir_fd=directory, follow_symlinks=False)
            require(stat.S_ISDIR(named.st_mode) and (named.st_dev, named.st_ino) == (device, inode) == (os.fstat(child).st_dev, os.fstat(child).st_ino), 'evidence ancestor changed')
        require(len(data) <= MAX_BYTES, 'evidence byte limit')
        return data
    finally:
        for descriptor in reversed(descriptors):
            os.close(descriptor)


def ref(path):
    return dict(path=str(path), sha256=hashlib.sha256(path_bytes(path)).hexdigest())


def read(reference, *, json_proof=True):
    require(isinstance(reference, dict) and set(reference) == {'path', 'sha256'}, 'closed evidence reference required')
    require(isinstance(reference['sha256'], str) and re.fullmatch('[0-9a-f]{64}', reference['sha256']), 'SHA256 required')
    data = path_bytes(reference['path'])
    require(not json_proof or len(data) <= 256 * 1024, 'JSON proof byte limit')
    require(hashlib.sha256(data).hexdigest() == reference['sha256'], 'evidence hash mismatch: ' + reference['path'])
    return decode(data) if json_proof else data


def fresh(path, data):
    path = Path(path)
    require(path.is_absolute() and not any(p.is_symlink() for p in path.parents), 'real absolute output path required')
    data = data if isinstance(data, bytes) else (json.dumps(data, indent=2, ensure_ascii=False) + '\n').encode()
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, 'wb') as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    path.chmod(0o444)
    return ref(path)


def run(args, *, cwd=None, env=None, timeout=30):
    if args[0] == 'tmux' and os.environ.get('TMUX_LAB_SOCKET'):
        args = [os.environ['TMUX_BIN'], '-L', os.environ['TMUX_LAB_SOCKET'], '-f', '/dev/null', *args[1:]]
    result = subprocess.run(args, cwd=cwd, env=env, capture_output=True, text=True, timeout=timeout)
    require(result.returncode == 0, 'command refused: ' + shlex.join(args) + ': ' + result.stderr.strip())
    return result.stdout.strip()


def protocol(root):
    root = Path(root)
    require(root.is_absolute() and not root.is_symlink(), 'explicit real protocol checkout required')
    sys.path.insert(0, str(root))
    import agentic_consumers
    import ledger_schema
    require(all(Path(module.__file__).resolve().parent == root.resolve() for module in (agentic_consumers, ledger_schema)), 'wrong protocol module loaded')
    return agentic_consumers, ledger_schema


def context_of(request):
    return {key: request[key] for key in ('topic', 'cycle_type', 'cycle', 'round')}


def launch_slot(request):
    scope = dict(project_root=str(Path(request['project_root']).resolve()), **context_of(request))
    key = hashlib.sha256(json.dumps(scope, sort_keys=True).encode()).hexdigest()
    return Path.home() / '.local/state/panel-dispatch/initial-launches' / (key + '.json')


def first_attempt_check(request, reference):
    proof = read(request['first_attempt_ref'])
    require(proof.get('context') == context_of(request) and proof.get('project_root') == request['project_root'] and proof.get('roster') == request['roster'], 'initial attempt authority binding mismatch')
    require(proof.get('independent') is True and proof.get('authorized') is True and proof.get('prior_attempts') == [], 'v1 requires independently authorized first attempts; replacements unsupported')
    require(not Path(request['first_attempt_ref']['path']).is_relative_to(Path(request['project_root'])), 'first attempt authority must be external')
    state = Path(request['project_root']) / 'reviews' / request['topic'] / 'state' / request['cycle_type']
    require(not (state / ('resolve-r' + str(request['round']) + '.json')).exists(), 'existing round ledger makes first-attempt authority ambiguous')
    slot = launch_slot(request)
    if slot.exists():
        claim = decode(path_bytes(slot))
        require(claim.get('request_ref') == reference, 'round already claimed by another current attempt; replacement unsupported')


def claim_launch(request, reference):
    first_attempt_check(request, reference)
    slot = launch_slot(request)
    slot.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    require(slot.parent.resolve() == slot.parent and slot.parent.stat().st_uid == os.getuid() and stat.S_IMODE(slot.parent.stat().st_mode) == 0o700, 'unsafe initial-launch claim directory')
    result = fresh(slot, dict(request_ref=reference, context=context_of(request), project_root=request['project_root'], first_attempt_ref=request['first_attempt_ref'], created_at=now(), scope='one initial launch only; never admission or supersession authority'))
    descriptor = os.open(slot.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    return result


def request_check(reference):
    value = read(reference)
    required = {'version', 'project_root', 'protocol_root', 'topic', 'cycle_type', 'cycle', 'round', 'session',
                'packet', 'roster', 'redispatch_policy_ref', 'launcher_ref', 'first_attempt_ref', 'deadline_seconds', 'authorized', 'authorized_at'}
    require(set(value) == required and value['version'] == VERSION and value['authorized'] is True, 'closed authorized v1 launch request required')
    require(re.fullmatch('[a-z0-9][a-z0-9-]*', value['topic']), 'invalid topic')
    require(value['cycle_type'] in ('research', 'implementation') and isinstance(value['cycle'], str) and value['cycle'].strip(), 'invalid cycle')
    require(type(value['round']) is int and value['round'] > 0, 'invalid round')
    require(re.fullmatch('[A-Za-z0-9_-]+', value['session']), 'exact named session required')
    require(type(value['deadline_seconds']) is int and 1 <= value['deadline_seconds'] <= 3600, 'bounded deadline required')
    root = Path(value['project_root'])
    require(root.is_absolute() and root.is_dir(), 'reviewed project root required')
    require(not Path(reference['path']).is_relative_to(root), 'launch authority must be external')
    consumers, schema = protocol(value['protocol_root'])
    packet = value['packet']
    require(set(packet) == {'canonical_input', 'delivered_input', 'manifest', 'prompt', 'projection_review'}, 'closed packet required')
    canonical = read(packet['canonical_input'], json_proof=False)
    manifest = read(packet['manifest'])
    stem = 'audit' if value['cycle_type'] == 'implementation' else 'research'
    expected = root / 'reviews' / value['topic'] / 'intakes' / (stem + '-r' + str(value['round']))
    require(packet['canonical_input']['path'] == str(expected) + '.md' and packet['manifest']['path'] == str(expected) + '.manifest.json', 'wrong canonical intake location')
    require(not any(Path(str(expected) + suffix).exists() for suffix in ('.commit-marker.json', '.commit-marker.json.tmp', '.md.tmp', '.manifest.json.tmp')), 'pending canonical publication')
    require(manifest.get('status') == 'PASS' and manifest.get('sha256') == 'sha256:' + packet['canonical_input']['sha256'] and manifest.get('bytes') == len(canonical) and manifest.get('output') == packet['canonical_input']['path'], 'compiler manifest mismatch')
    read(packet['delivered_input'], json_proof=False)
    read(packet['prompt'], json_proof=False)
    projection = read(packet['projection_review'])
    require(projection.get('context') == context_of(value) and projection.get('canonical_input') == packet['canonical_input'] and projection.get('delivered_input') == packet['delivered_input'] and projection.get('prompt') == packet['prompt'], 'projection/prompt identity mismatch')
    require(projection.get('exclusion_pass') is True and projection.get('fidelity_pass') is True and projection.get('independent') is True and projection.get('unknown_fields') == [], 'unresolved independent projection check')
    launcher = read(value['launcher_ref'])
    require(launcher.get('context') == context_of(value) and launcher.get('adapter') == adapter() and launcher.get('authorized') is True, 'launcher identity/authority mismatch')
    require(launcher.get('tai_sha256') == ref(REPO / 'fish/internal/tmux/tai.fish')['sha256'] and launcher.get('trust_sha256') == ref(TOOLS / 'panel-seat-trust')['sha256'], 'launcher source drift')
    require(ref(Path.home() / '.config/tmux/tools/panel-seat-trust')['sha256'] == launcher['trust_sha256'], 'installed trust helper differs from bound launcher')
    policy = read(value['redispatch_policy_ref'])
    require(policy.get('context') == context_of(value) and policy.get('authorized') is True and type(policy.get('max_redispatches')) is int and policy['max_redispatches'] == 0 and policy.get('exhaustion') == 'non-response', 'v1 requires an explicit zero automatic-redispatch budget; exhaustion is non-response')
    require(isinstance(policy.get('technical_causes'), list) and all(isinstance(c, str) and c for c in policy['technical_causes']), 'technical causes required')
    instants = [dt.datetime.fromisoformat(text.replace('Z', '+00:00')) for text in (policy.get('authorized_at', ''), value['authorized_at'], now())]
    require(all(instant.tzinfo is not None for instant in instants) and instants[0] <= instants[1] <= instants[2], 'prospective authority timing mismatch')
    roster = value['roster']
    require(isinstance(roster, list) and 1 <= len(roster) <= 64, 'bounded operator roster required')
    require(len({seat['seat_id'] for seat in roster}) == len(roster) and len({seat['window'] for seat in roster}) == len(roster), 'duplicate seat or exact window')
    for seat in roster:
        require(set(seat) == {'seat_id', 'attempt_id', 'transport', 'window', 'model', 'effort', 'accepted_limitations'}, 'closed roster row required')
        require(all(isinstance(seat[key], str) and re.fullmatch('[A-Za-z0-9._-]+', seat[key]) for key in ('seat_id', 'attempt_id', 'model', 'effort')), 'invalid seat identity/profile')
        require(seat['transport'] in KINDS and isinstance(seat['accepted_limitations'], list), 'unsupported transport')
        require(isinstance(seat['window'], str) and re.fullmatch('[A-Za-z0-9_-]+', seat['window']), 'exact safe window name required')
        if seat['transport'] == 'gemini':
            require('outside-writes-not-confined' in seat['accepted_limitations'], 'Agy limitation not accepted')
    first_attempt_check(value, reference)
    read(reference)
    return value


def adapter():
    return dict(id=IDENTIFIER, version=VERSION, source_sha256=ref(SOURCE)['sha256'])


def process_api():
    namespace = dict(__name__='panel_process_custody', __file__=str(TOOLS / 'tmux-lab'))
    exec(compile(path_bytes(TOOLS / 'tmux-lab'), namespace['__file__'], 'exec'), namespace)
    return namespace


def process_identity(pid):
    api = process_api()
    info = api['kernel_process'](int(pid))
    require(info is not None and info['uid'] == os.getuid(), 'owned pane process identity unavailable')
    identity = api['unique_identity'](int(pid))
    require(identity is not None, 'kernel unique process identity unavailable')
    return dict(pid=int(pid), unique_id=identity, **info)


def process_custody(root):
    graph = {}
    for line in run(['ps', '-axo', 'pid=,ppid=']).splitlines():
        pid, parent = map(int, line.split())
        graph.setdefault(parent, []).append(pid)
    queue, found = [int(root)], []
    while queue:
        pid = queue.pop()
        try:
            found.append(process_identity(pid))
        except ValueError:
            continue
        queue.extend(graph.get(pid, []))
    require(found and found[0]['pid'] == int(root), 'pane process custody unavailable')
    return found


def remaining_processes(custody):
    api = process_api()
    remaining = []
    for held in custody:
        current = api['kernel_process'](held['pid'])
        if current is not None and current['uid'] == held['uid'] and current['birth'] == held['birth'] and api['unique_identity'](held['pid']) == held['unique_id']:
            remaining.append(held)
    return remaining


def ancestors(folder):
    require(folder.is_absolute() and folder.resolve() == folder and not folder.is_symlink(), 'physical seat required')
    for parent in (folder, *folder.parents):
        require(not any((parent / name).exists() for name in FORBIDDEN), 'ambient context in ' + str(parent))
    slug = re.sub('[^A-Za-z0-9-]', '-', str(folder))
    for path in (Path.home() / '.claude/projects' / slug, Path.home() / '.claude/projects' / slug.replace('-private-tmp-', '-tmp-', 1)):
        require(not path.exists(), 'existing Claude project/context for fresh seat')


def prepare(args):
    authority = dict(path=args.request, sha256=args.sha256)
    request = request_check(authority)
    batch = Path(args.batch)
    require(batch.is_absolute() and not batch.exists() and not batch.is_relative_to(Path(request['project_root'])), 'fresh external batch required')
    batch.mkdir(mode=0o700)
    rows = []
    for seat in request['roster']:
        folder = Path(tempfile.mkdtemp(prefix='review-protocol-' + request['topic'] + '-audit-r' + str(request['round']) + '-agentic-' + seat['attempt_id'] + '-' + seat['transport'] + '-', suffix='-cli', dir='/private/tmp'))
        ancestors(folder)
        inputs = {}
        for name, key in (('PROMPT.md', 'prompt'), ('intake.md', 'delivered_input')):
            inputs[name] = fresh(folder / name, read(request['packet'][key], json_proof=False))
        rows.append(dict(**seat, directory=str(folder), inputs=inputs, prepared_at=now()))
    receipt = dict(phase='prepared', context=context_of(request), request_ref=authority, adapter=adapter(), batch=str(batch), seats=rows, created_at=now())
    return fresh(batch / 'prepared.json', receipt)


def prepared_check(record, *, runtime=False):
    request = request_check(record['request_ref'])
    require(record['adapter'] == adapter() and record['context'] == context_of(request), 'prepared source/context drift')
    require(len(record['seats']) == len(request['roster']), 'prepared roster length mismatch')
    for seat, wanted in zip(record['seats'], request['roster']):
        require(all(seat[key] == wanted[key] for key in wanted), 'prepared roster order/profile changed')
        folder = Path(seat['directory'])
        info = folder.lstat()
        require(stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid() and info.st_mode & 0o777 == 0o700, 'seat ownership/mode drift')
        names = set(p.name for p in folder.iterdir())
        allowed = {'PROMPT.md', 'intake.md'}
        if runtime:
            allowed |= {'scratch', 'panel-settings.json', 'panel-env.sh', 'panel-temp.json', 'unleash-repo-schema-v1-codeium-language-server.json'}
        require(names <= allowed and {'PROMPT.md', 'intake.md'} <= names, 'unexpected prepared/runtime files')
        for name, reference in seat['inputs'].items():
            require(reference['path'] == str(folder / name) and (folder / name).stat().st_mode & 0o222 == 0, 'frozen input path/mode drift')
            read(reference, json_proof=False)
        require(seat['inputs']['PROMPT.md']['sha256'] == request['packet']['prompt']['sha256'] and seat['inputs']['intake.md']['sha256'] == request['packet']['delivered_input']['sha256'], 'delivered copy binding mismatch')
    return request


def panes(session):
    rows = run(['tmux', 'list-panes', '-a', '-F', '#{session_name}\t#{window_name}\t#{window_id}\t#{pane_id}\t#{pane_pid}\t#{pane_current_command}\t#{pane_current_path}'])
    return [dict(zip(('session', 'window', 'window_id', 'pane_id', 'pid', 'command', 'cwd'), row.split('\t'))) for row in rows.splitlines() if row.split('\t')[0] == session]


def exact_pane(session, window):
    found = [row for row in panes(session) if row['window'] == window]
    require(len(found) == 1, 'target is not one unique pane')
    return found[0]


def relay_start(request, seat):
    kind = seat['transport']
    environment = dict(os.environ)
    if kind in ('fable', 'deepseek'):
        environment.update(CC_MSG_SESSION=request['session'], CC_MSG_WINDOW=seat['window'])
        command = [str(Path.home() / '.local/bin/cc-msg'), START]
    else:
        prefix = 'CODEX_SEND' if kind == 'astra' else 'AGY_SEND'
        environment[prefix + '_SESSION'] = request['session']
        command = [str(Path.home() / '.local/bin' / ('codex-send-to' if kind == 'astra' else 'agy-send-to')), seat['window'], START]
    output = run(command, env=environment, timeout=15)
    match = re.search(r'; record (/[^\n]+)', output)
    require(match, 'relay did not return a durable record')
    path = Path(match.group(1))
    deadline = time.monotonic() + request['deadline_seconds']
    while time.monotonic() < deadline:
        value = decode(path_bytes(path))
        if value.get('state') in ('delivered', 'error'):
            break
        time.sleep(.1)
    require(value.get('state') == 'delivered', 'relay outcome unknown/refused; do not resend')
    require(value.get('payload') == value['label'] + ': ' + START, 'Start was archived/changed; no canonical or pointer fallback')
    require(value['target']['session_name'] == request['session'] and value['target']['window_name'] == seat['window'] and value['message'] == START and value['target']['pane_id'] == seat['pane']['pane_id'] and value['target']['pane_pid'] == seat['pane']['pid'], 'relay target/input conflict')
    current = exact_pane(request['session'], seat['window'])
    require(all(current[key] == seat['pane'][key] for key in ('pane_id', 'window_id', 'pid')), 'relay target changed during delivery')
    return dict(reference=ref(path), native_start=value['label'] + ': ' + START)


def own(args):
    preparation_ref = dict(path=args.prepared, sha256=args.sha256)
    record = read(preparation_ref)
    request = read(record['request_ref'])
    matches = [seat for seat in record['seats'] if seat['seat_id'] == args.seat_id]
    require(len(matches) == 1 and record['adapter'] == adapter(), 'spawn ownership source/seat conflict')
    seat = matches[0]
    batch = Path(record['batch'])
    intent_path = batch / (seat['seat_id'] + '-spawn-intent.json')
    if not intent_path.exists():
        fresh(intent_path, dict(prepared_ref=preparation_ref, seat_id=args.seat_id, pane_id=args.pane, observed_at=now()))
    pane = exact_pane(request['session'], seat['window'])
    require(pane['pane_id'] == args.pane and Path(pane['cwd']).resolve() == Path(seat['directory']), 'spawn ownership exact pane/cwd conflict')
    spawn_path = batch / (seat['seat_id'] + '-spawn.json')
    minimal = dict(**seat, pane=pane, observed_at=now())
    if spawn_path.exists():
        original = decode(path_bytes(spawn_path))
        require(all(original['pane'][key] == pane[key] for key in ('window_id', 'pane_id', 'pid')), 'spawn recovery target changed')
    else:
        fresh(spawn_path, minimal)
    deadline = time.monotonic() + 3
    while True:
        try:
            identity = process_identity(pane['pid'])
            break
        except (OSError, ValueError):
            require(time.monotonic() < deadline, 'spawn recorded but kernel custody unavailable; retain seat and do not resend')
            time.sleep(.1)
    temp_path = Path(seat['directory']) / 'panel-temp.json'
    owned = dict(**seat, pane=pane, pane_process=identity, process_observer_ref=ref(TOOLS / 'tmux-lab'), temp=decode(path_bytes(temp_path)) if temp_path.exists() else None, launched_at=now())
    path = batch / (seat['seat_id'] + '-owned-prestart.json')
    if not path.exists():
        fresh(path, owned)
    rows = []
    for prepared in record['seats']:
        candidate = batch / (prepared['seat_id'] + '-owned-prestart.json')
        if not candidate.exists():
            break
        rows.append(decode(path_bytes(candidate)))
    output = batch / ('owned-prestart-' + str(len(rows)) + '.json')
    if output.exists():
        return ref(output)
    return fresh(output, dict(phase='owned-launch', context=record['context'], request_ref=record['request_ref'], prepared_ref=preparation_ref, adapter=record['adapter'], batch=record['batch'], seats=rows, created_at=now()))


def recover_prestart(record, preparation_ref, error):
    batch = Path(record['batch'])
    for seat in record['seats']:
        intent = batch / (seat['seat_id'] + '-spawn-intent.json')
        if intent.exists() and not (batch / (seat['seat_id'] + '-owned-prestart.json')).exists():
            value = decode(path_bytes(intent))
            require(value['prepared_ref'] == preparation_ref, 'spawn intent preparation conflict')
            own(argparse.Namespace(prepared=preparation_ref['path'], sha256=preparation_ref['sha256'], seat_id=seat['seat_id'], pane=value['pane_id']))
    owned = sorted(batch.glob('owned-prestart-*.json'), key=lambda path: int(path.stem.rsplit('-', 1)[1]))
    if not owned:
        return
    launch_ref = ref(owned[-1])
    launch = read(launch_ref)
    index = fresh(batch / 'prestart-failure-index.json', dict(context=record['context'], launch_ref=launch_ref, seats=[dict(seat_id=seat['seat_id'], attempt_id=seat['attempt_id'], native_ref=None, non_observation=True, cause='pre-Start launch failure; native transcript not observed: ' + str(error)) for seat in launch['seats']]))
    retained = retain(argparse.Namespace(launched=launch_ref['path'], sha256=launch_ref['sha256'], native_index=index['path'], native_sha256=index['sha256'], output=str(batch / 'prestart-failure-retained.json')))
    cleanup(argparse.Namespace(launched=launch_ref['path'], sha256=launch_ref['sha256'], collected=retained['path'], collected_sha256=retained['sha256'], output=str(batch / 'prestart-failure-cleanup.json')))


def launch(args):
    record = read(dict(path=args.prepared, sha256=args.sha256))
    try:
        return launch_prestart(args)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        if 'batch' in record and not (Path(record['batch']) / 'starts-entered.json').exists():
            recover_prestart(record, dict(path=args.prepared, sha256=args.sha256), error)
        raise


def launch_prestart(args):
    preparation_ref = dict(path=args.prepared, sha256=args.sha256)
    record = read(preparation_ref)
    request = prepared_check(record)
    batch = Path(record['batch'])
    require(not (batch / 'launch-started.json').exists(), 'launch already attempted; no blind resend')
    existing = panes(request['session'])
    require(not any(row['window'] in {seat['window'] for seat in record['seats']} for row in existing), 'target windows already exist')
    claim_launch(request, record['request_ref'])
    fresh(batch / 'launch-started.json', dict(prepared_ref=preparation_ref, created_at=now()))
    launches = []
    for seat in record['seats']:
        kind = seat['transport']
        if kind == 'astra':
            arguments = ['-m', seat['model'], '-c', 'model_reasoning_effort=' + json.dumps(seat['effort'])]
        elif kind == 'gemini':
            arguments = ['--model', seat['model'], '--effort', seat['effort']]
        else:
            arguments = ['--model', seat['model'], '--effort', seat['effort']]
        code = 'source ' + shlex.quote(str(REPO / 'fish/internal/tmux/tai.fish')) + '; tai --session ' + shlex.quote(request['session']) + ' seat ' + shlex.quote(kind) + ' ' + shlex.join(arguments)
        before, command = code.split('; tai ', 1)
        code = before + '; functions -c __tai_spawn __panel_original_spawn; function __tai_spawn; set argv[1] ' + shlex.quote(seat['window']) + '; __panel_original_spawn $argv; end; tai ' + command
        tmux_command = [os.environ.get('TMUX_BIN', 'tmux')]
        if os.environ.get('TMUX_LAB_SOCKET'):
            tmux_command += ['-L', os.environ['TMUX_LAB_SOCKET'], '-f', '/dev/null']
        native_tmux = 'command ' + shlex.join(tmux_command)
        ownership = shlex.join([sys.executable, str(SOURCE), 'own', '--prepared', args.prepared, '--sha256', args.sha256, '--seat-id', seat['seat_id']])
        code = 'function tmux; if test "$argv[1]" = new-window; set -l created (' + native_tmux + ' new-window -d $argv[2..-1]); or return $status; ' + ownership + ' --pane "$created" >/dev/null; or return $status; printf "%s\\n" "$created"; else; ' + native_tmux + ' $argv; end; end; ' + code
        output = run(['fish', '-l', '-c', code], cwd=seat['directory'])
        deadline = time.monotonic() + request['deadline_seconds']
        while True:
            pane = exact_pane(request['session'], seat['window'])
            if pane['command'] not in ('fish', 'bash', 'zsh', 'sh'):
                break
            require(time.monotonic() < deadline, 'CLI readiness deadline exhausted')
            time.sleep(.2)
        require(Path(pane['cwd']).resolve() == Path(seat['directory']), 'launched cwd mismatch')
        run(['tmux', 'resize-window', '-t', pane['window_id'], '-x', '215', '-y', '50'])
        capture = run(['tmux', 'capture-pane', '-p', '-e', '-t', pane['pane_id']])
        screen = fresh(batch / (seat['seat_id'] + '-prestart.ansi'), capture.encode())
        runtime_files = {str(p): ref(p) for p in Path(seat['directory']).iterdir() if p.is_file() and p.name not in seat['inputs']}
        temp_path = Path(seat['directory']) / 'panel-temp.json'
        temp = decode(path_bytes(temp_path)) if temp_path.exists() else None
        launches.append(dict(**seat, pane=pane, pane_process=process_identity(pane['pid']), process_observer_ref=ref(TOOLS / 'tmux-lab'), launch_stdout=output, launched_at=now(), prestart_ref=screen, runtime_files=runtime_files, temp=temp))
        fresh(batch / (seat['seat_id'] + '-launched.json'), launches[-1])
        fresh(batch / ('owned-' + str(len(launches)) + '.json'), dict(phase='owned-launch', context=record['context'], request_ref=record['request_ref'], prepared_ref=preparation_ref, adapter=adapter(), batch=str(batch), seats=launches, created_at=now()))
    prepared_check(record, runtime=True)
    fresh(batch / 'starts-entered.json', dict(prepared_ref=preparation_ref, created_at=now()))
    for seat in launches:
        current = exact_pane(request['session'], seat['window'])
        require(all(current[key] == seat['pane'][key] for key in ('window_id', 'pane_id', 'pid', 'cwd')), 'pre-start target identity drift')
        seat['delivery'] = relay_start(request, seat)
        fresh(batch / (seat['seat_id'] + '-start.json'), seat['delivery'])
    return fresh(batch / 'launched.json', dict(phase='launched', context=record['context'], request_ref=record['request_ref'], prepared_ref=preparation_ref, adapter=adapter(), batch=str(batch), seats=launches, created_at=now()))


def text_blocks(content, types):
    if isinstance(content, str):
        return content
    require(isinstance(content, list) and all(isinstance(c, dict) and c.get('type') in types and isinstance(c.get('text'), str) for c in content), 'unsupported text envelope')
    return '\n'.join(c['text'] for c in content)


def complete_read(output, expected):
    normalized = re.sub(r'(?m)^[ \t]*\d+(?:→|\t)', '', output)
    return expected.rstrip('\n') in output or expected.rstrip('\n') in normalized


def loaded_context(value):
    if isinstance(value, dict):
        if value.get('agents_md'):
            return True
        attachment = value.get('attachment')
        if isinstance(attachment, dict):
            kind = str(attachment.get('type', attachment.get('kind', ''))).lower()
            if kind != 'prompt_snapshot' and (kind == 'skill_listing' or 'memory' in kind or 'automem' in kind):
                return True
        return any(loaded_context(child) for child in value.values())
    return isinstance(value, list) and any(loaded_context(child) for child in value)


def wrapped_command(value):
    if not isinstance(value, str):
        return None
    match = re.fullmatch(r'\s*const ([A-Za-z_]\w*) = await tools\.exec_command\((\{[^\n]+\})\);\s*text\(\1\);\s*', value)
    if not match:
        match = re.fullmatch(r'\s*text\(await tools\.exec_command\((\{[^\n]+\})\)\);?\s*', value)
        raw = match.group(1) if match else None
    else:
        raw = match.group(2)
    if raw is None:
        return None
    try:
        argument = decode(re.sub(r'\b(cmd|max_output_tokens|yield_time_ms|workdir)\s*:', r'"\1":', raw))
        require(isinstance(argument, dict) and set(argument) <= {'cmd', 'max_output_tokens', 'yield_time_ms', 'workdir'} and isinstance(argument.get('cmd'), str), 'unsupported wrapper arguments')
        return argument
    except ValueError:
        return None


def codex_result(value):
    blocks = value if isinstance(value, list) else [dict(type='input_text', text=value)]
    require(all(isinstance(block, dict) and block.get('type') == 'input_text' and isinstance(block.get('text'), str) for block in blocks), 'unsupported Codex output envelope')
    candidates = []
    for block in blocks:
        try:
            parsed = decode(block['text'])
        except ValueError:
            continue
        if isinstance(parsed, dict) and type(parsed.get('exit_code')) is int and isinstance(parsed.get('output'), str):
            candidates.append(parsed)
    if len(candidates) > 1:
        return '\n'.join(block['text'] for block in blocks), True
    if len(candidates) == 1:
        return candidates[0]['output'], candidates[0]['exit_code'] != 0
    output = '\n'.join(block['text'] for block in blocks)
    exits = re.findall(r'(?m)^Process exited with code (-?[0-9]+)\s*$', output)
    return output, len(exits) != 1 or exits[0] != '0'


def inspect_native(data, fmt, seat, request):
    require(data.endswith(b'\n'), 'incomplete LF native record')
    rows = [decode(line) for line in data.split(b'\n')[:-1]]
    require(rows and len(rows) <= 100000, 'empty/oversized native session')
    sessions, models, efforts, starts, cwds, timestamps = set(), set(), set(), [], set(), []
    calls, results, finals, gaps = {}, {}, [], []
    for number, row in enumerate(rows, 1):
        require(not loaded_context(row), 'unapproved native instructions/memory attachment')
        payload = row.get('payload', {})
        message = row.get('message', {})
        timestamp = row.get('timestamp') or payload.get('timestamp')
        if timestamp:
            instant = dt.datetime.fromisoformat(timestamp.replace('Z', '+00:00'))
            require(instant.tzinfo is not None, 'native timestamp missing timezone')
            timestamps.append(instant)
        session = row.get('sessionId')
        if row.get('type') == 'session_meta':
            session = payload.get('id', payload.get('session_id'))
        if session:
            sessions.add(session)
        cwd = row.get('cwd') or payload.get('cwd')
        if cwd:
            cwds.add(str(Path(cwd)))
        if row.get('type') == 'turn_context':
            if payload.get('model'):
                models.add(payload['model'])
            if payload.get('effort'):
                efforts.add(payload['effort'])
        if message.get('model'):
            models.add(message['model'])
        if row.get('type') == 'user' and message.get('role') == 'user':
            content = message.get('content')
            if isinstance(content, str):
                starts.append((number, content.strip()))
            elif isinstance(content, list):
                require(content and all(isinstance(c, dict) and c.get('type') in ('text', 'tool_result') for c in content), 'unknown/non-text external native user input')
                user_parts = [c for c in content if c.get('type') == 'text']
                if user_parts:
                    starts.append((number, text_blocks(user_parts, ('text',)).strip()))
                for part in content:
                    if part.get('type') == 'tool_result':
                        identifier = part.get('tool_use_id')
                        require(identifier not in results, 'duplicate native result ID')
                        try:
                            output = text_blocks(part.get('content', ''), ('text',))
                            error = part.get('is_error', False)
                        except ValueError:
                            output, error = '', None
                            gaps.append('unsupported native result envelope ' + str(identifier))
                        results[identifier] = dict(line=number, output=output, error=error)
            else:
                require(False, 'malformed external native user input')
        if row.get('type') == 'response_item' and payload.get('role') == 'user':
            value = text_blocks(payload.get('content', []), ('input_text',))
            if starts or not re.fullmatch('<environment_context>.*?</environment_context>', value.strip(), re.S):
                starts.append((number, value.strip()))
        for part in message.get('content', []) if isinstance(message.get('content'), list) else []:
            if part.get('type') == 'tool_use':
                identifier = part.get('id')
                require(identifier and identifier not in calls, 'duplicate/missing native call ID')
                calls[identifier] = dict(line=number, name=part.get('name'), args=part.get('input'), cwd=cwd or seat['directory'])
        if row.get('type') == 'response_item' and payload.get('type') in ('function_call', 'custom_tool_call'):
            identifier = payload.get('call_id')
            require(identifier and identifier not in calls, 'duplicate/missing native call ID')
            argument = payload.get('arguments', payload.get('input'))
            try:
                argument = decode(argument) if isinstance(argument, str) else argument
            except ValueError:
                pass
            original_name = payload.get('name')
            wrapped = wrapped_command(argument) if original_name in ('exec', 'functions.exec') else None
            calls[identifier] = dict(line=number, name='exec_command' if wrapped is not None else original_name, args=wrapped if wrapped is not None else argument, original_name=original_name, cwd=cwd or seat['directory'])
        if row.get('type') == 'response_item' and payload.get('type') in ('function_call_output', 'custom_tool_call_output'):
            identifier = payload.get('call_id')
            require(identifier not in results, 'duplicate native result ID')
            try:
                output, failed = codex_result(payload.get('output', ''))
            except ValueError:
                output, failed = '', None
                gaps.append('unsupported native result envelope ' + str(identifier))
            results[identifier] = dict(line=number, output=output, error=payload.get('is_error', False) or failed)
        if fmt == 'claude-jsonl' and row.get('type') == 'assistant' and message.get('role') == 'assistant' and message.get('stop_reason') == 'end_turn':
            content = message.get('content')
            if isinstance(content, list) and content and all(c.get('type') == 'text' for c in content):
                finals.append((number, text_blocks(content, ('text',))))
        if fmt == 'codex-jsonl' and row.get('type') == 'response_item' and payload.get('type') == 'message' and payload.get('role') == 'assistant' and (payload.get('channel') == 'final' or payload.get('phase') == 'final_answer'):
            finals.append((number, text_blocks(payload.get('content'), ('output_text',))))
        if fmt == 'agy-jsonl':
            if row.get('source') == 'USER_EXPLICIT' and row.get('type') == 'USER_INPUT':
                value = row.get('content', '')
                match = re.fullmatch(r'<USER_REQUEST>\n(.*?)\n</USER_REQUEST>(?:\n<ADDITIONAL_METADATA>\n.*?\n</ADDITIONAL_METADATA>)?(?:\n<USER_SETTINGS_CHANGE>\n.*?\n</USER_SETTINGS_CHANGE>)?\s*', value, re.S)
                starts.append((number, (match.group(1) if match else value).strip()))
            if row.get('source') == 'MODEL' and row.get('type') == 'PLANNER_RESPONSE' and row.get('status') == 'DONE' and not row.get('tool_calls'):
                require(isinstance(row.get('content'), str), 'unsupported Agy final')
                finals.append((number, row['content']))
            gaps.append('Agy effective identity and action linkage are unqualified')
    require(len(sessions) == 1, 'native session identity missing or mixed')
    require(cwds and all(Path(cwd).resolve().is_relative_to(Path(seat['directory'])) for cwd in cwds), 'native cwd missing or outside seat')
    require([value for number, value in starts] == [seat['delivery']['native_start']], 'external native input differs from one exact Start')
    start_line = starts[0][0]
    require(all(call['line'] > start_line for call in calls.values()), 'native actions precede Start')
    if seat.get('prepared_at'):
        require(timestamps and min(timestamps) >= dt.datetime.fromisoformat(seat['prepared_at']), 'native session predates fresh preparation or lacks timestamps')
    require(len(finals) == 1 and finals[0][1].strip(), 'one unambiguous completed native final required')
    final_line, final_text = finals[-1]
    require(final_line > start_line, 'native final precedes Start')
    require(not any(call['line'] > final_line for call in calls.values()), 'selected final precedes later tool calls')
    require(all(identifier in calls and calls[identifier]['line'] < result['line'] for identifier, result in results.items()), 'orphan/out-of-order tool result')
    require(not models or models == {seat['model']}, 'requested/effective native model mismatch')
    if not models:
        gaps.append('effective model unavailable; no identity/family claim from requested label')
    require(not efforts or efforts == {seat['effort']}, 'native effort mismatch')
    verified_reads, actions = {}, []
    for identifier, call in calls.items():
        argument = call['args']
        result = results.get(identifier)
        actions.append(dict(id=identifier, **call, result=result))
        target = argument.get('file_path') if isinstance(argument, dict) and call['name'] == 'Read' else None
        command = argument.get('command', argument.get('cmd')) if isinstance(argument, dict) else None
        if call['name'] in ('Bash', 'exec_command', 'functions.exec_command') and isinstance(command, str) and re.fullmatch(r'(?:/bin/)?cat (?:PROMPT\.md|intake\.md)', command):
            target = command.split(' ', 1)[1]
        if target and result and result['error'] is False and result['line'] < final_line:
            path = Path(target)
            base = argument.get('workdir', argument.get('cwd', call['cwd'])) if isinstance(argument, dict) else call['cwd']
            path = path if path.is_absolute() else Path(base) / path
            path = path.resolve()
            for name, reference in seat['inputs'].items():
                expected = read(reference, json_proof=False).decode()
                coverage = 'complete literal output'
                if name == 'intake.md' and call['name'] == 'Read' and 'limit' in argument:
                    offset, limit = argument.get('offset', 1), argument['limit']
                    require(type(offset) is int and offset > 0 and type(limit) is int and limit > 0, 'invalid native read range')
                    expected = '\n'.join(expected.split('\n')[offset - 1:offset - 1 + limit])
                    coverage = 'explicit partial native read; no whole-file claim'
                if path == Path(reference['path']) and expected.strip() and complete_read(result['output'], expected):
                    verified_reads[name] = dict(call_id=identifier, call_line=call['line'], result_line=result['line'], coverage=coverage)
                    if coverage.startswith('explicit partial'):
                        gaps.append('only a bound partial intake read is proven; account limitations require review')
        qualified_name = call['name'] == 'Read' or call['name'] in ('Bash', 'exec_command', 'functions.exec_command')
        if result is None or not isinstance(argument, dict) or not qualified_name:
            gaps.append('unsupported/pending action ' + identifier)
    require(set(verified_reads) == {'PROMPT.md', 'intake.md'}, 'complete matched native prompt/intake reads missing')
    verdicts = re.findall(r'(?m)^Verdict: (PASS_WITH_MONITORING|PASS|FAIL)\s*$', final_text)
    if len(verdicts) != 1:
        gaps.append('native verdict grammar requires independently bound interpretation')
    return dict(session_id=next(iter(sessions)), model=next(iter(models)) if models else None, effort=next(iter(efforts)) if efforts else None, final_line=final_line, final_text=final_text, raw_verdict=verdicts[0] if len(verdicts) == 1 else None, reads=verified_reads, actions=actions, limitations=sorted(set(gaps)), absence_qualified=False)


def collect(args):
    launch_ref = dict(path=args.launched, sha256=args.sha256)
    launch = read(launch_ref)
    request = request_check(launch['request_ref'])
    preparation = read(launch['prepared_ref'])
    require(launch.get('phase') == 'launched' and launch['adapter'] == adapter() and launch['context'] == context_of(request) and preparation['request_ref'] == launch['request_ref'] and launch['batch'] == preparation['batch'], 'collection launch/preparation/source conflict')
    require(len(launch['seats']) == len(preparation['seats']) == len(request['roster']), 'collection roster length mismatch')
    for seat, prepared, wanted in zip(launch['seats'], preparation['seats'], request['roster']):
        require(all(seat[key] == prepared[key] for key in prepared) and all(seat[key] == wanted[key] for key in wanted), 'collection roster/profile/input drift')
        for reference in seat['inputs'].values():
            read(reference, json_proof=False)
    native_index_ref = dict(path=args.native_index, sha256=args.native_sha256)
    native = read(native_index_ref)
    require(set(native) == {'context', 'launch_ref', 'seats'} and native['context'] == launch['context'] and native['launch_ref'] == launch_ref, 'independent native index context conflict')
    require(len(native['seats']) == len(launch['seats']), 'native roster mismatch')
    require(all(seat['transport'] != 'gemini' for seat in launch['seats']), 'Agy automatic admission unqualified; use retain, not collect')
    batch = Path(launch['batch'])
    outputs = []
    for seat, evidence in zip(launch['seats'], native['seats']):
        require(set(evidence) == {'seat_id', 'attempt_id', 'native_ref', 'format', 'descendants', 'boundary_review_ref', 'account_ref'}, 'closed native row required')
        require(evidence['seat_id'] == seat['seat_id'] and evidence['attempt_id'] == seat['attempt_id'] and evidence['format'] == KINDS[seat['transport']], 'native row identity/order mismatch')
        data = read(evidence['native_ref'], json_proof=False)
        snapshot = fresh(batch / (seat['seat_id'] + '-native.jsonl'), data)
        diagnostics = inspect_native(data, evidence['format'], seat, request)
        boundary = read(evidence['boundary_review_ref'])
        require(boundary.get('context') == launch['context'] and boundary.get('seat_id') == seat['seat_id'] and boundary.get('attempt_id') == seat['attempt_id'] and boundary.get('session_id') == diagnostics['session_id'] and boundary.get('native_ref') == evidence['native_ref'] and boundary.get('descendants') == evidence['descendants'], 'independent native boundary binding mismatch')
        require(boundary.get('launch_ref') == launch_ref and boundary.get('pane') == seat['pane'] and boundary.get('session_binding_verified') is True, 'native session/launch binding missing')
        require(boundary.get('independent') is True and boundary.get('isolation_pass') is True and boundary.get('external_input_pass') is True, 'native boundary admission failed')
        require(boundary.get('final_sha256') == hashlib.sha256(diagnostics['final_text'].encode()).hexdigest() and boundary.get('raw_verdict') in ('PASS', 'PASS_WITH_MONITORING', 'FAIL'), 'independent selected-final/verdict binding required')
        if diagnostics['raw_verdict'] is not None:
            require(diagnostics['raw_verdict'] == boundary['raw_verdict'], 'literal native verdict conflicts with independent interpretation')
        diagnostics['raw_verdict'] = boundary['raw_verdict']
        for descendant in evidence['descendants']:
            read(descendant, json_proof=False)
        final = fresh(batch / (seat['seat_id'] + '-final.md'), diagnostics.pop('final_text').encode())
        bound = dict(context=launch['context'], seat_id=seat['seat_id'], attempt_id=seat['attempt_id'], session_id=diagnostics['session_id'])
        reads = fresh(batch / (seat['seat_id'] + '-reads.json'), dict(**bound, **{k: request['packet'][k] for k in ('canonical_input', 'delivered_input', 'manifest', 'prompt')}, native_session_ref=snapshot, final_ref=final, actual_reads_verified=True, native_reads=diagnostics['reads']))
        admission = fresh(batch / (seat['seat_id'] + '-admission.json'), dict(**bound, **{k: request['packet'][k] for k in ('canonical_input', 'delivered_input', 'manifest', 'prompt')}, status='current', admitted=True, raw_verdict=diagnostics['raw_verdict'], native_session_ref=snapshot, final_ref=final, launched_at=seat['launched_at'], boundary_review_ref=evidence['boundary_review_ref']))
        diagnostic = fresh(batch / (seat['seat_id'] + '-diagnostics.json'), {**bound, **diagnostics, 'native_session_ref': snapshot, 'final_ref': final})
        attempt = dict(attempt_id=seat['attempt_id'], session_id=diagnostics['session_id'], status='current', launcher_ref=request['launcher_ref'], native_session_ref=snapshot, reads_ref=reads, final_ref=final, admission_ref=admission, account_ref=evidence['account_ref'], supersession_ref=None, exception_ref=None, transport_ref=None)
        canonical_seat = dict(seat_id=seat['seat_id'], attempt_id=seat['attempt_id'], responding=True, admitted=True, raw_verdict=diagnostics['raw_verdict'], admission_cause='bound candidate; requires independent dispatch and consumer verification', pass_floor_eligible=diagnostics['raw_verdict'] in ('PASS', 'PASS_WITH_MONITORING'), floor_cause='record-only candidate; qualified account checks remain prospective', attempts=[attempt])
        consumers, schema = protocol(request['protocol_root'])
        canonical_schema = schema._load_ledger_schema(request['protocol_root'])
        require(not schema._js_validate(canonical_seat, canonical_schema['$defs']['agentic_seat'], canonical_schema), 'canonical seat receipt shape failed')
        outputs.append(dict(**bound, native_session_ref=snapshot, final_ref=final, reads_ref=reads, admission_ref=admission, diagnostic_ref=diagnostic, account_ref=evidence['account_ref'], raw_verdict=diagnostics['raw_verdict'], canonical_record_only_seat=canonical_seat))
    read(native_index_ref)
    request_check(launch['request_ref'])
    return fresh(batch / 'collected.json', dict(phase='collected', context=launch['context'], launch_ref=launch_ref, native_index_ref=native_index_ref, adapter=adapter(), seats=outputs, admission_authority='candidate-only: independently bind in canonical dispatch before consuming'))


def wait(args):
    launch_ref = dict(path=args.launched, sha256=args.sha256)
    launch = read(launch_ref)
    request = request_check(launch['request_ref'])
    locations_ref = dict(path=args.locations, sha256=args.locations_sha256)
    locations = read(locations_ref)
    require(set(locations) == {'context', 'launch_ref', 'seats'} and locations['context'] == launch['context'] and locations['launch_ref'] == launch_ref, 'native locations authority conflict')
    require(len(locations['seats']) == len(launch['seats']), 'native locations roster mismatch')
    pending = []
    for seat, location in zip(launch['seats'], locations['seats']):
        require(set(location) == {'seat_id', 'attempt_id', 'native_path'} and location['seat_id'] == seat['seat_id'] and location['attempt_id'] == seat['attempt_id'], 'native location identity mismatch')
        require(Path(location['native_path']).is_absolute(), 'absolute current native location required')
        pending.append((seat, location))
    deadline = time.monotonic() + request['deadline_seconds']
    observations = {seat['seat_id']: dict(seat_id=seat['seat_id'], attempt_id=seat['attempt_id'], candidate=False, cause='deadline exhausted before native observation') for seat in launch['seats']}
    last = {}
    while pending and time.monotonic() < deadline:
        remaining = []
        for seat, location in pending:
            identifier = seat['seat_id']
            try:
                data = path_bytes(location['native_path'])
                last[identifier] = data
                diagnostics = inspect_native(data, KINDS[seat['transport']], seat, request)
                observations[identifier] = dict(seat_id=identifier, attempt_id=seat['attempt_id'], candidate=True, cause='native binding/read/final checks passed', model=diagnostics['model'], effort=diagnostics['effort'], session_id=diagnostics['session_id'])
            except (OSError, ValueError) as error:
                observations[identifier] = dict(seat_id=identifier, attempt_id=seat['attempt_id'], candidate=False, cause=str(error))
                remaining.append((seat, location))
        pending = remaining
        if pending:
            time.sleep(.25)
    for seat, location in zip(launch['seats'], locations['seats']):
        identifier = seat['seat_id']
        observation = observations[identifier]
        observation['native_session_ref'] = fresh(Path(launch['batch']) / (identifier + '-observed-native.jsonl'), last[identifier]) if identifier in last else None
        observation['exhausted'] = not observation['candidate']
        observation['accounting'] = 'candidate only; no vote until independent admission' if observation['candidate'] else 'non-response; retain evidence and existing C71 authority requirements'
    read(locations_ref)
    request_check(launch['request_ref'])
    return fresh(Path(args.output), dict(phase='observed', launch_ref=launch_ref, locations_ref=locations_ref, context=launch['context'], seats=[observations[s['seat_id']] for s in launch['seats']], created_at=now(), automatic_redispatches=0))


def verify(args):
    consumers, schema = protocol(args.protocol_root)
    authority = dict(path=args.dispatch, sha256=args.sha256)
    dispatch = read(authority)
    require(dispatch.get('adapter') == adapter(), 'dispatch adapter is not this version/source')
    context = consumers.resolve_agentic_context(args.project_root, topic=dispatch['topic'], cycle_type=dispatch['cycle_type'], cycle=dispatch['cycle'], round_no=dispatch['round'], dispatch_evidence_ref=authority, sequence_context=dispatch.get('sequence_context'))
    ledger = read(dict(path=args.ledger, sha256=args.ledger_sha256))
    errors = consumers.validate_agentic_evidence(ledger, args.project_root, expected_context=context)
    require(not errors, '\n'.join(errors))
    sources = sorted(consumers.agentic_pass_sources(ledger, args.project_root, expected_context=context))
    return fresh(Path(args.output), dict(status='PASS', adapter=adapter(), dispatch_ref=authority, ledger_ref=dict(path=args.ledger, sha256=args.ledger_sha256), pass_sources=sources, qualification_mode=dispatch['activation']['mode'], created_at=now()))


def retain(args):
    launch_ref = dict(path=args.launched, sha256=args.sha256)
    launch = read(launch_ref)
    index_ref = dict(path=args.native_index, sha256=args.native_sha256)
    index = read(index_ref)
    require(index.get('launch_ref') == launch_ref and index.get('context') == launch['context'], 'retained native index authority conflict')
    require(len(index.get('seats', [])) == len(launch['seats']), 'retained roster length mismatch')
    outputs = []
    for seat, supplied in zip(launch['seats'], index['seats']):
        require(supplied['seat_id'] == seat['seat_id'] and supplied['attempt_id'] == seat['attempt_id'], 'retained seat order/identity mismatch')
        native = supplied.get('native_ref')
        require(native is not None or supplied.get('non_observation') is True, 'missing native requires explicit non-observation')
        snapshot = fresh(Path(launch['batch']) / (seat['seat_id'] + '-unadmitted-native.jsonl'), read(native, json_proof=False)) if native is not None else None
        require(isinstance(supplied.get('cause'), str) and supplied['cause'].strip(), 'non-response cause required')
        outputs.append(dict(seat_id=seat['seat_id'], attempt_id=seat['attempt_id'], native_session_ref=snapshot, final_ref=None, admitted=False, responding=False, raw_verdict=None, pass_floor_eligible=False, cause=supplied['cause'], findings='retained native bytes require lead reproduction/classification; no vote credit'))
    read(index_ref)
    return fresh(Path(args.output), dict(phase='unadmitted-retention', launch_ref=launch_ref, native_index_ref=index_ref, context=launch['context'], adapter=launch['adapter'], batch=launch['batch'], request_ref=launch['request_ref'], prepared_ref=launch['prepared_ref'], seats=outputs, created_at=now()))


def cleanup(args):
    launch_ref = dict(path=args.launched, sha256=args.sha256)
    launch = read(launch_ref)
    request = read(launch['request_ref'])
    require(request.get('authorized') is True and launch['context'] == context_of(request), 'cleanup launch authority conflict')
    collection_ref = dict(path=args.collected, sha256=args.collected_sha256)
    collected = read(collection_ref)
    require(collected.get('phase') in ('collected', 'unadmitted-retention'), 'cleanup requires a typed preserved collection receipt')
    preparation = read(launch['prepared_ref'])
    launcher = read(request['launcher_ref'])
    require(preparation.get('phase') == 'prepared' and launch['prepared_ref']['path'] == str(Path(launch['batch']) / 'prepared.json') and launcher.get('adapter') == launch['adapter'] and launcher.get('context') == launch['context'], 'cleanup candidate source/preparation provenance conflict')
    require(launch.get('phase') in ('launched', 'owned-launch') and launch.get('adapter') == preparation.get('adapter') and launch.get('context') == preparation.get('context') and launch.get('request_ref') == preparation.get('request_ref') and launch.get('batch') == preparation.get('batch'), 'cleanup launch/prepared chain conflict')
    require(0 < len(launch['seats']) <= len(preparation['seats']) and all(all(seat.get(key) == prepared[key] for key in prepared) for seat, prepared in zip(launch['seats'], preparation['seats'])), 'cleanup owned seats differ from prepared prefix')
    require(collected.get('context') == launch['context'] and collected.get('adapter') == launch['adapter'], 'cleanup collection context/source conflict')
    if collected['phase'] == 'unadmitted-retention':
        require(set(collected) == {'phase', 'launch_ref', 'native_index_ref', 'context', 'adapter', 'batch', 'request_ref', 'prepared_ref', 'seats', 'created_at'} and all(collected[key] == launch[key] for key in ('batch', 'request_ref', 'prepared_ref')), 'cleanup retention chain conflict')
    else:
        require(set(collected) == {'phase', 'context', 'launch_ref', 'native_index_ref', 'adapter', 'seats', 'admission_authority'} and collection_ref['path'] == str(Path(launch['batch']) / 'collected.json') and launch['phase'] == 'launched', 'cleanup collection provenance conflict')
    index = read(collected['native_index_ref'])
    require(index.get('context') == launch['context'] and index.get('launch_ref') == launch_ref and len(index.get('seats', [])) == len(launch['seats']), 'cleanup preservation index conflict')
    require(collected.get('launch_ref') == launch_ref, 'preserved collection binding required before cleanup')
    require(len(collected.get('seats', [])) == len(launch['seats']), 'cleanup retained roster incomplete')
    require([seat['seat_id'] for seat in collected['seats']] == [seat['seat_id'] for seat in launch['seats']], 'cleanup retained roster order changed')
    for seat, source, owned in zip(collected['seats'], index['seats'], launch['seats']):
        require(seat['attempt_id'] == source['attempt_id'] == owned['attempt_id'] and seat['seat_id'] == source['seat_id'] == owned['seat_id'], 'cleanup preservation attempt conflict')
        if collected['phase'] == 'collected':
            require(seat.get('native_session_ref') is not None and seat.get('final_ref') is not None, 'cleanup admitted preservation missing')
            require(seat['native_session_ref']['path'] == str(Path(launch['batch']) / (seat['seat_id'] + '-native.jsonl')) and seat['final_ref']['path'] == str(Path(launch['batch']) / (seat['seat_id'] + '-final.md')), 'cleanup preservation outside owned batch')
            require(read(seat['native_session_ref'], json_proof=False) == read(source['native_ref'], json_proof=False), 'cleanup native snapshot provenance conflict')
            admission = read(seat['admission_ref'])
            require(admission.get('native_session_ref') == seat['native_session_ref'] and admission.get('final_ref') == seat['final_ref'] and admission.get('session_id') == seat['session_id'], 'cleanup final/admission conflict')
        else:
            require(set(seat) == {'seat_id', 'attempt_id', 'native_session_ref', 'final_ref', 'admitted', 'responding', 'raw_verdict', 'pass_floor_eligible', 'cause', 'findings'} and seat['admitted'] is False and seat['responding'] is False and seat['pass_floor_eligible'] is False and seat['raw_verdict'] is None and seat['final_ref'] is None and seat['cause'] == source.get('cause') and isinstance(seat['cause'], str) and seat['cause'].strip(), 'cleanup non-observation/retention cause missing')
            if source.get('native_ref') is not None:
                require(seat['native_session_ref'] is not None and seat['native_session_ref']['path'] == str(Path(launch['batch']) / (seat['seat_id'] + '-unadmitted-native.jsonl')) and read(seat['native_session_ref'], json_proof=False) == read(source['native_ref'], json_proof=False), 'cleanup retained native provenance conflict')
            else:
                require(seat['native_session_ref'] is None and source.get('non_observation') is True, 'cleanup missing native requires explicit non-observation')
        for key in ('native_session_ref', 'final_ref'):
            if seat[key] is not None:
                read(seat[key], json_proof=False)
    trust = {}
    exec(compile(path_bytes(TOOLS / 'panel-seat-trust'), str(TOOLS / 'panel-seat-trust'), 'exec'), trust)
    retired = []
    targets = []
    for seat in launch['seats']:
        pane = exact_pane(request['session'], seat['window'])
        require(all(pane[key] == seat['pane'][key] for key in ('window_id', 'pane_id', 'pid')), 'cleanup target is not original owned pane')
        require(process_identity(pane['pid']) == seat['pane_process'], 'cleanup pane process was replaced')
        custody = process_custody(pane['pid'])
        folder = Path(seat['directory'])
        trust['seat_paths'](str(folder))
        temp = seat.get('temp')
        if temp is not None:
            path = Path(temp['temp'])
            require(temp['seat'] == str(folder) and path == Path('/private/tmp') / ('panel-' + str(folder.stat().st_ino)), 'cleanup temp identity conflict')
            require(path.is_dir() and not path.is_symlink() and path.stat().st_uid == os.getuid() and path.stat().st_mode & 0o777 == 0o700 and path_bytes(path / '.panel-seat') == (str(folder) + '\n').encode(), 'cleanup ownership marker mismatch')
        targets.append((seat, pane, folder, temp, custody))
    for seat, pane, folder, temp, custody in targets:
        current = exact_pane(request['session'], seat['window'])
        require(all(current[key] == pane[key] for key in ('window_id', 'pane_id', 'pid')), 'cleanup target changed after preflight')
        fresh(Path(launch['batch']) / (seat['seat_id'] + '-cleanup-started.json'), dict(launch_ref=launch_ref, custody=custody, created_at=now()))
        run(['tmux', 'kill-window', '-t', pane['window_id']])
        require(not any(row['window_id'] == pane['window_id'] for row in panes(request['session'])), 'window closure unverified')
        deadline = time.monotonic() + 3
        while remaining_processes(custody) and time.monotonic() < deadline:
            time.sleep(.1)
        for held in remaining_processes(custody):
            if held in remaining_processes([held]):
                os.kill(held['pid'], signal.SIGTERM)
        deadline = time.monotonic() + 3
        while remaining_processes(custody) and time.monotonic() < deadline:
            time.sleep(.1)
        require(not remaining_processes(custody), 'owned process closure unverified; temp retained')
        if temp is not None:
            path = Path(temp['temp'])
            require(path_bytes(path / '.panel-seat') == (str(folder) + '\n').encode() and not path.is_symlink(), 'cleanup temp changed after preflight')
            run(['trash', str(path)])
        logical = '/tmp' + str(folder)[len('/private/tmp'):]
        if seat['transport'] in ('fable', 'deepseek'):
            config = Path.home() / '.claude.json'
            with trust['DirLock'](config):
                value = decode(path_bytes(config))
                for key in (str(folder), logical):
                    value.get('projects', {}).pop(key, None)
                trust['write_atomic'](config, json.dumps(value, indent=2), stat.S_IMODE(config.stat().st_mode))
        elif seat['transport'] == 'gemini':
            config = Path.home() / '.gemini/antigravity-cli/settings.json'
            with trust['DirLock'](config):
                value = decode(path_bytes(config))
                value['trustedWorkspaces'] = [p for p in value.get('trustedWorkspaces', []) if p not in (str(folder), logical)]
                trust['write_atomic'](config, json.dumps(value, indent=2), stat.S_IMODE(config.stat().st_mode))
        else:
            import tomllib
            config = Path.home() / '.local/state/codex-panel-home/config.toml'
            with trust['DirLock'](config):
                text = path_bytes(config).decode()
                for key in (str(folder), logical):
                    pattern = r'(?m)^\[projects\."' + re.escape(key) + r'"\]\ntrust_level = "trusted"\n?'
                    text = re.sub(pattern, '', text)
                tomllib.loads(text)
                trust['write_atomic'](config, text, stat.S_IMODE(config.stat().st_mode))
        retired.append(dict(seat_id=seat['seat_id'], directory=str(folder), temp=temp, trust_retired=True, window_closed=True, captured_processes_closed=True, custody=custody, process_scope='observed pane descendants; no universal OS containment guarantee'))
        fresh(Path(launch['batch']) / (seat['seat_id'] + '-cleanup-done.json'), retired[-1])
    return fresh(Path(args.output), dict(phase='cleaned', launch_ref=launch_ref, collected_ref=collection_ref, seats=retired, seat_evidence='retained, not deleted', created_at=now()))


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest='phase', required=True)
    prepare_parser = sub.add_parser('prepare')
    prepare_parser.add_argument('--request', required=True)
    prepare_parser.add_argument('--batch', required=True)
    launch_parser = sub.add_parser('launch')
    launch_parser.add_argument('--prepared', required=True)
    own_parser = sub.add_parser('own')
    for name in ('prepared', 'seat-id', 'pane'):
        own_parser.add_argument('--' + name, required=True)
    collect_parser = sub.add_parser('collect')
    collect_parser.add_argument('--launched', required=True)
    collect_parser.add_argument('--native-index', required=True)
    collect_parser.add_argument('--native-sha256', required=True)
    verify_parser = sub.add_parser('verify')
    for name in ('protocol-root', 'project-root', 'dispatch', 'ledger', 'ledger-sha256', 'output'):
        verify_parser.add_argument('--' + name, required=True)
    wait_parser = sub.add_parser('wait')
    for name in ('launched', 'locations', 'locations-sha256', 'output'):
        wait_parser.add_argument('--' + name, required=True)
    cleanup_parser = sub.add_parser('cleanup')
    for name in ('launched', 'collected', 'collected-sha256', 'output'):
        cleanup_parser.add_argument('--' + name, required=True)
    retain_parser = sub.add_parser('retain')
    for name in ('launched', 'native-index', 'native-sha256', 'output'):
        retain_parser.add_argument('--' + name, required=True)
    for child in (prepare_parser, launch_parser, own_parser, collect_parser, verify_parser, cleanup_parser, retain_parser, wait_parser):
        child.add_argument('--sha256', required=True)
    args = parser.parse_args()
    try:
        result = globals()[args.phase](args)
        print(json.dumps(result, sort_keys=True))
        return 0
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print('STOP: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
