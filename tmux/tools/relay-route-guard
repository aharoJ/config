#!/usr/bin/env python3
# path: ~/.config/tmux/tools/relay-route-guard
# description: Cooperative live-source routing guard; same-account hostile bypass is outside its boundary.
# patched: apply vendor-neutral seat roles and bidirectional orchestrator relationships
# date: 2026-10-06
import argparse
import ctypes
import json
import os
import pathlib
import re
import runpy
import shlex
import stat
import subprocess
import sys
import time
import uuid
import tempfile
import pwd
import fcntl
import sqlite3

LABEL = runpy.run_path(str(pathlib.Path(__file__).with_name('relay-sender-label')))
POLICY = pathlib.Path(__file__).with_name('relay-route-policy.json')
SOURCE_BINDINGS = pathlib.Path(pwd.getpwuid(os.getuid()).pw_dir) / '.local/state/relay/source-bindings.json'
RUNTIME_LOGS = pathlib.Path(pwd.getpwuid(os.getuid()).pw_dir) / '.codex/logs_2.sqlite'


def run(env, *args):
    if args[0] == 'tmux':
        args = (env.get('TMUX_BIN', 'tmux'), *args[1:])
        if env.get('TMUX'):
            args = (args[0], '-S', env['TMUX'].split(',', 1)[0], *args[1:])
    return subprocess.run(args, env=env, check=True, capture_output=True, text=True, timeout=3).stdout.strip()


def socket(env):
    value = run(env, 'tmux', 'display-message', '-p', '#{socket_path}')
    path = pathlib.Path(value).resolve(strict=True)
    info = path.stat()
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
        raise ValueError('invalid tmux socket')
    return {'path': str(path), 'device': info.st_dev, 'inode': info.st_ino}


def panes(env):
    result = []
    for line in run(env, 'tmux', 'list-panes', '-a', '-F', '#{pane_id} #{session_name} #{window_name} #{pane_pid} #{pane_dead}').splitlines():
        row = line.split()
        if len(row) == 5 and row[4] == '0':
            result.append([row[0], row[1], row[2], '', row[3], row[4]])
    return result


def identity(pid):
    return LABEL['ps']('-p', str(pid), '-o', 'lstart=,comm=').strip()


def ancestors(pid, table=None):
    table = LABEL['processes']() if table is None else table
    result, seen = [], set()
    while pid > 1 and pid in table and pid not in seen:
        seen.add(pid)
        parent, command = table[pid]
        try:
            app_name = LABEL['app'](pid, command)
            if app_name == 'codex':
                argv = LABEL['process_argv'](pid)
                if len(argv) > 1 and argv[1] == 'app-server':
                    app_name = ''
        except (OSError, ValueError, subprocess.SubprocessError):
            app_name = ''
        result.append((pid, parent, command, app_name))
        pid = parent
    return result


def source_bindings():
    if not SOURCE_BINDINGS.exists():
        return {'version': 1, 'bindings': {}, 'active': {}}
    info = SOURCE_BINDINGS.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
        raise ValueError('unsafe source bindings')
    data = json.loads(SOURCE_BINDINGS.read_text())
    if data.get('version') != 1 or not isinstance(data.get('bindings'), dict) or not isinstance(data.get('active'), dict) or not isinstance(data.get('proofs', {}), dict):
        raise ValueError('invalid source bindings')
    return data


def pane_source(env, row):
    pane, session, window, _, root, _ = row
    table = LABEL['processes']()
    candidates = []
    for actor_pid in table:
        lineage = ancestors(actor_pid, table)
        if not lineage or not lineage[0][3] or not any(item[0] == int(root) for item in lineage):
            continue
        groups = LABEL['ps']('-p', str(actor_pid), '-o', 'pgid=,tpgid=').split()
        if len(groups) == 2 and str(actor_pid) == groups[0] == groups[1]:
            candidates.append(lineage[0])
    if len(candidates) != 1:
        raise ValueError('unresolved foreground source')
    actor = candidates[0]
    source = {'version': 2, 'pane': pane, 'session': session, 'window': window,
              'root': int(root), 'root_identity': identity(int(root)), 'app': actor[3],
              'actor': actor[0], 'actor_identity': identity(actor[0]), 'socket': socket(env)}
    if not live(env, source):
        raise ValueError('source changed')
    return source


def register_source_unlocked(env, thread, seat, verified=False, verified_since=None):
    if str(uuid.UUID(thread)) != thread:
        raise ValueError('name an exact Codex thread UUID')
    target = seat.split(':')
    if len(target) != 2 or not all(re.fullmatch(r'[A-Za-z0-9_-]+', name) for name in target) or (not verified and policy_document()['seats'].get(target[0], {}).get(target[1]) not in ('lead', 'worker')):
        raise ValueError('source must be a declared exact seat')
    rows = [row for row in panes(env) if row[1:3] == target]
    if len(rows) != 1:
        raise ValueError('source seat is missing or ambiguous')
    source = pane_source(env, rows[0])
    if source['app'] != 'codex':
        raise ValueError('thread binding requires a live interactive Codex seat')
    data = source_bindings()
    previous = data['bindings'].get(thread, {})
    key = str(source['socket']['device']) + ':' + str(source['socket']['inode']) + ':' + source['pane']
    same = {k: v for k, v in previous.items() if k != 'binding_epoch'} == source and data['active'].get(key) == thread
    if same and previous.get('binding_epoch'):
        since = data.get('proofs', {}).get(thread, {}).get('since', SOURCE_BINDINGS.stat().st_mtime)
        same = not thread_retired(thread, since)
    source['binding_epoch'] = previous['binding_epoch'] if same and previous.get('binding_epoch') else uuid.uuid4().hex
    data['bindings'][thread] = source
    data.setdefault('proofs', {})[thread] = {'since': verified_since if verified_since is not None else time.time(), 'kind': 'native-status' if verified else 'operator'}
    key = str(source['socket']['device']) + ':' + str(source['socket']['inode']) + ':' + source['pane']
    data['active'][key] = thread
    SOURCE_BINDINGS.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix='.source-bindings-', dir=SOURCE_BINDINGS.parent)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            json.dump(data, stream)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, SOURCE_BINDINGS)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return source


def register_source(env, thread, seat, verified=False, verified_since=None):
    SOURCE_BINDINGS.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = SOURCE_BINDINGS.parent.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
        raise ValueError('unsafe source bindings directory')
    descriptor = os.open(SOURCE_BINDINGS.with_suffix('.lock'), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise ValueError('unsafe source bindings lock')
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        return register_source_unlocked(env, thread, seat, verified, verified_since)
    finally:
        os.close(descriptor)


def thread_retired(thread, since):
    info = RUNTIME_LOGS.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
        raise ValueError('unsafe Codex runtime log')
    with sqlite3.connect(RUNTIME_LOGS.as_uri() + '?mode=ro', uri=True, timeout=.5) as connection:
        rows = connection.execute("SELECT ts, ts_nanos, feedback_log_body FROM logs WHERE thread_id=? AND ts>=? AND target='codex_app_server::thread_state' AND feedback_log_body LIKE ? ORDER BY ts DESC, ts_nanos DESC LIMIT 1", (thread, int(since), 'clearing thread listener during thread-state teardown thread_id=' + thread + ' %')).fetchall()
    return any(ts + nanos / 1_000_000_000 >= since and body.startswith('clearing thread listener during thread-state teardown thread_id=' + thread + ' ') for ts, nanos, body in rows)


def automatic_source(env, thread):
    candidates = []
    unavailable = []
    policy_document()
    for row in panes(env):
        source = None
        try:
            source = pane_source(env, row)
            if source['app'] != 'codex':
                continue
            started = time.time()
            result = subprocess.run([str(pathlib.Path(__file__).with_name('relay-codex-source-probe'))], input=json.dumps(source), env=env, capture_output=True, text=True, timeout=12)
            if result.returncode != 0:
                unavailable.append(source['session'] + ':' + source['window'])
            elif result.stdout.strip() == thread:
                candidates.append((source, started))
        except (ValueError, OSError, subprocess.SubprocessError):
            if source and source['app'] == 'codex':
                unavailable.append(source['session'] + ':' + source['window'])
            continue
    if unavailable or len(candidates) != 1:
        raise ValueError('native current-thread status is missing or ambiguous; source not bound; no relay target input was sent')
    source, started = candidates[0]
    registered = register_source(env, thread, source['session'] + ':' + source['window'], verified=True, verified_since=started)
    if {k: v for k, v in registered.items() if k != 'binding_epoch'} != source:
        raise ValueError('source generation changed during automatic binding')
    bound = dict(registered, thread_id=thread)
    if not live(env, bound):
        raise ValueError('thread retired during automatic binding')
    return bound


def daemon_source(env, chain):
    daemon = None
    for row in chain:
        if pathlib.Path(row[2]).name != 'codex':
            continue
        argv = LABEL['process_argv'](row[0])
        if len(argv) > 1 and argv[1] == 'app-server' :
            daemon = row
            break
    if daemon is None:
        return None
    thread = env.get('CODEX_THREAD_ID', '')
    if not thread or env.get('CODEX_SESSION_ID', thread) != thread:
        raise ValueError('shared daemon thread identity unavailable')
    if str(uuid.UUID(thread)) != thread:
        raise ValueError('shared daemon thread UUID is invalid')
    source_bindings()
    return automatic_source(env, thread)


def bind(env, pid):
    shared = daemon_source(env, ancestors(pid))
    if shared is not None:
        return shared
    rows = panes(env)
    origin = LABEL['origin'](pid, rows)
    if origin is not None:
        (pane, session, window, root, app), chain = origin
        actor = next((row for row in chain if row[3]), chain[-1])
    else:
        chain = ancestors(pid)
        if any(row[-2] == str(item[0]) for row in rows for item in chain):
            raise ValueError('ambiguous source pane')
        nearest = next((row for row in chain if row[3]), None)
        hint = env.get('TMUX_PANE', '')
        matches = [row for row in rows if row[0] == hint]
        if len(matches) != 1:
            raise ValueError('unresolved source')
        row = matches[0]
        pane, session, window, _, root, _ = row
        candidates = []
        table = LABEL['processes']()
        for actor_pid, (parent, command) in table.items():
            cursor, seen = actor_pid, set()
            while cursor > 1 and cursor in table and cursor not in seen and cursor != int(root):
                seen.add(cursor)
                cursor = table[cursor][0]
            if cursor != int(root):
                continue
            lineage = ancestors(actor_pid, table)
            app_name = lineage[0][3]
            if not app_name:
                continue
            groups = LABEL['ps']('-p', str(actor_pid), '-o', 'pgid=,tpgid=').split()
            if len(groups) == 2 and str(actor_pid) == groups[0] == groups[1]:
                candidates.append((actor_pid, parent, command, app_name))
        if len(candidates) != 1:
            raise ValueError('unresolved foreground source')
        actor = candidates[0]
        app = actor[3]
        if nearest is not None and nearest[0] != actor[0]:
            raise ValueError('source runtime mismatch')
    if actor is None or not re.fullmatch(r'%\d+', pane) or not all(re.fullmatch(r'[A-Za-z0-9_-]+', name) for name in (session, window)):
        raise ValueError('unresolved source')
    source = {'version': 2, 'pane': pane, 'session': session, 'window': window,
              'root': int(root), 'root_identity': identity(int(root)), 'app': app,
              'actor': actor[0], 'actor_identity': identity(actor[0]), 'socket': socket(env)}
    if not live(env, source):
        raise ValueError('source changed')
    return source


def foreground(actor, root):
    rows = LABEL['ps']('-ax', '-o', 'pid=,ppid=,pgid=,tpgid=').splitlines()
    table = {}
    active = []
    for row in rows:
        fields = row.split()
        if len(fields) == 4 and all(value.lstrip('-').isdigit() for value in fields):
            pid, parent, group, terminal = map(int, fields)
            table[pid] = parent
            if group > 0 and group == terminal:
                active.append(pid)
    for pid in active:
        seen = set()
        while pid > 1 and pid in table and pid not in seen:
            if pid == actor:
                return True
            seen.add(pid)
            pid = table[pid]
    return False


def live(env, source):
    try:
        if source['version'] not in (1, 2) or source['socket'] != socket(env):
            return False
        if 'thread_id' in source:
            data = source_bindings()
            thread = source['thread_id']
            bound = {key: value for key, value in source.items() if key != 'thread_id'}
            key = str(source['socket']['device']) + ':' + str(source['socket']['inode']) + ':' + source['pane']
            if data['bindings'].get(thread) != bound or data['active'].get(key) != thread:
                return False
            since = data.get('proofs', {}).get(thread, {}).get('since', SOURCE_BINDINGS.stat().st_mtime)
            if thread_retired(thread, since):
                return False
        expected = [source['pane'], source['session'], source['window'], '', str(source['root']), '0']
        if panes(env).count(expected) != 1:
            return False
        if identity(source['root']) != source['root_identity'] or identity(source['actor']) != source['actor_identity']:
            return False
        lineage = ancestors(source['actor'])
        return bool(lineage and (lineage[0][3] or 'relay') == source['app'] and any(row[0] == source['root'] for row in lineage) and foreground(source['actor'], source['root']))
    except (KeyError, TypeError, ValueError, OSError, subprocess.SubprocessError, sqlite3.Error):
        return False


def policy_document():
    info = POLICY.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
        raise ValueError('unsafe routing policy')
    data = json.loads(POLICY.read_text())
    if data.get('version') != 2 or not isinstance(data.get('seats'), dict):
        raise ValueError('invalid routing policy')
    mapping = data.get('orchestrator_of', {})
    workers = data.get('worker_orchestrator', {})
    if not isinstance(workers, dict):
        raise ValueError('invalid worker orchestrator mapping')
    if not isinstance(mapping, dict):
        raise ValueError('invalid orchestrator mapping')
    for session, target in [*mapping.items(), *workers.items()]:
        if not re.fullmatch(r'[A-Za-z0-9_-]+', session) or not isinstance(target, list) or len(target) != 2 or not all(isinstance(name, str) and re.fullmatch(r'[A-Za-z0-9_-]+', name) for name in target):
            raise ValueError('invalid orchestrator mapping')
    for session, seats in data['seats'].items():
        if not isinstance(session, str) or not re.fullmatch(r'[A-Za-z0-9_-]+', session) or not isinstance(seats, dict):
            raise ValueError('invalid seat session')
        for seat, role in seats.items():
            if not isinstance(seat, str) or not re.fullmatch(r'[A-Za-z0-9_-]+', seat) or role not in ('lead', 'worker'):
                raise ValueError('invalid seat role')
    for target in [*mapping.values(), *workers.values()]:
        if data['seats'].get(target[0], {}).get(target[1]) != 'lead':
            raise ValueError('orchestrator must be a declared lead')
    return data


def policy():
    return policy_document()['seats']


def orchestrators():
    return policy_document().get('orchestrator_of', {})


def process_executable(pid):
    if sys.platform == 'darwin':
        buffer = ctypes.create_string_buffer(4096)
        library = ctypes.CDLL('/usr/lib/libproc.dylib')
        if library.proc_pidpath(int(pid), buffer, len(buffer)) <= 0:
            raise ValueError('process executable unavailable')
        return pathlib.Path(os.fsdecode(buffer.value)).resolve(strict=True)
    return pathlib.Path('/proc', str(pid), 'exe').resolve(strict=True)


def python_script(pid):
    argv = LABEL['process_argv'](pid)
    if len(argv) < 2:
        return None
    executable = process_executable(pid)
    if not executable.name.lower().startswith('python') or not pathlib.Path(argv[0]).name.lower().startswith('python'):
        return None
    index = 1
    while index < len(argv) and argv[index].startswith('-'):
        if argv[index] in ('-u', '-B', '-I', '-E', '-s', '-S', '-O', '-OO'):
            index += 1
        elif argv[index] == '--':
            index += 1
            break
        else:
            return None
    if index >= len(argv):
        return None
    return pathlib.Path(argv[index]).resolve(strict=True), argv[index + 1:]


def check(env, source, session, window):
    try:
        document = policy_document()
        if not live(env, source) or not all(re.fullmatch(r'[A-Za-z0-9_-]+', name) for name in (session, window)):
            return False
        if source['session'] == session or env.get('RELAY_OPERATOR') == '1':
            return True
        if source.get('app') not in ('claude', 'codex', 'agy', 'gemini'):
            return False
        seats = document['seats']
        source_role = seats.get(source['session'], {}).get(source['window'], 'worker')
        target_role = seats.get(session, {}).get(window, 'worker')
        mapping = document.get('orchestrator_of', {})
        workers = document.get('worker_orchestrator', {})
        source_mapping = mapping if source_role == 'lead' else workers
        target_mapping = mapping if target_role == 'lead' else workers
        upward = source_mapping.get(source['session']) == [session, window]
        downward = target_mapping.get(session) == [source['session'], source['window']]
        return bool((source_role == target_role == 'lead' or upward or downward) and live(env, source))
    except (OSError, ValueError, TypeError, KeyError, IndexError, subprocess.SubprocessError, sqlite3.Error):
        return False


def record_caller_once(pid, record, source):
    chain = ancestors(pid)
    nearest = next((row for row in chain if row[3]), None)
    mismatch = nearest is not None and nearest[0] != source.get('actor')
    expected = pathlib.Path(record).resolve(strict=True)
    tools = pathlib.Path(__file__).resolve().parent
    for chain_index, (actor_pid, parent, command, app) in enumerate(chain):
        try:
            invocation = python_script(actor_pid)
            if invocation is None:
                continue
            script, argv = invocation
            if script not in (tools / 'cc-msg-queue', tools / 'relay-clear-draft'):
                continue
            if argv[:1] == ['--schedule']:
                if script != tools / 'cc-msg-queue' or len(argv) != 3 or not argv[2].isdigit() or int(argv[2]) < 3:
                    continue
                if pathlib.Path(argv[1]).resolve(strict=True) != expected.parent:
                    continue
                if mismatch and chain.index(nearest) <= chain_index:
                    continue
                return True
            if mismatch:
                continue
            if len(argv) == 2 and argv[:1] in (['--worker'], ['--prove']):
                flag = argv[0]
                index = 0
                if index + 1 >= len(argv):
                    continue
                argument = pathlib.Path(argv[index + 1]).resolve(strict=True)
                if flag == '--worker' and argument != expected:
                    continue
                if flag == '--prove':
                    if script.name != 'relay-clear-draft' or argument != expected.with_suffix('.plan'):
                        continue
                    plan = json.loads(argument.read_text())
                    if pathlib.Path(plan.get('record', '')).resolve(strict=True) != expected:
                        continue
            return True
        except (OSError, ValueError, subprocess.SubprocessError):
            continue
    return False


def record_caller(pid, record, source):
    for attempt in range(3):
        if record_caller_once(pid, record, source):
            return True
        if attempt < 2:
            time.sleep(.02)
    return False


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--caller', type=int, default=os.getppid())
    parser.add_argument('--target-session', required=True)
    parser.add_argument('--target-window', required=True)
    parser.add_argument('--record')
    parser.add_argument('--expect-source')
    args = parser.parse_args()
    if args.record:
        record = json.loads(pathlib.Path(args.record).read_text())
        if (record.get('session'), record.get('window')) != (args.target_session, args.target_window):
            raise ValueError('record target changed')
        source = record['source']
        if isinstance(source, dict) and source.get('app') == 'codex' and source.get('version') == 1:
            raise ValueError('legacy Codex record has no current thread/source proof; inspect before an explicit fresh send')
        if not isinstance(source, dict) or not record_caller(args.caller, args.record, source):
            nearest = next((row for row in ancestors(args.caller) if row[3]), None)
            reason = 'source actor mismatch' if nearest is not None and nearest[0] != source.get('actor') else 'canonical queue/clear invocation unavailable or record mismatch'
            raise ValueError('record caller provenance refused: ' + reason)
    else:
        source = bind(dict(os.environ), args.caller)
    if args.expect_source and source != json.loads(args.expect_source):
        raise ValueError('source changed after attribution')
    env = dict(os.environ)
    if args.record:
        env['RELAY_OPERATOR'] = '1' if record.get('operator') else '0'
    if not check(env, source, args.target_session, args.target_window):
        raise ValueError('route not allowed')
    print(json.dumps(source, separators=(',', ':'), sort_keys=True))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print('relay route refused: ' + str(error), file=sys.stderr)
        sys.exit(1)
