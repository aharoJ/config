import ctypes
import hashlib
import hmac
import json
import os
import pwd
from pathlib import Path
import secrets
import socket
import stat
import struct
import subprocess
import sys
import tempfile
import time

_run = getattr(subprocess, "_ks01_original_run", subprocess.run)
_lease = None
_installed = False
DESK_TMP = Path(pwd.getpwuid(os.geteuid()).pw_dir) / "desk/tmp"


class CleanupRefused(RuntimeError):
    pass


class BsdInfo(ctypes.Structure):
    _fields_ = [("head", ctypes.c_uint32 * 12), ("command", ctypes.c_char * 16),
                ("name", ctypes.c_char * 32), ("tail", ctypes.c_uint32 * 6),
                ("seconds", ctypes.c_uint64), ("micros", ctypes.c_uint64)]


def generation(pid):
    info = BsdInfo()
    function = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True).proc_pidinfo
    function.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]
    function.restype = ctypes.c_int
    if type(pid) is not int or not 0 < pid < 2**31:
        raise CleanupRefused("invalid kernel process identity")
    ctypes.set_errno(0)
    result = function(pid, 3, 0, ctypes.byref(info), ctypes.sizeof(info))
    if result == 0 and ctypes.get_errno() == 3:
        raise ProcessLookupError("kernel process absent")
    if result != 136:
        raise CleanupRefused("kernel generation unavailable")
    if info.head[3] == pid and info.head[1] == 5:
        raise ProcessLookupError("kernel process exited")
    if info.head[3] != pid or not info.seconds or info.micros >= 1000000:
        raise CleanupRefused("invalid/live kernel generation required")
    return [info.seconds, info.micros]


def protected(path, include_context=True):
    path = Path(path).resolve()
    paths = [Path(f"/private/tmp/tmux-{os.geteuid()}/default")]
    context = os.environ.get("TMUX")
    if include_context and context is not None:
        fields = context.rsplit(",", 2)
        if len(fields) != 3 or not fields[0] or not fields[1].isascii() or not fields[1].isdigit() or not fields[2].isascii() or not fields[2].isdigit():
            raise CleanupRefused("malformed inherited TMUX context")
        paths.append(Path(fields[0]))
    for candidate in paths:
        if path == candidate.resolve():
            return True
        try:
            if os.path.samefile(path, candidate):
                return True
        except FileNotFoundError:
            pass
    return False


def private_directory(path):
    info = path.lstat()
    if path.resolve() != path or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise CleanupRefused("nonprivate canonical directory")
    library = ctypes.CDLL(None, use_errno=True)
    library.acl_get_fd_np.argtypes = [ctypes.c_int, ctypes.c_int]
    library.acl_get_fd_np.restype = ctypes.c_void_p
    library.acl_get_entry.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.POINTER(ctypes.c_void_p)]
    library.acl_free.argtypes = [ctypes.c_void_p]
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        ctypes.set_errno(0)
        acl = library.acl_get_fd_np(fd, 0x100)
        if not acl:
            if ctypes.get_errno() != 2:
                raise CleanupRefused("ACL lookup failed")
        else:
            entry = ctypes.c_void_p()
            ctypes.set_errno(0)
            result = library.acl_get_entry(acl, 0, ctypes.byref(entry))
            error = ctypes.get_errno()
            library.acl_free(acl)
            if result == 0 or error != 22:
                raise CleanupRefused("extended ACL directory")
    finally:
        os.close(fd)


def encoded(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def signed(value, key):
    return dict(body=value, mac=hmac.new(bytes.fromhex(key), encoded(value), hashlib.sha256).hexdigest())


def write_private(path, value):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(fd, "wb") as output:
        output.write(encoded(value))
        output.flush()
        os.fsync(output.fileno())


def read_private(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    with os.fdopen(fd, "rb") as source:
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > 8192:
            raise CleanupRefused("unsafe lease file")
        value = json.load(source)
        if type(value) is not dict:
            raise CleanupRefused("invalid lease object")
        return value


def fresh_lease():
    root = Path(tempfile.mkdtemp(prefix="ks01-run-", dir=DESK_TMP))
    lease = dict(root=str(root), nonce=secrets.token_hex(32), key=secrets.token_hex(32), owner=os.getpid(), owner_generation=generation(os.getpid()))
    write_private(root / "lease.json", signed({key: value for key, value in lease.items() if key != "key"}, lease["key"]))
    return lease


def current_lease():
    global _lease
    if _lease is None:
        inherited = os.environ.get("KS01_RUN_CAP")
        if inherited is None:
            if "S7TK_CLEANUP_RECORD_DIR" in os.environ:
                raise CleanupRefused("record directory without this-run capability")
            _lease = fresh_lease()
            os.environ["KS01_RUN_CAP"] = json.dumps(_lease)
        else:
            _lease = json.loads(inherited)
    if type(_lease) is not dict or set(_lease) != {"root", "nonce", "key", "owner", "owner_generation"}:
        raise CleanupRefused("malformed run capability")
    if any(type(_lease[field]) is not str or len(_lease[field]) != 64 or any(char not in "0123456789abcdef" for char in _lease[field]) for field in ("nonce", "key")):
        raise CleanupRefused("invalid run capability")
    root = Path(_lease["root"])
    if not root.is_absolute() or not root.is_relative_to(DESK_TMP):
        raise CleanupRefused("lease outside desk/tmp")
    private_directory(root)
    expected = signed({key: value for key, value in _lease.items() if key != "key"}, _lease["key"])
    actual = read_private(root / "lease.json")
    if set(actual) != {"body", "mac"} or type(actual["mac"]) is not str or actual.get("body") != expected["body"] or not hmac.compare_digest(actual["mac"], expected["mac"]) or generation(_lease["owner"]) != _lease["owner_generation"]:
        raise CleanupRefused("stale or foreign run lease")
    return _lease


def record_directory():
    return Path(current_lease()["root"])


def route(argv, env=None, allow_current=False):
    args = [os.fspath(value) for value in argv]
    if "-S" in args:
        path = Path(args[args.index("-S") + 1])
        if not path.is_absolute() or path.resolve() != path:
            raise CleanupRefused("canonical absolute socket required")
    elif "-L" in args:
        label = args[args.index("-L") + 1]
        if not label or label == "default" or any(char not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_" for char in label):
            raise CleanupRefused("private label required")
        path = record_directory() / (hashlib.sha256(label.encode()).hexdigest()[:16] + ".sock")
    else:
        raise CleanupRefused("explicit owned socket required")
    if protected(path, include_context=not allow_current) or not path.is_relative_to(DESK_TMP) or len(os.fsencode(path)) >= 104:
        raise CleanupRefused("protected/outside-desk/tmp socket")
    private_directory(path.parent)
    return path


def record_path(path):
    return record_directory() / (hashlib.sha256(os.fsencode(path)).hexdigest() + ".json")


def observe(path, allow_current=False):
    if protected(path, include_context=not allow_current):
        raise CleanupRefused("protected server")
    private_directory(path.parent)
    info = path.lstat()
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.geteuid():
        raise CleanupRefused("not an owned socket")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as peer:
        peer.settimeout(2)
        peer.connect(str(path))
        pid = struct.unpack("i", peer.getsockopt(0, 2, 4))[0]
    return dict(path=str(path), device=info.st_dev, inode=info.st_ino, pid=pid, generation=generation(pid))


def save(path):
    lease = current_lease()
    observation = observe(path)
    result = _run([str(Path("/opt/homebrew/bin/tmux").resolve(strict=True)), "-N", "-S", str(path), "display-message", "-p", "#{pid}|#{start_time}|#{@ks01_socket_nonce}|#{socket_path}"], capture_output=True, text=True, timeout=3)
    fields = result.stdout.strip().split("|", 3)
    marker = read_private(record_path(path))["body"]["marker"]
    if result.returncode or len(fields) != 4 or fields[0] != str(observation["pid"]) or not fields[1].isascii() or not fields[1].isdigit() or fields[2] != marker or fields[3] != str(path) or observe(path) != observation:
        raise CleanupRefused("created server identity/marker changed")
    record = dict(observation, server_start=int(fields[1]), marker=marker, nonce=lease["nonce"], owner=lease["owner"], owner_generation=lease["owner_generation"])
    destination = record_path(path)
    pending = destination.with_suffix("." + secrets.token_hex(8) + ".pending")
    write_private(pending, signed(record, lease["key"]))
    os.replace(pending, destination)


def claim(path):
    path = route(["tmux", "-S", str(path)])
    if os.path.lexists(path):
        raise CleanupRefused("socket already exists")
    prior = record_path(path)
    if prior.exists():
        if not prior_server_gone(load(path)):
            raise CleanupRefused("prior server still owns this claim")
        os.rename(prior, prior.with_suffix(".retired-" + secrets.token_hex(16)))
    lease = current_lease()
    marker = secrets.token_hex(32)
    write_private(record_path(path), signed(dict(state="claimed", path=str(path), marker=marker, nonce=lease["nonce"], owner=lease["owner"], owner_generation=lease["owner_generation"]), lease["key"]))
    return marker


def bind(path):
    path = route(["tmux", "-S", str(path)])
    lease = current_lease()
    data = read_private(record_path(path))
    body = data.get("body")
    if type(body) is not dict:
        raise CleanupRefused("invalid precreation claim")
    marker = body.get("marker")
    if type(marker) is not str or len(marker) != 64 or any(char not in "0123456789abcdef" for char in marker):
        raise CleanupRefused("invalid socket marker")
    expected = dict(state="claimed", path=str(path), marker=marker, nonce=lease["nonce"], owner=lease["owner"], owner_generation=lease["owner_generation"])
    if data != signed(expected, lease["key"]):
        raise CleanupRefused("no this-run precreation claim")
    save(path)


def load(path):
    lease = current_lease()
    try:
        data = read_private(record_path(path))
    except (OSError, ValueError) as error:
        raise CleanupRefused("missing or unreadable this-run socket proof") from error
    record = data.get("body", {})
    if type(record) is not dict or set(record) != {"path", "device", "inode", "pid", "generation", "server_start", "marker", "nonce", "owner", "owner_generation"} or record.get("path") != str(path) or record.get("nonce") != lease["nonce"] or record.get("owner") != lease["owner"] or record.get("owner_generation") != lease["owner_generation"]:
        raise CleanupRefused("not this-run socket proof")
    if set(data) != {"body", "mac"} or type(data["mac"]) is not str or not hmac.compare_digest(data["mac"], signed(record, lease["key"])["mac"]):
        raise CleanupRefused("forged/stale socket lease")
    if any(type(record[field]) is not int or record[field] <= 0 for field in ("inode", "pid", "server_start")) or record["pid"] >= 2**31 or type(record["device"]) is not int or record["device"] < 0:
        raise CleanupRefused("invalid socket identity fields")
    stamp = record["generation"]
    if type(stamp) is not list or len(stamp) != 2 or any(type(value) is not int for value in stamp) or stamp[0] <= 0 or not 0 <= stamp[1] < 1000000:
        raise CleanupRefused("invalid server kernel generation")
    marker = record["marker"]
    if type(marker) is not str or len(marker) != 64 or any(char not in "0123456789abcdef" for char in marker):
        raise CleanupRefused("invalid server marker")
    return record


def observation_matches(path, record, allow_current=False):
    return observe(path, allow_current=allow_current) == {key: record[key] for key in ("path", "device", "inode", "pid", "generation")}


def prior_server_gone(record):
    try:
        return generation(record["pid"]) != record["generation"]
    except ProcessLookupError:
        return True


def retire_dead_socket(path, record):
    if protected(path) or load(path) != record or not prior_server_gone(record):
        raise CleanupRefused("socket retirement lacks current dead-server proof")
    private_directory(path.parent)
    try:
        observe(path)
    except FileNotFoundError:
        return
    except ConnectionRefusedError:
        pass
    else:
        raise CleanupRefused("socket still has a listener")
    info = path.lstat()
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.geteuid() or (info.st_dev, info.st_ino) != (record["device"], record["inode"]):
        raise CleanupRefused("socket retirement identity changed")
    path.unlink()


def literal(value):
    return value.replace("#", "##").replace(",", "#,").replace("}", "#}")


def stop(path, **kwargs):
    path = Path(path)
    if not path.is_absolute() or path.resolve() != path or protected(path) or not path.is_relative_to(DESK_TMP):
        raise CleanupRefused("protected/noncanonical/outside-desk/tmp cleanup")
    record = load(path)
    try:
        info = path.lstat()
    except FileNotFoundError:
        if prior_server_gone(record):
            return subprocess.CompletedProcess([], 0, "", "owned recorded server already absent; no backend requested")
        raise CleanupRefused("recorded server live without its socket")
    if (info.st_dev, info.st_ino) != (record["device"], record["inode"]):
        raise CleanupRefused("socket or server generation changed")
    try:
        matches = observation_matches(path, record)
    except ConnectionRefusedError:
        retire_dead_socket(path, record)
        return subprocess.CompletedProcess([], 0, "", "owned dead server socket retired; no backend requested")
    if not matches:
        raise CleanupRefused("socket or server generation changed")
    condition = f"#{{&&:#{{==:#{{pid}},{record['pid']}}},#{{==:#{{start_time}},{record['server_start']}}},#{{==:#{{@ks01_socket_nonce}},{record['marker']}}},#{{==:#{{socket_path}},{literal(str(path))}}}}}"
    command = [str(Path("/opt/homebrew/bin/tmux").resolve(strict=True)), "-N", "-S", str(path), "if-shell", "-F", condition, "kill-server", "display-message -p ks01-cleanup-refused"]
    result = _run(command, capture_output=True, text=True, timeout=min(kwargs.get("timeout", 3), 3))
    if result.stdout.strip() or result.returncode:
        raise CleanupRefused("server-side cleanup identity guard refused")
    for _ in range(50):
        if prior_server_gone(record):
            retire_dead_socket(path, record)
            break
        time.sleep(0.01)
    else:
        raise CleanupRefused("owned server exit is unverified")
    if kwargs.get("check") and result.returncode:
        raise subprocess.CalledProcessError(result.returncode, command, result.stdout, result.stderr)
    return result


def stop_label(label, **kwargs):
    return stop(route(["tmux", "-L", label]), **kwargs)


def guarded_run(argv, *args, **kwargs):
    if isinstance(argv, (str, bytes)):
        if b"kill-server" in os.fsencode(argv):
            raise CleanupRefused("opaque shell cleanup refused")
        return _run(argv, *args, **kwargs)
    values = [os.fspath(value) for value in argv]
    at = 1
    binary_at = 0
    if Path(values[0]).name in ("timeout", "gtimeout"):
        while at < len(values) and values[at].startswith("-"):
            at += 1
        at += 1
        binary_at = at
        at += 1
    if binary_at >= len(values) or Path(values[binary_at]).name not in ("tmux", "tmux-private"):
        return _run(argv, *args, **kwargs)
    while at < len(values) and values[at].startswith("-"):
        if values[at] not in ("-L", "-S", "-f", "-N", "-u", "-2"):
            raise CleanupRefused("unapproved/combined global tmux option")
        if values[at] == "-c" or (values[at] == "-f" and values[at + 1] != "/dev/null"):
            raise CleanupRefused("shell/global config execution is not a test cleanup capability")
        at += 2 if values[at] in ("-L", "-S", "-f", "-c") else 1
    command = values[at] if at < len(values) else None
    if command is None:
        raise CleanupRefused("explicit test command required")
    globals_ = values[binary_at + 1:at]
    if globals_.count("-S") + globals_.count("-L") != 1:
        raise CleanupRefused("exactly one explicit socket selector required")
    if command != "send-keys" and ";" in values[at + 1:]:
        raise CleanupRefused("caller-supplied multi-command queue refused")
    path = route(globals_, kwargs.get("env"), allow_current=command != "kill-server")
    if command == "kill-server":
        return stop(path, **kwargs)
    existed = path.exists()
    if command != "new-session" and not existed:
        raise CleanupRefused("no live this-run server")
    if command not in ("send-keys", "new-session") and any("kill-server" in value for value in values[at + 1:]):
        raise CleanupRefused("nested server cleanup refused")
    if existed and not observation_matches(path, load(path), allow_current=True):
        raise CleanupRefused("preexisting server is not this-run owned")
    selector = binary_at + 1 + (globals_.index("-S") if "-S" in globals_ else globals_.index("-L"))
    values[selector:selector + 2] = ["-S", str(path)]
    values[binary_at] = str(Path("/opt/homebrew/bin/tmux").resolve(strict=True))
    if command != "new-session" and "-N" not in values[binary_at + 1:at]:
        values.insert(binary_at + 1, "-N")
    if command == "new-session" and "-f" not in values[binary_at + 1:at]:
        values[binary_at + 1:binary_at + 1] = ["-f", "/dev/null"]
    env = dict(kwargs.get("env", os.environ))
    env["KS01_RUN_CAP"] = json.dumps(current_lease())
    env.pop("S7TK_CLEANUP_RECORD_DIR", None)
    env.pop("TMUX", None)
    env.pop("TMUX_PANE", None)
    kwargs["env"] = env
    if command == "new-session" and not existed:
        marker = claim(path)
        values += [";", "set-option", "-g", "@ks01_socket_nonce", marker]
    try:
        result = _run(values, *args, **kwargs)
    finally:
        if command == "new-session" and not existed and path.exists():
            bind(path)
    return result


def install():
    global _installed
    if not _installed:
        current_lease()
        subprocess._ks01_original_run = _run
        subprocess.run = guarded_run
        _installed = True


def proxy_run(label, argv, *args, **kwargs):
    path = route(["tmux", "-L", label], allow_current=True)
    values = [os.fspath(value) for value in argv]
    if values[:1] == ["-S"]:
        if len(values) < 2 or values[1] != str(path):
            raise CleanupRefused("proxy socket differs from its leased route")
        values = values[2:]
    return guarded_run(["tmux", "-S", str(path), "-f", "/dev/null", *values], *args, **kwargs)


def run_tmux(argv, *args, **kwargs):
    values = [os.fspath(value) for value in argv]
    if not values or Path(values[0]).name not in ("tmux", "tmux-private"):
        raise CleanupRefused("unapproved test tmux executable")
    return guarded_run(values, *args, **kwargs)


if __name__ == "__main__":
    try:
        role = sys.argv[1]
        if role == "proxy":
            sys.exit(proxy_run(sys.argv[2], sys.argv[3:]).returncode)
        if role == "supervise":
            current_lease()
            sys.exit(_run(sys.argv[2:], env=os.environ).returncode)
        if role == "records":
            print(record_directory())
            sys.exit(0)
        if role == "claim":
            claim(Path(sys.argv[2]))
            sys.exit(0)
        if role == "bind":
            bind(Path(sys.argv[2]))
            sys.exit(0)
        if role == "run":
            sys.exit(run_tmux(sys.argv[2:]).returncode)
        if role != "stop":
            raise CleanupRefused("unsupported cleanup action")
        sys.exit(stop(route(sys.argv[2:]), timeout=3).returncode)
    except (CleanupRefused, OSError, ValueError, IndexError, KeyError, TypeError) as error:
        print(f"#ks01 cleanup refused: {error}", file=sys.stderr)
        sys.exit(97)
