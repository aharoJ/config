#!/usr/bin/env perl
# path: ~/.config/tmux/tools/relay-input-guard
# description: Refuse drafts while recognizing captured Claude and Codex composer boundaries.
# patched: recognize verified Codex status variants and proven empty placeholder rows
# date: 2026-10-01T23:02:00Z
use strict;
use warnings;
use utf8;
use Encode qw(decode FB_CROAK);

binmode STDIN,  ':encoding(UTF-8)';
binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

# Exit status is deliberately narrow:
#   0 = the composer is visibly empty with its verified UI placeholder;
#   1 = a draft or any ambiguous non-empty composer;
#   2 = the current composer cannot be found.
my ($glyph, $cursor_x, $cursor_y) = @ARGV;
exit 2 if @ARGV != 3 || !defined($glyph) || !defined($cursor_x) || !defined($cursor_y);
eval { $glyph = decode('UTF-8', $glyph, FB_CROAK); 1 } or exit 2;
exit 2 if length($glyph) == 0;
exit 2 if $cursor_x !~ /\A[0-9]+\z/ || $cursor_y !~ /\A[0-9]+\z/;

my @rows = <STDIN>;

sub visible_row {
    my ($row) = @_;
    # tmux -e preserves SGR and may preserve OSC-8 hyperlinks.  Remove those
    # sequences only to locate the row; the raw row is inspected below.
    $row =~ s/\e\[[0-?]*[ -\/]*[@-~]//g;
    $row =~ s/\e\][^\e\a]*(?:\a|\e\\)//g;
    return $row;
}

# capture-pane without -S/-E is exactly the current screen, so tmux's
# zero-based cursor_y selects the one row that can be a live composer.  Do
# not let a prompt-looking historical row above it make a stale transcript
# look like an empty current input.
my @prompt_rows;
for my $index (0 .. $#rows) {
    my $visible = visible_row($rows[$index]);
    push @prompt_rows, $index if $visible =~ /^\h*\Q$glyph\E/;
}
exit 2 if $cursor_y > $#rows;
my $prompt_index = $cursor_y;
my $cursor_visible = visible_row($rows[$prompt_index]);
if ($cursor_visible !~ /^\h*\Q$glyph\E/) {
    # A real wrapped value leaves the cursor on a continuation row.  It is
    # not safe to send in that state; report it as a draft when a composer
    # is visible, otherwise as an unknown UI state.
    exit(@prompt_rows ? 1 : 2);
}

sub expected_empty_cursor_x {
    my ($visible, $glyph) = @_;
    $visible =~ s/[\r\n]+\z//;

    # We deliberately accept only the one blank cell that both clients put
    # after their glyph.  Counting arbitrary trailing blanks would make a
    # draft made solely of spaces indistinguishable from terminal padding.
    return undef if $visible !~ /^([ \x{a0}]*)\Q$glyph\E(.*)\z/s;
    my ($leading, $after) = ($1, $2);
    my $column = length($leading) + 1; # Both known prompt glyphs are one cell.
    if (length($after) && (substr($after, 0, 1) eq ' ' || substr($after, 0, 1) eq "\x{a0}")) {
        $column++;
    }
    return $column;
}

my $empty_cursor_x = expected_empty_cursor_x($cursor_visible, $glyph);
# This is independent of colour. A rendered suggestion leaves the terminal
# cursor immediately after the prompt spacer, while every ordinary typed
# value (including one space, CJK, or emoji) advances it. An unfamiliar
# prompt geometry is refused rather than guessed.
exit 1 if !defined($empty_cursor_x) || $cursor_x != $empty_cursor_x;

sub apply_sgr {
    my ($parameters, $dim_ref) = @_;
    my $set_dim = 0;
    my @parameters = length($parameters) ? split(/;/, $parameters, -1) : (0);
    for (my $index = 0; $index <= $#parameters; $index++) {
        my $parameter = $parameters[$index];
        # SGR colour subparameters can be colon-separated.  Only the leading
        # attribute number changes intensity.
        my ($code) = split(/:/, $parameter, 2);
        $code = 0 if !defined($code) || $code eq '';
        if ($code eq '38' || $code eq '48' || $code eq '58') {
            next if index($parameter, ':') >= 0;
            # In semicolon-form extended colours, the next number is a mode
            # (5 or 2), not an intensity attribute.  In particular, the "2"
            # in 48;2;R;G;B must not be mistaken for dim.
            my ($colour_mode) = split(/:/, $parameters[$index + 1] // '', 2);
            if (defined($colour_mode) && $colour_mode eq '5') {
                $index += 2;
            } elsif (defined($colour_mode) && $colour_mode eq '2') {
                $index += 4;
            } else {
                $index++;
            }
            next;
        }
        if ($code eq '0') {
            $$dim_ref = 0;
        } elsif ($code eq '2') {
            $$dim_ref = 1;
            $set_dim = 1;
        } elsif ($code eq '22') {
            $$dim_ref = 0;
        }
    }
    return $set_dim;
}

sub row_is_dim_or_blank {
    my ($raw, $dim_ref) = @_;
    while (length $raw) {
        if ($raw =~ s/^\e\[([0-?]*[ -\/]*)([@-~])//) {
            return 0 if $2 ne 'm';
            apply_sgr($1, $dim_ref);
            next;
        }
        # A placeholder never needs an OSC/control sequence.  Treat one as
        # ambiguity rather than risking a typed value hidden by formatting.
        return 0 if $raw =~ s/^\e\][^\e\a]*(?:\a|\e\\)//;
        return 0 if $raw =~ s/^\e//;

        my $character = substr($raw, 0, 1, '');
        next if $character eq ' ' || $character eq "\t" || $character eq "\x{a0}" || $character eq "\r" || $character eq "\n";
        return 0 if !$$dim_ref;
    }
    return 1;
}

sub codex_plain_footer {
    my ($rows_ref, $start, $index) = @_;
    return 0 if $index != $start + 2;
    my $separator = $rows_ref->[$start + 1];
    $separator =~ s/\e\[[0-9;:]*m//g;
    return 0 if $separator !~ /\A *\r?\n?\z/;
    my $raw_footer = $rows_ref->[$index];
    return 0 if $raw_footer =~ /\e\[48(?:;|:)/;
    my $footer = $raw_footer;
    $footer =~ s/\e\[[0-9;:]*m//g;
    my $prefix = qr/  Fast (?:on|off) · [A-Za-z0-9][A-Za-z0-9._-]*(?: (?:default|minimal|low|medium|high|xhigh|max|ultra))? · (?:~(?:\/[^·\x00-\x1f\x7f]+)?|\/[^·\x00-\x1f\x7f]+) · /;
    my $context = qr/Context (?:100|[0-9]{1,2})% used(?: · Main \[default\])?(?: · ← for agents)?(?: {2,}⚠ [1-9][0-9]* warnings? · f2 to view)? */;
    return 1 if $footer =~ /\A$prefix$context\r?\n?\z/;

    # The observed no-Context footer is accepted only with its trusted
    # terminal status styling; a plain footer-shaped draft line remains unsafe.
    return 0 if $raw_footer !~ /\e\[49m/ || $raw_footer !~ /\e\[38(?:;|:)/;
    return $footer =~ /\A$prefix← for agents *\r?\n?\z/;
}

sub blank_tail_after_boundary {
    my ($rows_ref, $boundary) = @_;
    for my $index ($boundary + 1 .. $#$rows_ref) {
        my $tail_dim = 0;
        return 0 if !row_is_dim_or_blank($rows_ref->[$index], \$tail_dim);
    }
    return 1;
}

sub composer_has_safe_tail {
    my ($rows_ref, $start, $glyph, $dim_ref) = @_;
    my $cc_end = -1;
    if ($glyph eq '❯') {
        for my $index ($start + 1 .. $#$rows_ref) {
            my $visible = visible_row($rows_ref->[$index]);
            $visible =~ s/[\r\n]+\z//;
            $cc_end = $index if $visible =~ /^\h*─{20,}\h*\z/;
        }
    }
    for my $index ($start + 1 .. $#$rows_ref) {
        my $raw = $rows_ref->[$index];
        my $visible = visible_row($raw);
        $visible =~ s/[\r\n]+\z//;

        # Claude ends its composer with a divider.  Anything visible before
        # it is either a wrapped value or an unknown UI state, so refuse.
        if ($glyph eq '❯' && $index == $cc_end) {
            return 1;
        }

        # Codex's footer begins only after the composer background resets.
        # A following input background means it is still composer content.
        if ($glyph eq '›') {
            return blank_tail_after_boundary($rows_ref, $index) if codex_plain_footer($rows_ref, $start, $index);
            my $path = qr/(?:~(?:\/[^·\x00-\x1f\x7f]+)?|\/[^·\x00-\x1f\x7f]+)/;
            my $structured = $visible =~ /\A  Fast (?:on|off) · [A-Za-z0-9][A-Za-z0-9._-]*(?: (?:default|minimal|low|medium|high|xhigh|max|ultra))? · (?:(?:$path · )?Context (?:100|[0-9]{1,2})% used(?: · Main \[default\])?(?: · ← for agents)?(?: {2,}⚠ [1-9][0-9]* warnings? · f2 to view)?|$path · ← for agents) *\z/;
            my $reset_at = index($raw, "\e[49m");
            if ($reset_at >= 0) {
                my $after_reset = substr($raw, $reset_at + length("\e[49m"));
                return blank_tail_after_boundary($rows_ref, $index) if $structured && $after_reset !~ /\e\[48(?:;|:)/ && $after_reset !~ /\e\]/;
            }

            # With NO_COLOR and some 256-colour terminals, Codex omits the
            # input background/reset.  Its normal status footer remains
            # rendered as a coloured, structured "Fast … · … Context …"
            # row.  Keep this deliberately strict: an unfamiliar footer is
            # not treated as a boundary and therefore refuses the send.
            if ($structured && $raw =~ /\e\[38(?:;|:)/ && $raw !~ /\e\[48(?:;|:)|\e\]/) {
                return blank_tail_after_boundary($rows_ref, $index);
            }
        }

        return 0 if !row_is_dim_or_blank($raw, $dim_ref);
    }
    # A cropped or unfamiliar composer has no trustworthy boundary.
    return 0;
}

# Codex renders its current empty composer as this exact dim placeholder.  A
# cursor at the prompt column alone proves nothing: a draft can be moved Home,
# and a trailing space draft is omitted by capture-pane.  Do not treat generic
# dim text or a bare prompt as empty.
sub codex_known_placeholder {
    my ($raw, $glyph) = @_;
    return 0 if $glyph ne '›';

    my $scan = $raw;
    my $at_input = 0;
    my $dim = 0;
    my $saw_dim_after_glyph = 0;
    my $all_visible_text_dim = 1;
    my $after_glyph = '';

    while (length $scan) {
        if ($scan =~ s/^\e\[([0-?]*[ -\/]*)([@-~])//) {
            return 0 if $2 ne 'm';
            my $set_dim = apply_sgr($1, \$dim);
            $saw_dim_after_glyph ||= $at_input && $set_dim;
            next;
        }
        # A verified placeholder row has no OSC or other terminal controls.
        return 0 if $scan =~ s/^\e\][^\e\a]*(?:\a|\e\\)//;
        return 0 if $scan =~ s/^\e//;

        if (!$at_input && index($scan, $glyph) == 0) {
            substr($scan, 0, length($glyph), '');
            $at_input = 1;
            next;
        }

        my $character = substr($scan, 0, 1, '');
        if (!$at_input) {
            next if $character eq ' ' || $character eq "\t" || $character eq "\x{a0}";
            return 0;
        }

        $after_glyph .= $character;
        if ($character ne ' ' && $character ne "\t" && $character ne "\x{a0}" && $character ne "\r" && $character ne "\n") {
            $all_visible_text_dim &&= $dim;
        }
    }

    return 0 if !$at_input || !$saw_dim_after_glyph || !$all_visible_text_dim;
    $after_glyph =~ s/[\r\n]+\z//;
    return $after_glyph eq ' Ask Codex to do anything';
}

if ($glyph eq '›') {
    my $tail_dim = 0;
    exit 1 if !codex_known_placeholder($rows[$prompt_index], $glyph);
    exit 1 if !composer_has_safe_tail(\@rows, $prompt_index, $glyph, \$tail_dim);
    exit 0;
}

my $raw = $rows[$prompt_index];
chomp $raw;
my $at_input = 0;
my $dim = 0;
my $saw_explicit_dim_after_glyph = 0;
my $has_visible_input = 0;
my $unknown_control_after_glyph = 0;

while (length $raw) {
    if ($raw =~ s/^\e\[([0-?]*[ -\/]*)([@-~])//) {
        my ($parameters, $final) = ($1, $2);
        if ($final ne 'm') {
            $unknown_control_after_glyph ||= $at_input;
            next;
        }

        my $set_dim = apply_sgr($parameters, \$dim);
        $saw_explicit_dim_after_glyph = 1 if $at_input && $set_dim;
        next;
    }

    if ($raw =~ s/^\e\][^\e\a]*(?:\a|\e\\)//) {
        $unknown_control_after_glyph ||= $at_input;
        next;
    }

    if ($raw =~ s/^\e//) {
        $unknown_control_after_glyph ||= $at_input;
        next;
    }

    if (!$at_input && index($raw, $glyph) == 0) {
        substr($raw, 0, length($glyph), '');
        $at_input = 1;
        next;
    }

    my $character = substr($raw, 0, 1, '');
    if (!$at_input) {
        # The selected row was visibly anchored at the glyph.  Anything else
        # here means an escape sequence made that conclusion unreliable.
        next if $character eq ' ' || $character eq "\t" || $character eq "\x{a0}";
        exit 2;
    }

    # tmux pads rows with spaces and Claude's blank composer uses NBSP.
    next if $character eq ' ' || $character eq "\t" || $character eq "\x{a0}";

    $has_visible_input = 1;
    exit 1 if !$dim;
}

exit 1 if !$at_input || $unknown_control_after_glyph;
exit 1 if !composer_has_safe_tail(\@rows, $prompt_index, $glyph, \$dim);
exit 0 if !$has_visible_input;

# Do not trust inherited styling: a non-empty value is safe only when tmux
# showed an explicit dim transition after the prompt glyph on this row.
exit($saw_explicit_dim_after_glyph ? 0 : 1);
