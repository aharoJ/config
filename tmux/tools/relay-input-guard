#!/usr/bin/env perl
# path: ~/.config/tmux/tools/relay-input-guard
# description: Refuse drafts while recognizing captured Claude, Codex, and Agy composers.
# patched: accept the observed empty Claude post-delete status hint
# date: 2026-10-02T04:00:00Z
use strict;
use warnings;
use utf8;
use Encode qw(decode FB_CROAK);

binmode STDIN,  ':encoding(UTF-8)';
binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

# Exit status is deliberately narrow:
#   0 = the composer is visibly empty or has only verified dim app text;
#   1 = a draft or any ambiguous non-empty composer;
#   2 = the current composer cannot be found.
my ($glyph, $cursor_x, $cursor_y, $pane_width, $sender_tier) = @ARGV;
exit 2 if (@ARGV < 3 || @ARGV > 5) || !defined($glyph) || !defined($cursor_x) || !defined($cursor_y);
exit 2 if defined($sender_tier) && $sender_tier ne 'relaxed' && $sender_tier ne 'strict';
$sender_tier //= 'strict';
eval { $glyph = decode('UTF-8', $glyph, FB_CROAK); 1 } or exit 2;
exit 2 if length($glyph) == 0;
exit 2 if $cursor_x !~ /\A[0-9]+\z/ || $cursor_y !~ /\A[0-9]+\z/;
exit 2 if defined($pane_width) && $pane_width !~ /\A[0-9]+\z/;

my @rows = <STDIN>;

sub visible_row {
    my ($row) = @_;
    # tmux -e preserves SGR and may preserve OSC-8 hyperlinks.  Remove those
    # sequences only to locate the row; the raw row is inspected below.
    $row =~ s/\e\[[0-?]*[ -\/]*[@-~]//g;
    $row =~ s/\e\][^\e\a]*(?:\a|\e\\)//g;
    return $row;
}

# capture-pane without -S/-E is exactly the current screen, so tmux's
# zero-based cursor_y selects the one row that can be a live composer.  Do
# not let a prompt-looking historical row above it make a stale transcript
# look like an empty current input.
my @prompt_rows;
for my $index (0 .. $#rows) {
    my $visible = visible_row($rows[$index]);
    push @prompt_rows, $index if $visible =~ /^\h*\Q$glyph\E/;
}
exit 2 if $cursor_y > $#rows;
my $prompt_index = $cursor_y;
my $cursor_visible = visible_row($rows[$prompt_index]);
my $cursor_on_prompt = $cursor_visible =~ /^\h*\Q$glyph\E/;

sub expected_empty_cursor_x {
    my ($visible, $glyph) = @_;
    $visible =~ s/[\r\n]+\z//;

    # We deliberately accept only the one blank cell that both clients put
    # after their glyph.  Counting arbitrary trailing blanks would make a
    # draft made solely of spaces indistinguishable from terminal padding.
    return undef if $visible !~ /^([ \x{a0}]*)\Q$glyph\E(.*)\z/s;
    my ($leading, $after) = ($1, $2);
    my $column = length($leading) + 1; # Known prompt glyphs are one cell.
    $column++ if $glyph eq '>';
    if (length($after) && (substr($after, 0, 1) eq ' ' || substr($after, 0, 1) eq "\x{a0}")) {
        $column++;
    }
    return $column;
}

my $empty_cursor_x = $cursor_on_prompt ? expected_empty_cursor_x($cursor_visible, $glyph) : undef;
exit 1 if $cursor_on_prompt && !defined($empty_cursor_x);

sub apply_sgr {
    my ($parameters, $dim_ref, $conceal_ref) = @_;
    my $set_dim = 0;
    my @parameters = length($parameters) ? split(/;/, $parameters, -1) : (0);
    for (my $index = 0; $index <= $#parameters; $index++) {
        my $parameter = $parameters[$index];
        # SGR colour subparameters can be colon-separated.  Only the leading
        # attribute number changes intensity.
        my ($code) = split(/:/, $parameter, 2);
        $code = 0 if !defined($code) || $code eq '';
        # CSI SGR parameters are decimal numbers. Leading zeroes do not
        # change their meaning (for example, 08 is conceal), so compare the
        # normalized numeric value rather than its original spelling.
        $code = 0 + $code;
        if ($code eq '38' || $code eq '48' || $code eq '58') {
            next if index($parameter, ':') >= 0;
            # In semicolon-form extended colours, the next number is a mode
            # (5 or 2), not an intensity attribute.  In particular, the "2"
            # in 48;2;R;G;B must not be mistaken for dim.
            my ($colour_mode) = split(/:/, $parameters[$index + 1] // '', 2);
            $colour_mode = 0 + $colour_mode if defined($colour_mode) && $colour_mode =~ /\A[0-9]+\z/;
            if (defined($colour_mode) && $colour_mode eq '5') {
                $index += 2;
            } elsif (defined($colour_mode) && $colour_mode eq '2') {
                $index += 4;
            } else {
                $index++;
            }
            next;
        }
        if ($code eq '0') {
            $$dim_ref = 0;
        } elsif ($code eq '2') {
            $$dim_ref = 1;
            $set_dim = 1;
        } elsif ($code eq '8') {
            # Once conceal appears in an input marker, do not treat the row
            # as a verified placeholder even if a later reset clears it.
            $$conceal_ref = 1 if defined $conceal_ref;
        } elsif ($code eq '22') {
            $$dim_ref = 0;
        }
    }
    return $set_dim;
}

sub row_has_trusted_sgr {
    my ($raw) = @_;
    my $dim = 0;
    my $conceal = 0;
    while (length $raw) {
        if ($raw =~ s/^\e\[([0-?]*[ -\/]*)([@-~])//) {
            my ($parameters, $final) = ($1, $2);
            return 0 if $final ne 'm' || $parameters !~ /\A[0-9:;]*\z/;
            apply_sgr($parameters, \$dim, \$conceal);
            next;
        }
        # Trusted boundaries contain only numeric SGR styling; an OSC or a
        # non-SGR CSI could change the terminal state while looking blank.
        return 0 if $raw =~ s/^\e\][^\e\a]*(?:\a|\e\\)//;
        return 0 if $raw =~ s/^\e//;

        substr($raw, 0, 1, '');
    }
    return !$conceal;
}

sub row_is_blank {
    my ($raw) = @_;
    my $dim = 0;
    my $conceal = 0;
    while (length $raw) {
        if ($raw =~ s/^\e\[([0-?]*[ -\/]*)([@-~])//) {
            my ($parameters, $final) = ($1, $2);
            return 0 if $final ne 'm' || $parameters !~ /\A[0-9:;]*\z/;
            apply_sgr($parameters, \$dim, \$conceal);
            next;
        }
        # A blank compositor tail never needs an OSC/control sequence.
        return 0 if $raw =~ s/^\e\][^\e\a]*(?:\a|\e\\)//;
        return 0 if $raw =~ s/^\e//;

        my $character = substr($raw, 0, 1, '');
        next if $character eq ' ' || $character eq "\t" || $character eq "\x{a0}" || $character eq "\r" || $character eq "\n";
        return 0;
    }
    return !$conceal;
}

sub row_is_canonical_separator {
    my ($raw) = @_;
    # A real Codex empty composer is followed by a zero-cell separator.
    # Spaces here can be a whitespace-only wrapped draft, so never infer a
    # boundary from a merely blank-looking row.
    return $raw =~ /\A\r?\n?\z/;
}

sub claude_known_divider {
    my ($raw) = @_;
    return 0 if !row_has_trusted_sgr($raw);
    my $visible = visible_row($raw);
    $visible =~ s/[\r\n]+\z//;
    return $visible =~ /^\h*─{8,}\h*\z/;
}

sub codex_plain_footer {
    my ($rows_ref, $start, $index) = @_;
    return 0 if $index != $start + 2;
    my $separator = $rows_ref->[$start + 1];
    return 0 if !row_is_canonical_separator($separator);
    my $raw_footer = $rows_ref->[$index];
    return 0 if !row_has_trusted_sgr($raw_footer);
    return 0 if $raw_footer =~ /\e\[48(?:;|:)/;
    my $footer = $raw_footer;
    $footer =~ s/\e\[[0-9;:]*m//g;
    my $prefix = qr/  Fast (?:on|off) · [A-Za-z0-9][A-Za-z0-9._-]*(?: (?:default|minimal|low|medium|high|xhigh|max|ultra))? · (?:~(?:\/[^·\x00-\x1f\x7f]+)?|\/[^·\x00-\x1f\x7f]+) · /;
    my $context = qr/Context (?:100|[0-9]{1,2})% used(?: · Main \[default\])?(?: · ← for agents)?(?: {2,}⚠ [1-9][0-9]* warnings? · f2 to view)? */;
    return 1 if $footer =~ /\A$prefix$context\r?\n?\z/;

    # The observed no-Context footer is accepted only with its trusted
    # terminal status styling; a plain footer-shaped draft line remains unsafe.
    return 0 if $raw_footer !~ /\e\[49m/ || $raw_footer !~ /\e\[38(?:;|:)/;
    return $footer =~ /\A$prefix← for agents *\r?\n?\z/;
}

sub codex_narrow_or_hint_footer {
    my ($rows_ref, $start, $index) = @_;
    return 0 if $index != $start + 2 || !row_is_canonical_separator($rows_ref->[$start + 1]);
    my $raw = $rows_ref->[$index];
    return 0 if !row_has_trusted_sgr($raw) || $raw =~ /\e\[48(?:;|:)|\e\]/;
    my $footer = visible_row($raw);
    $footer =~ s/[\r\n]+\z//;
    return 1 if $footer eq '  esc again to edit previous message' && $raw =~ /\e\[1mesc\e\[0m/;
    return 0 if $raw !~ /\e\[38(?:;|:)/;
    return 1 if $footer =~ /\A  Fast (?:on|off) · [A-Za-z0-9][A-Za-z0-9._-]*…  ⚠ [1-9][0-9]* · f2\z/;
    return 1 if $footer =~ /\A  Fast (?:on|off) · [A-Za-z0-9][A-Za-z0-9._-]*(?: (?:default|minimal|low|medium|high|xhigh|max|ultra))? · [^\r\n·]+…  ⚠ [1-9][0-9]* warnings? · f2 to view\z/;
    return 0;
}

sub blank_tail_after_boundary {
    my ($rows_ref, $boundary) = @_;
    for my $index ($boundary + 1 .. $#$rows_ref) {
        return 0 if !row_is_blank($rows_ref->[$index]);
    }
    return 1;
}

sub composer_has_safe_tail {
    my ($rows_ref, $start, $glyph) = @_;
    if ($glyph eq '❯') {
        my $divider = $start + 1;
        # No intervening row is a proven empty Claude state. In particular,
        # a space-only wrapped continuation can be a draft moved Home.
        # Rows below the closing divider are Claude's status line and mode
        # footer, never composer input.
        return 0 if $divider > $#$rows_ref || !claude_known_divider($rows_ref->[$divider]);
        my $divider_visible = visible_row($rows_ref->[$divider]);
        $divider_visible =~ s/[\r\n]+\z//;
        return 0 if defined($pane_width) && length($divider_visible) != $pane_width;
        for my $index ($divider + 1 .. $#$rows_ref) {
            return 0 if claude_known_divider($rows_ref->[$index]);
        }
        return 1;
    }
    for my $index ($start + 1 .. $#$rows_ref) {
        my $raw = $rows_ref->[$index];
        my $visible = visible_row($raw);
        $visible =~ s/[\r\n]+\z//;

        # Codex's footer begins only after the composer background resets.
        # A following input background means it is still composer content.
        if ($glyph eq '›') {
            return 0 if !row_has_trusted_sgr($raw);
            if ($index == $start + 2 && row_is_canonical_separator($rows_ref->[$start + 1])
                && $raw =~ /\e\[49m/ && $raw !~ /\e\[48(?:;|:)|\e\]/) {
                return blank_tail_after_boundary($rows_ref, $index);
            }
            if ($index == $start + 2 && row_is_canonical_separator($rows_ref->[$start + 1])
                && $visible =~ /\A  \S/ && $raw !~ /\e\[48(?:;|:)|\e\]/) {
                return blank_tail_after_boundary($rows_ref, $index);
            }
            return blank_tail_after_boundary($rows_ref, $index) if codex_plain_footer($rows_ref, $start, $index);
            return blank_tail_after_boundary($rows_ref, $index) if codex_narrow_or_hint_footer($rows_ref, $start, $index);
            if ($index == $start + 2 && row_is_canonical_separator($rows_ref->[$start + 1])
                && $raw !~ /\e\[48(?:;|:)|\e\]/ && $raw =~ /\e\[(?:49m|38[;:][0-9;:]*m|1m)/) {
                return blank_tail_after_boundary($rows_ref, $index);
            }
            my $path = qr/(?:~(?:\/[^·\x00-\x1f\x7f]+)?|\/[^·\x00-\x1f\x7f]+)/;
            my $structured = $visible =~ /\A  Fast (?:on|off) · [A-Za-z0-9][A-Za-z0-9._-]*(?: (?:default|minimal|low|medium|high|xhigh|max|ultra))? · (?:(?:$path · )?Context (?:100|[0-9]{1,2})% used(?: · Main \[default\])?(?: · ← for agents)?(?: {2,}⚠ [1-9][0-9]* warnings? · f2 to view)?|$path · ← for agents) *\z/;
            my $reset_at = index($raw, "\e[49m");
            if ($reset_at >= 0) {
                my $after_reset = substr($raw, $reset_at + length("\e[49m"));
                return blank_tail_after_boundary($rows_ref, $index) if $structured && $after_reset !~ /\e\[48(?:;|:)/ && $after_reset !~ /\e\]/;
            }

            # With NO_COLOR and some 256-colour terminals, Codex omits the
            # input background/reset.  Its normal status footer remains
            # rendered as a coloured, structured "Fast … · … Context …"
            # row.  Keep this deliberately strict: an unfamiliar footer is
            # not treated as a boundary and therefore refuses the send.
            if ($structured && $raw =~ /\e\[38(?:;|:)/ && $raw !~ /\e\[48(?:;|:)|\e\]/) {
                return blank_tail_after_boundary($rows_ref, $index);
            }

            # Codex's proven empty placeholder fits on its prompt row.  The
            # only allowed row before its footer is the zero-cell separator;
            # whitespace or styled continuation content is unproven input.
            return 0 if !row_is_canonical_separator($raw);
            next;
        }
    }
    # A cropped or unfamiliar composer has no trustworthy boundary.
    return 0;
}

sub agy_known_empty {
    my ($rows_ref, $start) = @_;
    return 0 if !defined($pane_width) || $pane_width < 8;
    my $raw = $rows_ref->[$start];
    return 0 if $raw !~ /\A\e\[94m>\e\[39m\r?\n?\z/;
    return 0 if $start == 0 || $start + 2 > $#$rows_ref;
    for my $divider_index ($start - 1, $start + 1) {
        my $divider_raw = $rows_ref->[$divider_index];
        return 0 if !row_has_trusted_sgr($divider_raw);
        my $visible = visible_row($divider_raw);
        $visible =~ s/[\r\n]+\z//;
        return 0 if $visible ne ('─' x $pane_width);
    }
    for my $index ($start + 2 .. $#$rows_ref) {
        return 0 if claude_known_divider($rows_ref->[$index]);
    }
    my $footer_raw = $rows_ref->[$start + 2];
    return 0 if !row_has_trusted_sgr($footer_raw);
    my $footer = visible_row($footer_raw);
    return $footer =~ /\A\? for shortcuts(?:\s+Gemini [^\r\n]+ · [^\r\n]+)?\r?\n?\z/;
}

sub codex_known_placeholder {
    my ($raw, $glyph) = @_;
    return 0 if $glyph ne '›';

    my $scan = $raw;
    my $at_input = 0;
    my $dim = 0;
    my $saw_dim_after_glyph = 0;
    my $saw_conceal_after_glyph = 0;
    my $all_visible_text_dim = 1;
    my $after_glyph = '';

    while (length $scan) {
        if ($scan =~ s/^\e\[([0-?]*[ -\/]*)([@-~])//) {
            my ($parameters, $final) = ($1, $2);
            return 0 if $final ne 'm' || $parameters !~ /\A[0-9:;]*\z/;
            my $set_dim = apply_sgr($parameters, \$dim, \$saw_conceal_after_glyph);
            $saw_dim_after_glyph ||= $at_input && $set_dim;
            next;
        }
        # A verified placeholder row has no OSC or other terminal controls.
        return 0 if $scan =~ s/^\e\][^\e\a]*(?:\a|\e\\)//;
        return 0 if $scan =~ s/^\e//;

        if (!$at_input && index($scan, $glyph) == 0) {
            substr($scan, 0, length($glyph), '');
            $at_input = 1;
            next;
        }

        my $character = substr($scan, 0, 1, '');
        if (!$at_input) {
            next if $character eq ' ' || $character eq "\t" || $character eq "\x{a0}";
            return 0;
        }

        $after_glyph .= $character;
        if ($character ne ' ' && $character ne "\t" && $character ne "\x{a0}" && $character ne "\r" && $character ne "\n") {
            $all_visible_text_dim &&= $dim;
        }
    }

    return 0 if !$at_input || !$saw_dim_after_glyph || $saw_conceal_after_glyph || !$all_visible_text_dim;
    $after_glyph =~ s/[\r\n]+\z//;
    return $after_glyph =~ /\A[ \x{a0}][^\r\n]*\z/;
}

sub dim_continuation_rows {
    my ($rows_ref, $start, $last) = @_;
    return 0 if $last <= $start;
    my $dim = 0;
    my $conceal = 0;
    for my $index ($start .. $last) {
        my $scan = $rows_ref->[$index];
        my $visible_text = 0;
        while (length $scan) {
            if ($scan =~ s/^\e\[([0-?]*[ -\/]*)([@-~])//) {
                my ($parameters, $final) = ($1, $2);
                return 0 if $final ne 'm' || $parameters !~ /\A[0-9:;]*\z/;
                apply_sgr($parameters, \$dim, \$conceal);
                next;
            }
            return 0 if $scan =~ s/^\e\][^\e\a]*(?:\a|\e\\)//;
            return 0 if $scan =~ s/^\e//;
            my $character = substr($scan, 0, 1, '');
            next if $index == $start;
            next if $character eq ' ' || $character eq "\x{a0}" || $character eq "\t" || $character eq "\r" || $character eq "\n";
            return 0 if !$dim || $conceal;
            $visible_text = 1;
        }
        return 0 if $index > $start && !$visible_text;
    }
    return !$conceal;
}

sub wrapped_dim_tail {
    my ($rows_ref, $start, $glyph, $cursor_row) = @_;
    if ($glyph eq '❯') {
        for my $divider ($start + 2 .. $#$rows_ref) {
            next if !claude_known_divider($rows_ref->[$divider]);
            next if defined($cursor_row) && $divider <= $cursor_row;
            my $visible = visible_row($rows_ref->[$divider]);
            $visible =~ s/[\r\n]+\z//;
            next if defined($pane_width) && length($visible) != $pane_width;
            return 0 if !dim_continuation_rows($rows_ref, $start, $divider - 1);
            for my $index ($divider + 1 .. $#$rows_ref) {
                return 0 if claude_known_divider($rows_ref->[$index]);
            }
            return 1;
        }
        return 0;
    }
    if ($glyph eq '›') {
        for my $separator ($start + 2 .. $#$rows_ref - 1) {
            next if !row_is_canonical_separator($rows_ref->[$separator]);
            next if defined($cursor_row) && $separator <= $cursor_row;
            next if !composer_has_safe_tail($rows_ref, $separator - 1, $glyph);
            return dim_continuation_rows($rows_ref, $start, $separator - 1);
        }
        for my $footer ($start + 2 .. $#$rows_ref) {
            next if defined($cursor_row) && $footer <= $cursor_row;
            my $raw = $rows_ref->[$footer];
            next if $raw !~ /\A\e\[49m/ || !row_has_trusted_sgr($raw) || $raw =~ /\e\[48(?:;|:)|\e\]/;
            my $visible = visible_row($raw);
            next if $visible !~ /\A  \S/ || !blank_tail_after_boundary($rows_ref, $footer);
            return dim_continuation_rows($rows_ref, $start, $footer - 1);
        }
    }
    return 0;
}

if (!$cursor_on_prompt) {
    exit(@prompt_rows ? 1 : 2) if $glyph eq '>';
    my $matches = 0;
    for my $candidate (reverse @prompt_rows) {
        next if $candidate >= $cursor_y;
        my $candidate_visible = visible_row($rows[$candidate]);
        next if !defined(expected_empty_cursor_x($candidate_visible, $glyph));
        next if $glyph eq '›' && !codex_known_placeholder($rows[$candidate], $glyph);
        next if $glyph eq '❯' && !claude_known_placeholder($rows[$candidate], $glyph);
        $matches++ if wrapped_dim_tail(\@rows, $candidate, $glyph, $cursor_y);
    }
    exit($matches == 1 ? 0 : (@prompt_rows ? 1 : 2));
}

sub ambiguous_input_at_home {
    my ($raw, $glyph) = @_;
    return 0 if $cursor_x != $empty_cursor_x;
    my $scan = $raw;
    my $at_input = 0;
    my $dim = 0;
    my $saw_conceal = 0;
    my $styled = 0;
    my $has_text = 0;
    my $input_started = 0;
    while (length $scan) {
        if ($scan =~ s/^\e\[([0-?]*[ -\/]*)([@-~])//) {
            my ($parameters, $final) = ($1, $2);
            return 0 if $final ne 'm' || $parameters !~ /\A[0-9:;]*\z/;
            $styled = 1 if $input_started;
            apply_sgr($parameters, \$dim, \$saw_conceal);
            next;
        }
        return 0 if $scan =~ s/^\e\][^\e\a]*(?:\a|\e\\)//;
        return 0 if $scan =~ s/^\e//;
        if (!$at_input && index($scan, $glyph) == 0) {
            substr($scan, 0, length($glyph), '');
            $at_input = 1;
            next;
        }
        my $character = substr($scan, 0, 1, '');
        next if !$at_input;
        if (!$input_started && ($character eq ' ' || $character eq "\x{a0}")) {
            $input_started = 1;
            next;
        }
        next if $character eq ' ' || $character eq "\x{a0}" || $character eq "\t" || $character eq "\r" || $character eq "\n";
        $has_text = 1;
        return 0 if $styled || $dim || $saw_conceal;
    }
    return $has_text && !$styled && !$saw_conceal;
}

if ($glyph eq '>') {
    exit 1 if $cursor_x != $empty_cursor_x;
    exit 1 if !agy_known_empty(\@rows, $prompt_index);
    exit 0;
}

if ($glyph eq '›') {
    if ($sender_tier eq 'strict' && ambiguous_input_at_home($rows[$prompt_index], $glyph)
        && composer_has_safe_tail(\@rows, $prompt_index, $glyph)) {
        print STDERR "relay-input-guard: cannot distinguish hint from Home-moved draft\n";
        exit 1;
    }
    exit 1 if !codex_known_placeholder($rows[$prompt_index], $glyph)
           && !($sender_tier eq 'relaxed' && ambiguous_input_at_home($rows[$prompt_index], $glyph));
    exit 1 if !composer_has_safe_tail(\@rows, $prompt_index, $glyph)
           && !(codex_known_placeholder($rows[$prompt_index], $glyph)
                && wrapped_dim_tail(\@rows, $prompt_index, $glyph));
    exit 0;
}

sub claude_known_empty {
    my ($raw, $glyph) = @_;
    return 0 if $glyph ne '❯';
    my $scan = $raw;
    my $at_input = 0;
    my $after_glyph = '';
    my $dim = 0;
    my $saw_conceal = 0;

    while (length $scan) {
        if ($scan =~ s/^\e\[([0-?]*[ -\/]*)([@-~])//) {
            my ($parameters, $final) = ($1, $2);
            return 0 if $final ne 'm' || $parameters !~ /\A[0-9:;]*\z/;
            apply_sgr($parameters, \$dim, \$saw_conceal);
            next;
        }
        # The known Claude empty marker has no OSC or other terminal control.
        return 0 if $scan =~ s/^\e\][^\e\a]*(?:\a|\e\\)//;
        return 0 if $scan =~ s/^\e//;

        if (!$at_input && index($scan, $glyph) == 0) {
            substr($scan, 0, length($glyph), '');
            $at_input = 1;
            next;
        }

        my $character = substr($scan, 0, 1, '');
        if (!$at_input) {
            next if $character eq ' ' || $character eq "\t" || $character eq "\x{a0}";
            return 0;
        }
        $after_glyph .= $character;
    }

    $after_glyph =~ s/[\r\n]+\z//;
    # A single NBSP is Claude's captured blank-composer marker.  A normal
    # space or any continuation is ambiguous and refuses.
    return 0 if !$at_input || $saw_conceal;
    return 1 if $after_glyph eq "\x{a0}";
    return $after_glyph eq "\x{a0} " && $raw =~ /\Q$glyph\E\x{a0}\e\[7m \e\[0m\r?\n?\z/;
}

sub claude_known_placeholder {
    my ($raw, $glyph) = @_;
    return 0 if $glyph ne '❯';
    my $scan = $raw;
    my $at_input = 0;
    my $dim = 0;
    my $saw_conceal = 0;
    my $saw_dim_after_glyph = 0;
    my $all_visible_text_dim = 1;
    my $after_glyph = '';

    while (length $scan) {
        if ($scan =~ s/^\e\[([0-?]*[ -\/]*)([@-~])//) {
            my ($parameters, $final) = ($1, $2);
            return 0 if $final ne 'm' || $parameters !~ /\A[0-9:;]*\z/;
            my $set_dim = apply_sgr($parameters, \$dim, \$saw_conceal);
            $saw_dim_after_glyph ||= $at_input && $set_dim;
            next;
        }
        return 0 if $scan =~ s/^\e\][^\e\a]*(?:\a|\e\\)//;
        return 0 if $scan =~ s/^\e//;

        if (!$at_input && index($scan, $glyph) == 0) {
            substr($scan, 0, length($glyph), '');
            $at_input = 1;
            next;
        }

        my $character = substr($scan, 0, 1, '');
        if (!$at_input) {
            next if $character eq ' ' || $character eq "\t" || $character eq "\x{a0}";
            return 0;
        }
        $after_glyph .= $character;
        if ($character ne ' ' && $character ne "\t" && $character ne "\x{a0}" && $character ne "\r" && $character ne "\n") {
            $all_visible_text_dim &&= $dim;
        }
    }

    return 0 if !$at_input || !$saw_dim_after_glyph || $saw_conceal || !$all_visible_text_dim;
    $after_glyph =~ s/[\r\n]+\z//;
    return $after_glyph =~ /\A[ \x{a0}][^\r\n]*\z/;
}

if ($sender_tier eq 'strict' && ambiguous_input_at_home($rows[$prompt_index], $glyph)
    && composer_has_safe_tail(\@rows, $prompt_index, $glyph)) {
    print STDERR "relay-input-guard: cannot distinguish hint from Home-moved draft\n";
    exit 1;
}
exit 1 if !claude_known_empty($rows[$prompt_index], $glyph)
       && !claude_known_placeholder($rows[$prompt_index], $glyph)
       && !($sender_tier eq 'relaxed' && ambiguous_input_at_home($rows[$prompt_index], $glyph));
exit 1 if !composer_has_safe_tail(\@rows, $prompt_index, $glyph)
       && !(claude_known_placeholder($rows[$prompt_index], $glyph)
            && wrapped_dim_tail(\@rows, $prompt_index, $glyph));
exit 0;
