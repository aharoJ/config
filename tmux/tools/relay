#!/usr/bin/env python3
# path: ~/.config/tmux/tools/relay
# description: Resolve an explicit seat or the caller's orchestrator and use its interactive adapter.
# patched: expose vendor-neutral destinations without per-send role overrides
# date: 2026-10-06
import os
from pathlib import Path
import runpy
import subprocess
import sys

TOOLS = Path(__file__).resolve().parent
GUARD = runpy.run_path(str(TOOLS / 'relay-route-guard'))


def main():
    args = sys.argv[1:]
    if args in (['--help'], ['-h']) or not args:
        print('usage: relay <session>:<seat>|orcha <literal text>\n       relay status [message-id]\n       relay --operator <session>:<seat> <text>\n       relay <session>:<seat> --clear-draft --expect <exact-text>')
        return 0
    if args[0] == 'status':
        root = Path(os.environ.get('CC_MSG_INBOX_ROOT', str(Path.home() / 'desk/tmp/inbox')))
        import json
        for record in root.glob('*/*.json'):
            data = json.loads(record.read_text())
            if len(args) == 1 or data['id'] == args[1]:
                print(data['state'] + ': ' + str(record))
        return 0
    operator = args[:1] == ['--operator']
    if operator:
        args = args[1:]
    if not args:
        raise ValueError('name the intended destination')
    source = GUARD['bind'](dict(os.environ), os.getpid())
    if args[0] == 'orcha':
        document = GUARD['policy_document']()
        role = document['seats'].get(source['session'], {}).get(source['window'], 'worker')
        target = document.get('orchestrator_of' if role == 'lead' else 'worker_orchestrator', {}).get(source['session'])
        if target is None:
            raise ValueError('no designated orchestrator; register this session relationship')
    else:
        target = args[0].split(':')
        if len(target) != 2:
            raise ValueError('destination must be an exact session:seat')
    session, window = target
    if not GUARD['check'](dict(os.environ, RELAY_OPERATOR='1' if operator else '0'), source, session, window):
        raise ValueError('seat relationship does not allow this destination; use its designated orchestrator')
    rows = [row for row in GUARD['panes'](dict(os.environ)) if row[1:3] == target]
    if len(rows) != 1:
        raise ValueError('destination is missing or ambiguous; open or name one live seat')
    row = rows[0]
    root = int(row[-2])
    table = GUARD['LABEL']['processes']()
    actors = []
    for pid, (parent, executable) in table.items():
        lineage = GUARD['ancestors'](pid, table)
        if not lineage or lineage[0][3] not in ('claude', 'codex', 'agy', 'gemini') or not any(item[0] == root for item in lineage):
            continue
        groups = GUARD['LABEL']['ps']('-p', str(pid), '-o', 'pgid=,tpgid=').split()
        if len(groups) == 2 and str(pid) == groups[0] == groups[1]:
            actors.append(lineage[0][3])
    if len(actors) != 1 or [item for item in GUARD['panes'](dict(os.environ)) if item[1:3] == target] != rows:
        raise ValueError('destination runtime is missing or changed; open the named interactive seat')
    app = actors[0]
    clear = args[1:2] == ['--clear-draft']
    message = ' '.join(args[1:]) if len(args) > 1 else sys.stdin.read()
    if app == 'claude':
        env = dict(os.environ, CC_MSG_SESSION=session, CC_MSG_WINDOW=window)
        command = [sys.executable, str(TOOLS / 'cc-msg-queue'), message]
    elif app == 'codex':
        env = dict(os.environ, CODEX_SEND_SESSION=session)
        command = [sys.executable, str(TOOLS / 'cc-msg-queue'), '--codex-to', window, message]
    elif app in ('agy', 'gemini'):
        env = dict(os.environ, AGY_SEND_SESSION=session)
        command = [sys.executable, str(TOOLS / 'cc-msg-queue'), '--agy-to', window, message]
    else:
        raise ValueError('destination is not a supported interactive agent; open the named seat')
    if clear:
        env['RELAY_OPERATOR'] = '1' if operator else '0'
        command = [sys.executable, str(TOOLS / 'relay-clear-draft'), app] + ([window] if app != 'claude' else []) + args[2:]
    elif operator:
        command.insert(2, '--operator')
    os.execve(sys.executable, command, env)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print('relay: refused: ' + str(error) + '; no target input was sent', file=sys.stderr)
        sys.exit(1)
