#!/usr/bin/env python3
# path: ~/.config/tmux/tools/cc-msg-queue
# description: Persist bound relay attempts and retry only confirmed no-input deferrals.
# patched: unify CC, Codex and Agy queue behavior and retain source context
# date: 2026-10-06
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import signal
import subprocess
import sys
import time
import uuid

TOOL = Path(__file__).resolve().with_name('cc-msg.sh')
ROOT = Path(os.environ.get('CC_MSG_INBOX_ROOT', str(Path.home() / 'desk/tmp/inbox')))
STARTED = runpy.run_path(str(TOOL.with_name('relay-started-watch')))


def save(path, data):
    temp = path.with_suffix('.new')
    with temp.open('w') as stream:
        json.dump(data, stream, ensure_ascii=False)
        stream.flush()
        os.fsync(stream.fileno())
    temp.replace(path)
    descriptor = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def event(folder, data, state, **extra):
    row = dict(id=data['id'], time=time.time(), state=state, **extra)
    with (folder / 'inbox.jsonl').open('a') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        stream.write(json.dumps(row, ensure_ascii=False) + '\n')
        stream.flush()
        os.fsync(stream.fileno())
    descriptor = os.open(folder, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


class RoutingError(ValueError):
    pass


def resolve_defaults(env, agent):
    prefix = 'CODEX_SEND' if agent.startswith('codex') else 'AGY_SEND' if agent == 'agy' else 'CC_MSG'
    socket = env.get('TMUX', '').split(',')[0]
    binary = env.get('TMUX_BIN', 'tmux')
    session = env.get(prefix + '_SESSION', '')
    if not session:
        if not socket:
            raise RoutingError('TMUX is required to resolve the caller session')
        args = [binary, '-S', socket, 'display-message', '-p']
        if env.get('TMUX_PANE'):
            args += ['-t', env['TMUX_PANE']]
        args += ['#{pane_id}|#{session_name}']
        result = subprocess.run(args, env=env, capture_output=True, text=True, timeout=5)
        fields = result.stdout.strip().split('|')
        if result.returncode or len(fields) != 2 or (env.get('TMUX_PANE') and fields[0] != env['TMUX_PANE']):
            raise RoutingError('cannot resolve the caller session')
        session = fields[1]
    window = env.get(prefix + '_WINDOW') or ('codex' if agent.startswith('codex') else 'agy' if agent == 'agy' else 'claude')
    if not all(re.fullmatch(r'[A-Za-z0-9_-]+', value) for value in (session, window)):
        raise RoutingError('invalid session or window')
    if window.isdigit():
        result = subprocess.run([binary, '-S', socket, 'list-windows', '-t', '=' + session, '-F', '#{window_index}|#{window_name}'], env=env, capture_output=True, text=True, timeout=5)
        names = [row.split('|', 1)[1] for row in result.stdout.splitlines() if row.split('|', 1)[0] == window and '|' in row]
        if result.returncode or len(names) != 1 or not re.fullmatch(r'[A-Za-z0-9_-]+', names[0]):
            raise RoutingError('window index does not resolve uniquely')
        window = names[0]
    env.update(CC_MSG_SESSION=session, CC_MSG_WINDOW=window, RELAY_QUEUE_AGENT=agent)
    if agent.startswith('codex'):
        env.update(CODEX_SEND_SESSION=session, CODEX_SEND_WINDOW=window)
        env.pop('CC_MSG_PANE', None)
    if agent == 'agy':
        env.update(AGY_SEND_SESSION=session, AGY_SEND_WINDOW=window)
        if env.get('AGY_SEND_PANE'):
            env['CC_MSG_PANE'] = env['AGY_SEND_PANE']
    return env


def routing_source(env, record=None):
    command = [str(TOOL.with_name('relay-route-guard')), '--caller', str(os.getpid()), '--target-session', env.get('CC_MSG_SESSION', ''), '--target-window', env.get('CC_MSG_WINDOW', '')]
    if record is not None:
        command += ['--record', str(record)]
    try:
        result = subprocess.run(command, env=env, capture_output=True, text=True, timeout=120 if record is None else 5)
        if result.returncode != 0:
            raise RoutingError(result.stderr.strip() or 'route refused')
        source = json.loads(result.stdout)
        if not isinstance(source, dict):
            raise RoutingError('cross-session send refused')
        return source
    except RoutingError:
        raise
    except subprocess.TimeoutExpired as error:
        phase = "initial source discovery" if record is None else "bound route verification"
        raise RoutingError(phase + " exceeded its deadline; message delivery was not requested by this check") from error
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        raise RoutingError('source binding unavailable; identify the live calling seat with TMUX_PANE') from error


def identity(env):
    session, window = env.get('CC_MSG_SESSION', ''), env.get('CC_MSG_WINDOW', '')
    if not all(re.fullmatch(r'[A-Za-z0-9_-]+', value) for value in (session, window)):
        return None
    socket = env.get('TMUX', '').split(',')[0]
    if not socket:
        return None
    try:
        stat = os.stat(socket)
        result = subprocess.run([env.get('TMUX_BIN', 'tmux'), '-S', socket, 'list-panes', '-a', '-F', '#{pane_id} #{session_name} #{window_name} #{pane_pid} #{pane_dead} #{pane_current_command} #{pane_tty}'], env=env, capture_output=True, text=True, timeout=5)
        candidates = [row.split() for row in result.stdout.splitlines() if len(row.split()) == 7 and row.split()[5] not in ('fish', 'bash', 'zsh', 'sh', 'dash', 'tmux') and row.split()[1:3] == [session, window] and row.split()[4] == '0' and (not env.get('CC_MSG_PANE') or row.split()[0] == env['CC_MSG_PANE'])]
        if result.returncode == 0 and len(candidates) == 1:
            row = candidates[0]
            processes = subprocess.run(['ps', '-t', row[6].removeprefix('/dev/'), '-o', 'pid=,pgid=,tpgid=,lstart=,comm='], capture_output=True, text=True, timeout=5)
            leaders = [line.split(None, 8) for line in processes.stdout.splitlines() if len(line.split(None, 8)) == 9 and line.split()[0] == line.split()[1] == line.split()[2]]
            if processes.returncode != 0 or len(leaders) != 1:
                return None
            return dict(socket=socket, device=stat.st_dev, inode=stat.st_ino, pane=row[0], pid=row[3], foreground=leaders[0])
    except (OSError, subprocess.TimeoutExpired):
        pass
    return None


def deliver(data, env):
    env = dict(env, CC_MSG_QUEUE_INTERNAL='1', TMUX_TIMEOUT_SECONDS='1', TMUX_TIMEOUT_KILL_AFTER='1', CC_MSG_QUEUE_STRICT='1')
    if data['identity']:
        env['CC_MSG_PANE'] = data['identity']['pane']
        env['CC_MSG_EXPECT_PID'] = data['identity']['pid']
        env['CC_MSG_EXPECT_IDENTITY'] = json.dumps(data['identity'])
    agent = data.get('agent', 'claude')
    tool = TOOL.with_name('codex-send') if agent == 'codex' else TOOL.with_name('codex-send-to') if agent == 'codex-to' else TOOL.with_name('agy-send-to') if agent == 'agy' else TOOL
    env['AGY_SEND_QUEUE_INTERNAL'] = '1'
    env['CODEX_SEND_QUEUE_INTERNAL'] = '1'
    env['RELAY_OPERATOR'] = '1' if data.get('operator') else '0'
    if data.get('record'):
        env['RELAY_MESSAGE_RECORD'] = data['record']
    command = [str(tool)] + ([env['CODEX_SEND_WINDOW']] if agent == 'codex-to' else [env['AGY_SEND_WINDOW']] if agent == 'agy' else [])
    process = subprocess.Popen(command, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
    try:
        stdout, stderr = process.communicate(data['message'], timeout=60)
        return process.returncode, stdout + stderr
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.communicate()
        return 4, 'transport exceeded 60 seconds; delivery unknown; no automatic resend'
    except BaseException:
        try:
            os.killpg(process.pid, signal.SIGTERM)
            process.communicate(timeout=3)
        except (ProcessLookupError, subprocess.TimeoutExpired):
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.communicate()
        raise



def finish(folder, path, data, state, code, output):
    data.update(state=state, code=code, output=output, updated=time.time())
    if state == 'delivered' and data.get('reply_warning_requested') and not data.get('reply_warning_checked'):
        env = dict(os.environ, **data.get('environment', {}))
        warning = STARTED['reply_warning'](env, data['session'], data['window'])
        if warning:
            data['reply_warning'] = warning
            print(warning)
    if state == 'delivered' and data.get('watch_minutes'):
        try:
            data['watch_baseline'] = STARTED['snapshot'](globals(), dict(os.environ, **data.get('environment', {})), data['identity'])
        except Exception as error:
            data['watch_error'] = str(error)
    save(path, data)
    event(folder, data, state, code=code, output=output)
    if state == 'delivered' and data.get('watch_baseline'):
        try:
            with path.with_suffix('.watch.log').open('a') as log:
                subprocess.Popen([sys.executable, str(Path(__file__).resolve()), '--watch-worker', str(path)], stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True, close_fds=True)
        except OSError as error:
            data['watch_error'] = str(error)
            save(path, data)
    if data.get('watch_error'):
        print('relay: delivered, but watch unavailable: ' + data['watch_error'])
    if state in ('failed', 'unknown', 'expired'):
        marker = folder / (data['id'] + '.FAILED')
        with marker.open('w') as stream:
            stream.write(f"{state}: {output}\nRecord: {path}\n")
            stream.flush()
            os.fsync(stream.fileno())


def stable_screen(env, target):
    command = [env.get('TMUX_BIN', 'tmux'), '-S', target['socket'], 'capture-pane', '-p', '-e', '-t', target['pane']]
    try:
        first = subprocess.run(command, env=env, capture_output=True, timeout=5)
        time.sleep(1)
        second = subprocess.run(command, env=env, capture_output=True, timeout=5)
        if first.returncode != 0 or second.returncode != 0:
            return False
        state = subprocess.run([env.get('TMUX_BIN', 'tmux'), '-S', target['socket'], 'display-message', '-p', '-t', target['pane'], '#{pane_in_mode}:#{cursor_y}'], env=env, capture_output=True, text=True, timeout=5)
        if state.returncode != 0 or not re.fullmatch(r'0:[0-9]+\n?', state.stdout):
            return False
        y = int(state.stdout.strip().split(':')[1])
        rows = re.sub(rb'\x1b\[[0-?]*[ -/]*[@-~]', b'', second.stdout).splitlines()
        first_rows = first.stdout.splitlines()
        second_rows = second.stdout.splitlines()
        if first_rows[max(0, y - 1):y + 2] != second_rows[max(0, y - 1):y + 2]:
            return False
        active = rows[max(0, y - 4):y + 1]
        return not any(row.strip() == b'ctrl+x ctrl+s to send now' or b'Press up to edit queued messages' in row for row in active)
    except (OSError, subprocess.TimeoutExpired):
        return False


def worker(path):
    folder = path.parent
    with (folder / (path.stem + '.lock')).open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = json.loads(path.read_text())
        env = dict(os.environ, **data.get('environment', {}))
        if data['state'] != 'queued':
            return
        try:
            routing_source(env, path)
        except RoutingError as error:
            finish(folder, path, data, 'failed', 1, str(error) + '; no target input was sent')
            return
        previous_handlers = {}
        def interrupted(signum, frame):
            raise RuntimeError(f'retry worker interrupted by signal {signum}')
        for signum in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            previous_handlers[signum] = signal.signal(signum, interrupted)
        try:
            while time.time() < data['deadline']:
                time.sleep(min(5, max(0, data['deadline'] - time.time())))
                if time.time() >= data['deadline']:
                    break
                if identity(env) != data['identity']:
                    finish(folder, path, data, 'failed', 1, 'target identity changed or cannot be proved; no resend')
                    return
                try:
                    routing_source(env, path)
                except RoutingError as error:
                    finish(folder, path, data, 'failed', 1, str(error) + '; no target input was sent')
                    return
                if not data.get('operator') and not stable_screen(env, data['identity']):
                    continue
                if time.time() >= data['deadline']:
                    break
                data['state'] = 'attempting'
                save(path, data)
                event(folder, data, 'retry')
                code, output = deliver(data, env)
                if code not in (2, 5):
                    finish(folder, path, data, 'delivered' if code == 0 else 'unknown' if code in (3, 4) else 'failed', code, output)
                    return
                finish(folder, path, data, 'queued', 6, output)
            finish(folder, path, data, 'expired', 7, '30-minute retry deadline reached; message remains in inbox; manual review required')
        except BaseException as error:
            finish(folder, path, data, 'unknown' if data['state'] == 'attempting' else 'failed', 7, str(error))
            raise
        finally:
            for signum, handler in previous_handlers.items():
                signal.signal(signum, handler)


def launch_worker(folder, path, data):
    with (folder / '.dispatch.lock').open('a') as dispatch:
        fcntl.flock(dispatch, fcntl.LOCK_EX)
        with (folder / '.scheduler.lock').open('a') as ownership:
            try:
                fcntl.flock(ownership, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                event(folder, data, 'worker-active')
                return
            with (folder / '.scheduler.log').open('a') as log:
                process = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), '--schedule', str(folder), str(ownership.fileno())], env=dict(os.environ, **data.get('environment', {})), stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True, close_fds=True, pass_fds=(ownership.fileno(),))
            event(folder, data, 'worker-started', pid=process.pid)


def schedule(folder, descriptor):
    folder = folder.resolve(strict=True)
    if folder.parent != ROOT.resolve(strict=True):
        raise RoutingError('scheduler folder is outside its inbox')
    info = os.fstat(descriptor)
    expected = (folder / '.scheduler.lock').stat()
    if (info.st_dev, info.st_ino) != (expected.st_dev, expected.st_ino):
        raise RoutingError('scheduler ownership changed')
    try:
        while True:
            with (folder / '.dispatch.lock').open('a') as dispatch:
                fcntl.flock(dispatch, fcntl.LOCK_EX)
                pending = [(json.loads(path.read_text()).get('created', 0), path) for path in folder.glob('*.json') if json.loads(path.read_text()).get('state') == 'queued']
                if not pending:
                    os.close(descriptor)
                    descriptor = -1
                    return
            worker(min(pending)[1])
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def sweep(folder=None):
    for path in (folder.glob('*.json') if folder else ROOT.glob('*/*.json')):
        folder = path.parent
        with (folder / (path.stem + '.lock')).open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                continue
            data = json.loads(path.read_text())
            if data['state'] in ('attempting', 'clear-authorized'):
                if time.time() - data.get('updated', data['created']) > 70:
                    finish(folder, path, data, 'unknown', 7, 'orphaned attempt; delivery unknown; no automatic resend')
            elif data['state'] == 'clear-inspecting' and time.time() - data['created'] > 70:
                finish(folder, path, data, 'clear-refused', 8, 'orphaned clear inspection; no target input was sent; clear not queued')
            elif data['state'] == 'queued':
                if time.time() >= data['deadline']:
                    finish(folder, path, data, 'expired', 7, 'retry deadline passed; manual review required')
                else:
                    try:
                        launch_worker(folder, path, data)
                    except OSError as error:
                        finish(folder, path, data, 'failed', 7, f'cannot recover retry worker: {error}')


def main():
    os.umask(0o077)
    if len(sys.argv) == 3 and sys.argv[1] == '--watch-worker':
        STARTED['watch'](globals(), Path(sys.argv[2]))
        return 0
    if len(sys.argv) == 4 and sys.argv[1] == '--schedule':
        schedule(Path(sys.argv[2]), int(sys.argv[3]))
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == '--worker':
        worker(Path(sys.argv[2]))
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == '--check-binding':
        return 0 if identity(dict(os.environ)) == json.loads(sys.argv[2]) else 1
    operator = sys.argv[1:2] in (['--operator'], ['-O'])
    if operator:
        del sys.argv[1]
    agent = os.environ.get('RELAY_QUEUE_AGENT', 'claude')
    targeted_message = None
    if sys.argv[1:2] == ['--codex']:
        agent = 'codex'
        del sys.argv[1]
        if sys.argv[1:2] in (['--operator'], ['-O']):
            operator = True
            del sys.argv[1]
    if sys.argv[1:2] == ['--agy-to']:
        agent = 'agy'
        if len(sys.argv) != 4:
            raise RoutingError('usage: agy-send-to <window> <text>')
        os.environ['AGY_SEND_WINDOW'] = sys.argv[2]
        targeted_message = sys.argv[3]
        del sys.argv[1:]
    if sys.argv[1:2] == ['--codex-to']:
        agent = 'codex-to'
        if len(sys.argv) != 4:
            raise RoutingError('usage: codex-send-to <window> <text>')
        os.environ['CODEX_SEND_WINDOW'] = sys.argv[2]
        targeted_message = sys.argv[3]
        del sys.argv[1:]
    if sys.argv[1:2] == ['--clear-draft']:
        env = resolve_defaults(dict(os.environ), agent)
        args = [agent] + ([env['CODEX_SEND_WINDOW']] if agent == 'codex' else [])
        return subprocess.call([sys.executable, str(TOOL.with_name('relay-clear-draft')), *args, *sys.argv[2:]], env=env)
    if sys.argv[1:] == ['--status']:
        for path in ROOT.glob('*/*.json'):
            print(f"{json.loads(path.read_text())['state']}: {path}")
        return 0
    if sys.argv[1:] in (['-h'], ['--help']):
        if agent == 'codex':
            print('usage: codex-send [--operator|-O] <text>')
        else:
            subprocess.run([str(TOOL), '--help'], env=dict(os.environ, CC_MSG_QUEUE_INTERNAL='1'))
        print('Options: --operator / -O interrupts and replaces input; agents use only for an explicit operator clear-and-inject command. Defaults: caller session, claude/codex window; numeric window indexes accepted.')
        print('Inbox: ~/desk/tmp/inbox/<session>-<window>-<socket-hash>/inbox.jsonl; --status lists durable outcomes; exit 6 = queued (do not resend), exit 7 = persistence/worker failure. Retries stop after 30 minutes; .FAILED files require review.')
        return 0
    env = resolve_defaults(dict(os.environ), agent)
    env['RELAY_OPERATOR'] = '1' if operator else '0'
    source = routing_source(env)
    message = targeted_message if targeted_message is not None else ' '.join(sys.argv[1:]) if len(sys.argv) > 1 else sys.stdin.read()
    session, window = env.get('CC_MSG_SESSION', ''), env.get('CC_MSG_WINDOW', '')
    key = f'{session}-{window}' if all(re.fullmatch(r'[A-Za-z0-9_-]+', value) for value in (session, window)) else 'invalid-target'
    key += '-' + hashlib.sha256(env.get('TMUX', '').split(',')[0].encode()).hexdigest()[:12]
    folder = ROOT / key
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    sweep(folder)
    data = dict(source=source, id=uuid.uuid4().hex, operator=operator, agent=agent, session=session, window=window, message=message, created=time.time(), deadline=time.time() + 1800, state='attempting', identity=identity(env), environment={key: env[key] for key in ('RELAY_QUEUE_AGENT', 'CODEX_SEND_SESSION', 'CODEX_SEND_WINDOW', 'AGY_SEND_SESSION', 'AGY_SEND_WINDOW', 'AGY_SEND_PANE', 'PATH', 'TMUX', 'TMUX_PANE', 'CC_MSG_SESSION', 'CC_MSG_WINDOW', 'CC_MSG_PANE', 'CC_MSG_EXACT', 'TMUX_BIN', 'TIMEOUT_BIN', 'TMPDIR', 'TMUX_RELAY_LOCK_ROOT', 'TMUX_RELAY_LOCK_BIN') if key in env})
    data['reply_warning_requested'] = env.get('RELAY_REPLY_WARNING') == '1'
    if data['reply_warning_requested']:
        warning = STARTED['reply_warning'](env, session, window)
        data['reply_warning_checked'] = True
        if warning:
            data['reply_warning'] = warning
            print(warning)
    if env.get('RELAY_WATCH_MINUTES'):
        data['watch_minutes'] = int(env['RELAY_WATCH_MINUTES'])
        if not 1 <= data['watch_minutes'] <= 1440 or not data['identity'] or source.get('pane') == data['identity']['pane']:
            raise RoutingError('watch requires 1..1440 minutes and a distinct live target')
    path = folder / (data['id'] + '.json')
    data['record'] = str(path)
    with path.with_suffix('.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        save(path, data)
        event(folder, data, 'attempt', message=message, session=session, window=window)
        backlog = any(other != path and json.loads(other.read_text()).get('state') == 'queued' for other in folder.glob('*.json'))
        if data['identity'] and (backlog or not operator and not stable_screen(env, data['identity'])):
            code, output = 5, 'cc-msg: target screen is changing or has pending messages; no target input was sent\n'
        else:
            previous_handlers = {}
            def interrupted(signum, frame):
                raise RuntimeError(f'initial attempt interrupted by signal {signum}; delivery unknown; no automatic resend')
            for signum in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
                previous_handlers[signum] = signal.signal(signum, interrupted)
            try:
                code, output = deliver(data, env)
            except BaseException as error:
                finish(folder, path, data, 'unknown', 4, str(error) + '; inspect target before an explicit resend')
                print(f'relay: unknown {data["id"]}; initial attempt interrupted; review {path}; no automatic resend', file=sys.stderr)
                return 4
            finally:
                for signum, handler in previous_handlers.items():
                    signal.signal(signum, handler)
        if code in (2, 5) and data['identity']:
            finish(folder, path, data, 'queued', 6, output)
            try:
                launch_worker(folder, path, data)
            except OSError as error:
                finish(folder, path, data, 'failed', 7, f'worker could not start: {error}')
                print(f'cc-msg: worker failed; review {path}', file=sys.stderr)
                return 7
            print(f'relay: queued {data["id"]}; automatic retry up to 30 minutes, no action needed; do not resend; record {path}')
            return 6
        finish(folder, path, data, 'delivered' if code == 0 else 'unknown' if code in (3, 4) else 'failed', code, output)
        if code == 0:
            print(f'relay: delivered {data["id"]} to {session}:{window}; composer verified (not an acknowledgment); record {path}')
        elif code in (3, 4):
            print(f'relay: unknown {data["id"]}; inspect target and relay status {data["id"]} before an explicit resend; record {path}')
        else:
            reason = " ".join(output.split())
            print(f'relay: refused {data["id"]}: {reason}; review named target and record {path}')
        return code


if __name__ == '__main__':
    try:
        sys.exit(main())
    except RoutingError as error:
        print(f'relay: {error}; no target input was sent', file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'cc-msg: persistence failure: {error}; delivery must be reviewed; exit 7', file=sys.stderr)
        sys.exit(7)
