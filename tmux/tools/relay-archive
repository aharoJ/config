#!/usr/bin/env python3
import datetime
import json
import os
from pathlib import Path
import sys
import uuid
import unicodedata

os.umask(0o077)
folder = Path.home() / 'desk/tmp/relay'
folder.mkdir(parents=True, exist_ok=True, mode=0o700)
record = os.environ.get('RELAY_MESSAGE_RECORD')
data = json.loads(Path(record).read_text()) if record else None
created = datetime.datetime.fromtimestamp(data['created'], datetime.timezone.utc) if data else datetime.datetime.now(datetime.timezone.utc)
identifier = data['id'] if data else uuid.uuid4().hex
name = created.strftime('%Y%m%dT%H%M%S%f') + '-' + identifier[:8] + '.md'
path = folder / name
content = data['message'].encode('utf-8') if data else Path(sys.argv[1]).read_bytes()
try:
    with path.open('xb') as stream:
        stream.write(content)
        stream.flush()
        os.fsync(stream.fileno())
except FileExistsError:
    if path.read_bytes() != content:
        raise ValueError('archive content changed')
descriptor = os.open(folder, os.O_RDONLY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
source = data['source'] if data else json.loads(os.environ['relay_source_json'])
label = os.environ.get('RELAY_VISIBLE_LABEL')
if not label:
    raise ValueError('verified visible label is required')
message = data['message'] if data else content.decode('utf-8')
message = message.removeprefix(label + ': ')
suffix = ' -- full: ~/desk/tmp/relay/' + name
summary = ' '.join(message.split())[:48].rstrip()
if len(sys.argv) > 2:
    def cells(value):
        return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in 'WF' else 1 for c in value)
    budget = int(sys.argv[2]) - 4 - cells(label + ': ' + suffix)
    while summary and cells(summary) > budget:
        summary = summary[:-1]
print(label + ': ' + summary.rstrip() + suffix)
