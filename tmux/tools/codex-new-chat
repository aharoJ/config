#!/usr/bin/env bash
# path: ~/.config/tmux/tools/codex-new-chat
# description: Start a guarded fresh Codex chat in the same checkout.
# patched: no-op when already fresh; resolve a pending checkout picker to Current checkout
# date: 2026-10-03
set -uo pipefail

fail() { printf 'REFUSE: %s; no target input was sent; safe to retry after the condition clears\n' "$1" >&2; exit 1; }
refuse_copy() { printf 'REFUSE: target %s is in copy mode; no target input was sent; safe to retry after the condition clears\n' "$1" >&2; exit 2; }
unresponsive() { relay_server_unresponsive=1; printf 'REFUSE: tmux server is unresponsive; delivery state is unknown; do not resend automatically\n' >&2; exit 3; }
partial() { printf 'UNVERIFIED: delivery may be partial or unconfirmed: %s; do not resend automatically\n' "$1" >&2; exit 4; }
busy() { printf 'REFUSE: another relay is in progress; no target input was sent; safe to retry after the condition clears\n' >&2; exit 5; }
refuse_draft() { printf 'REFUSE: target %s has %s; no target input was sent; safe to retry after the condition clears\n' "$1" "${2:-an unproven composer state}" >&2; exit 5; }

TIMEOUT_BIN="${TIMEOUT_BIN:-$(command -v timeout || command -v gtimeout || true)}"
TMUX_BIN="${TMUX_BIN:-tmux}"
TMUX_TIMEOUT_SECONDS="${TMUX_TIMEOUT_SECONDS:-1}"
TMUX_TIMEOUT_KILL_AFTER="${TMUX_TIMEOUT_KILL_AFTER:-1}"
RELAY_LOCK_ROOT="${TMUX_RELAY_LOCK_ROOT:-/private/tmp/tmux-$(id -u)/relay-locks}"
LOCK_BIN="${TMUX_RELAY_LOCK_BIN:-/usr/bin/shlock}"
relay_lock=
[ -n "$TIMEOUT_BIN" ] || fail 'timeout or gtimeout is required'
[ -x "$LOCK_BIN" ] || fail 'shlock is required'

relay_script="${BASH_SOURCE[0]}"
while [ -L "$relay_script" ]; do
  relay_script_dir="$(cd -P "$(dirname "$relay_script")" && pwd)" || fail 'cannot resolve relay tool directory'
  relay_link="$(readlink "$relay_script")" || fail 'cannot resolve relay tool path'
  case "$relay_link" in
    /*) relay_script="$relay_link" ;;
    *) relay_script="$relay_script_dir/$relay_link" ;;
  esac
done
relay_script_dir="$(cd -P "$(dirname "$relay_script")" && pwd)" || fail 'cannot resolve relay tool directory'
RELAY_INPUT_GUARD="$relay_script_dir/relay-input-guard"
[ -x "$RELAY_INPUT_GUARD" ] || fail 'relay input guard is required'

release_relay_lock() {
  [ -n "$relay_lock" ] || return 0
  if [ "$(cat "$relay_lock" 2>/dev/null)" = "$$" ]; then
    trash "$relay_lock" || printf 'relay: owned lock cleanup is unconfirmed; may remain at %s\n' "$relay_lock" >&2
  fi
  relay_lock=
}

acquire_relay_lock() {
  local socket identity key code
  socket="$(relay_display "$pane" '#{socket_path}')" || {
    code=$?
    [ "$code" = 75 ] && return 75
    return 1
  }
  [[ "$socket" = /* ]] || return 1
  relay_target_socket="$socket"
  identity="$(stat -Lf '%d:%i' "$socket" 2>/dev/null)" || return 1
  key="$(printf '%s' "$identity:$pane" | shasum -a 256 | awk '{print $1}')" || return 1
  umask 077
  mkdir -p "$RELAY_LOCK_ROOT" || return 1
  relay_lock="$RELAY_LOCK_ROOT/$key"
  "$LOCK_BIN" -f "$relay_lock" -p "$$" >/dev/null 2>&1 || {
    if [ -e "$relay_lock" ]; then relay_lock=; return 5; fi
    relay_lock=; return 1;
  }
}

trap release_relay_lock EXIT

request() {
  "$TIMEOUT_BIN" -k "$TMUX_TIMEOUT_KILL_AFTER" "$TMUX_TIMEOUT_SECONDS" "$TMUX_BIN" "$@"
  local code=$?
  case "$code" in
    124|137|143) return 75 ;;
    *) return "$code" ;;
  esac
}

require_empty_codex_input() {
  local capture state state_after code cursor_x cursor_y in_mode attempts=0
  while [ "$attempts" -lt 24 ]; do
    attempts=$((attempts + 1))
    if state="$(relay_display "$pane" '#{pane_in_mode}:#{cursor_x}:#{cursor_y}')"; then
      :
    else
      code=$?
      [ "$code" = 75 ] && unresponsive
      fail "cannot query target input state for $pane"
    fi
    if [[ "$state" =~ ^([01]):([0-9]+):([0-9]+)$ ]]; then
      in_mode="${BASH_REMATCH[1]}"
      cursor_x="${BASH_REMATCH[2]}"
      cursor_y="${BASH_REMATCH[3]}"
    else
      fail "cannot determine target input state for $pane"
    fi
    [ "$in_mode" = 0 ] || refuse_copy "$pane"
    if capture="$(request capture-pane -p -e -t "$pane")"; then
      :
    else
      code=$?
      [ "$code" = 75 ] && unresponsive
      fail "cannot capture target input for $pane"
    fi
    if state_after="$(relay_display "$pane" '#{pane_in_mode}:#{cursor_x}:#{cursor_y}')"; then
      :
    else
      code=$?
      [ "$code" = 75 ] && unresponsive
      fail "cannot recheck target input state for $pane"
    fi
    if [[ "$state_after" =~ ^([01]):([0-9]+):([0-9]+)$ ]]; then
      [ "${BASH_REMATCH[1]}" = 0 ] || refuse_copy "$pane"
    else
      fail "cannot recheck target input state for $pane"
    fi
    if [ "$state_after" != "$state" ]; then
      sleep 0.05
      continue
    fi
    relay_busy_preflight "$capture" "$cursor_y"
    printf '%s\n' "$capture" | "$RELAY_INPUT_GUARD" '›' "$cursor_x" "$cursor_y" "$relay_verify_width" "$relay_sender_tier"
    code=$?
    case "$code" in
      0) relay_empty_cursor_x="$cursor_x"; relay_empty_cursor_y="$cursor_y"; relay_empty_capture="$capture"; return 0 ;;
      1) refuse_draft "$pane" "$(relay_refusal_reason "$capture")" ;;
      *)
      reason="$(relay_refusal_reason "$capture")"
      [ "$reason" = "a menu/overlay" ] && refuse_draft "$pane" "$reason"
      fail "cannot find Codex prompt in target $pane"
      ;;
    esac
  done
  fail "target composer kept redrawing during inspection; no target input was sent"
}

source "$relay_script_dir/relay-delivery.sh" || fail 'relay delivery module is required'

new_pending_screen() {
  local capture code fresh_footer mode
  mode="$(relay_display "$pane" '#{pane_in_mode}')" || { code=$?; [ "$code" = 75 ] && unresponsive; fail "cannot query target mode for $pane"; }
  [ "$mode" = 0 ] || refuse_copy "$pane"
  capture="$(request capture-pane -p -e -t "$pane")" || { code=$?; [ "$code" = 75 ] && unresponsive; fail "cannot capture target $pane"; }
  printf '%s\n' "$capture" | "$relay_script_dir/codex-new-guard" menu || return 0
  new_target_check || fail "Codex process identity changed before picker resolution"
  new_capture="$capture"
  before_footer=
  new_key menu Enter ''
  local attempts=0
  while [ "$attempts" -lt 40 ]; do
    new_observe
    if fresh_footer="$(printf '%s\n' "$new_capture" | "$relay_script_dir/codex-new-guard" footer)" &&
      printf '%s\n' "$new_capture" | "$relay_script_dir/codex-new-guard" direct-reset "$fresh_footer"; then
      new_idle
      new_finish_reset
      printf 'NEW ok (%s:%s %s); resolved pending checkout picker to Current checkout; fresh context verified (%s)\n' "$target_session" "$window_name" "$pane" "$fresh_footer"
      exit 0
    fi
    attempts=$((attempts + 1))
    sleep 0.1
  done
  partial 'checkout picker was answered but the fresh composer was not verified'
}

new_finish_reset() {
  release_relay_lock
}

new_observe() {
  local state after code
  new_target_check || partial 'Codex foreground process changed'
  state="$(relay_display "$pane" '#{pane_in_mode}:#{pane_dead}:#{pane_pid}:#{pane_current_command}:#{pane_width}:#{pane_height}:#{session_name}:#{window_name}:#{pane_current_path}')" || { code=$?; [ "$code" = 75 ] && unresponsive; partial 'cannot inspect target'; }
  [ "$state" = "0:0:$relay_target_pid:$relay_target_command:$relay_verify_width:$relay_verify_height:$target_session:$window_name:$before_cwd" ] || partial 'target identity, mode, dimensions or cwd changed'
  new_capture="$(request capture-pane -p -e -t "$pane")" || { code=$?; [ "$code" = 75 ] && unresponsive; partial 'cannot capture target'; }
  after="$(relay_display "$pane" '#{pane_in_mode}:#{pane_dead}:#{pane_pid}:#{pane_current_command}:#{pane_width}:#{pane_height}:#{session_name}:#{window_name}:#{pane_current_path}')" || partial 'cannot recheck target'
  [ "$state" = "$after" ] || partial 'target changed during capture'
}
new_withdraw_busy_draft() {
  printf '%s\n' "$new_capture" | "$relay_script_dir/codex-new-guard" busy-slash || return 0
  new_key busy-slash BSpace4
  new_observe
  printf '%s\n' "$new_capture" | perl -pe 's/\e\[[0-9;:]*m//g' | grep -qE '^› /n' && partial 'busy pane: typed /new may remain as a draft'
  printf 'REFUSE: target %s turned busy during reset; the typed /new was withdrawn and nothing was submitted\n' "$pane" >&2
  exit 5
}
new_wait() {
  local attempts=0
  while [ "$attempts" -lt 40 ]; do
    new_observe
    [ "$1" = slash ] && new_withdraw_busy_draft
    if printf '%s\n' "$new_capture" | "$relay_script_dir/codex-new-guard" "$1" "${2:-$before_footer}"; then return; fi
    attempts=$((attempts + 1))
    sleep 0.1
  done
  partial "unrecognized $1 screen; no further input sent"
}
new_destination_wait() {
  local attempts=0
  while [ "$attempts" -lt 40 ]; do
    new_observe
    if printf '%s\n' "$new_capture" | "$relay_script_dir/codex-new-guard" menu "$before_footer"; then
      new_destination=menu
      return
    fi
    if printf '%s\n' "$new_capture" | "$relay_script_dir/codex-new-guard" direct-reset "$before_footer"; then
      new_destination=reset
      return
    fi
    attempts=$((attempts + 1))
    sleep 0.1
  done
  partial 'unrecognized menu or reset screen; no further input sent'
}
new_key() {
  local check nested receipt code screen_guard key=${2:-Enter} expected=${3:-$before_footer}
  case "$key" in Enter|Up|Down|s) ;; BSpace4) key='BSpace BSpace BSpace BSpace' ;; *) partial "unsupported restoration key" ;; esac
  check="$(python3 - "$relay_script_dir/codex-new-guard" "$relay_target_socket" "$pane" "$1" "$expected" "$before_cwd" "$new_target_proof" <<'PY2'
import shlex,sys
print(shlex.join(sys.argv[1:2]+['live']+sys.argv[2:]))
PY2
)" || partial 'cannot build screen guard'
  screen_guard="$(printf "%s\n" "$new_capture" | "$relay_script_dir/codex-new-guard" tmux-rows "$before_cwd")" || partial "cannot build atomic screen guard"
  nested="$("$relay_payload_guard" tmux-nested "$pane" "#{&&:$screen_guard,#{&&:#{==:#{pane_in_mode},0},#{&&:#{==:#{pane_pid},$relay_target_pid},#{&&:#{==:#{pane_current_command},$relay_target_command},#{&&:#{==:#{session_name},$target_session},#{&&:#{==:#{window_name},$window_name},#{&&:#{==:#{pane_width},$relay_verify_width},#{==:#{pane_height},$relay_verify_height}}}}}}}}" "send-keys -t $pane $key ; display-message -p -t $pane '__NEW_SENT__'" "display-message -p -t $pane '__NEW_REFUSED__'")" || partial 'cannot build Enter guard'
  receipt="$(request if-shell -t "$pane" "$check" "$nested" "display-message -p -t $pane '__NEW_REFUSED__'")"
  code=$?
  [ "$code" = 75 ] && unresponsive
  [ "$code" = 0 ] && [ "$receipt" = __NEW_SENT__ ] || partial 'screen changed before guarded key or delivery is unknown'
}

new_idle() {
  local state after
  new_observe
  state="$(relay_display "$pane" '#{cursor_x}:#{cursor_y}')" || partial 'cannot inspect restored composer'
  [[ "$state" =~ ^([0-9]+):([0-9]+)$ ]] || partial 'unrecognized restored cursor'
  relay_empty_cursor_x="${BASH_REMATCH[1]}"
  relay_empty_cursor_y="${BASH_REMATCH[2]}"
  printf '%s\n' "$new_capture" | "$RELAY_INPUT_GUARD" '›' "$relay_empty_cursor_x" "$relay_empty_cursor_y" "$relay_verify_width" strict || partial 'restoration composer is not proven idle'
  after="$(relay_display "$pane" '#{cursor_x}:#{cursor_y}')" || partial 'cannot recheck restored cursor'
  [ "$state" = "$after" ] || partial 'restoration composer changed during capture'
  (relay_busy_preflight "$new_capture" "$relay_empty_cursor_y") 2>/dev/null || partial "reset target entered a busy state"
  relay_empty_capture="$new_capture"
}
new_select() {
  local mode=$1 indices selected desired next direction observed attempts moves=0
  while [ "$moves" -lt 12 ]; do
    new_wait "$mode"
    indices="$(printf '%s\n' "$new_capture" | "$relay_script_dir/codex-new-guard" "navigate-$mode" "$before_footer")" || partial 'unrecognized model/effort picker'
    [[ "$indices" =~ ^([0-9]+):([0-9]+)$ ]] || partial 'unrecognized picker coordinates'
    selected="${BASH_REMATCH[1]}"; desired="${BASH_REMATCH[2]}"
    [ "$selected" = "$desired" ] && return
    if [ "$selected" -lt "$desired" ]; then direction=Down; next=$((selected+1)); else direction=Up; next=$((selected-1)); fi
    new_key "$mode" "$direction"
    attempts=0
    while [ "$attempts" -lt 40 ]; do
      new_observe
      observed="$(printf '%s\n' "$new_capture" | "$relay_script_dir/codex-new-guard" "navigate-$mode" "$before_footer")" || partial 'picker changed to an unfamiliar screen'
      [ "$observed" = "$next:$desired" ] && break
      [ "$observed" = "$selected:$desired" ] || partial 'picker selection changed unexpectedly'
      attempts=$((attempts+1))
      sleep 0.1
    done
    [ "$attempts" -lt 40 ] || partial 'picker movement could not be verified'
    moves=$((moves+1))
  done
  partial 'picker did not reach the required model/effort'
}

[ "$#" = 1 ] && [ -n "${1:-}" ] || { printf 'usage: codex-new-chat <window-name>\n' >&2; exit 1; }
window_name=$1
message=/new
[ -n "${TMUX:-}" ] || fail 'TMUX is not set'
target_session="${CODEX_SEND_SESSION:-}"
case "$target_session" in
  ''|*[!A-Za-z0-9_-]*) fail 'CODEX_SEND_SESSION is required and may contain only letters, digits, underscores, or hyphens' ;;
esac
case "$window_name" in
  ''|*[!A-Za-z0-9_-]*) fail 'window name may contain only letters, digits, underscores, or hyphens' ;;
esac

list_file="$(mktemp "${TMPDIR:-/tmp}/codex-new-chat-list.XXXXXX")" || fail 'scratch file unavailable'
if request list-panes -a -F '#{pane_id} #{session_name} #{window_name} #{pane_current_command}' > "$list_file"; then
  :
else
  code=$?
  trash "$list_file" || printf 'relay: list scratch cleanup is unconfirmed; may remain at %s\n' "$list_file" >&2
  list_file=
  [ "$code" = 75 ] && unresponsive
  fail 'cannot query tmux panes'
fi
target_count="$(awk -v session="$target_session" -v window="$window_name" '("" $2) == ("" session) && ("" $3) == ("" window) { n++ } END { print n + 0 }' "$list_file")"
pane="$(awk -v session="$target_session" -v window="$window_name" '("" $2) == ("" session) && ("" $3) == ("" window) { print $1 }' "$list_file")"
command_name="$(awk -v session="$target_session" -v window="$window_name" '("" $2) == ("" session) && ("" $3) == ("" window) { print $4 }' "$list_file")"
trash "$list_file" || printf 'relay: list scratch cleanup is unconfirmed; may remain at %s\n' "$list_file" >&2
list_file=
case "$target_count" in
  0) fail "no target window $target_session:$window_name" ;;
  1) ;;
  *) fail "target window $target_session:$window_name is ambiguous" ;;
esac
case "$command_name" in
  fish|bash|zsh|sh|dash|tmux) fail "pane $pane is running '$command_name', not Codex; refuse" ;;
esac

relay_target_window="$window_name"
relay_glyph="›"
if acquire_relay_lock; then
  :
else
  code=$?
  case "$code" in
    5) busy ;;
    75) unresponsive ;;
    *) fail "cannot establish target relay lock" ;;
  esac
fi
case "$command_name" in codex|node) ;; *) fail "target process is not Codex" ;; esac
new_target_proof="$("$relay_script_dir/codex-target-guard" "$relay_target_socket" "$pane")" || fail "foreground process is not proven Codex"
new_target_check() {
  "$relay_script_dir/codex-target-guard" "$relay_target_socket" "$pane" "$new_target_proof"
}
prepare_payload "$message"
relay_sender_tier=strict
before_cwd="$(relay_display "$pane" "#{pane_current_path}")" || { code=$?; [ "$code" = 75 ] && unresponsive; fail "cannot read cwd"; }
new_pending_screen
require_empty_codex_input
sleep 0.04
require_empty_codex_input

new_busy_sweep() {
  local capture code samples=0
  while [ "$samples" -lt "${CODEX_NEW_BUSY_SAMPLES:-30}" ]; do
    capture="$(request capture-pane -p -e -t "$pane")" || { code=$?; [ "$code" = 75 ] && unresponsive; fail "cannot capture target $pane"; }
    printf '%s\n' "$capture" | "$relay_script_dir/codex-new-guard" busy && refuse_draft "$pane" 'an agent busy state'
    samples=$((samples + 1))
    sleep 0.05
  done
}
printf '%s\n' "$relay_empty_capture" | "$relay_script_dir/codex-new-guard" busy && refuse_draft "$pane" 'an agent busy state'
new_busy_sweep
require_empty_codex_input
before_footer="$(printf "%s\n" "$relay_empty_capture" | "$relay_script_dir/codex-new-guard" footer)" || fail "unrecognized model/cwd footer"
if printf '%s\n' "$relay_empty_capture" | "$relay_script_dir/codex-new-guard" direct-reset "$before_footer"; then
  new_finish_reset
  printf 'NEW ok (%s:%s %s); already fresh, model and cwd verified\n' "$target_session" "$window_name" "$pane"
  exit 0
fi
"$relay_script_dir/codex-new-guard" supported-footer "$before_footer" < /dev/null || fail "unsupported model/effort; cannot prove restoration"
new_target_check || fail "Codex process identity changed before paste"
if atomic_text "$message"; then
  :
else
  code=$?
  case "$code" in
    2) refuse_copy "$pane" ;;
    3) refuse_draft "$pane" "an unproven composer state" ;;
    6) fail "target identity changed before paste" ;;
    7) fail "cannot prepare literal payload before paste" ;;
    75) unresponsive ;;
    *) partial "literal delivery outcome is unknown for $pane" ;;
  esac
fi

new_wait slash
new_key slash
new_destination_wait
if [ "$new_destination" = menu ]; then
  new_key menu
  new_wait reset
fi
if ! printf '%s\n' "$new_capture" | "$relay_script_dir/codex-new-guard" fresh "$before_footer"; then
  restore_footer="$(printf '%s\n' "$new_capture" | "$relay_script_dir/codex-new-guard" footer)" || partial 'unrecognized reset model footer'
  new_idle
  printf '%s' /model > "$relay_payload_file" || partial 'cannot prepare model command'
  new_target_check || partial "Codex process changed before model paste"
  if atomic_text /model; then :; else code=$?; [ "$code" = 75 ] && unresponsive; partial 'model-command paste could not be verified'; fi
  new_wait model-slash "$restore_footer"
  new_key model-slash Enter "$restore_footer"
  new_select models
  new_key models Enter
  new_select efforts
  case "$before_footer" in
    *' max · '*|*' ultra · '*)
      new_key efforts Enter
      new_select advanced
      new_key advanced s
      ;;
    *) new_key efforts s ;;
  esac
fi
new_wait fresh
new_wait direct-reset
new_idle
new_finish_reset
printf 'NEW ok (%s:%s %s); fresh context, model and cwd verified\n' "$target_session" "$window_name" "$pane"
