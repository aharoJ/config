import ctypes
import json
import os
from pathlib import Path
import pwd
import re
import runpy
import stat
import sys

LABEL = runpy.run_path(str(Path(__file__).with_name('relay-sender-label')))
HOME_ROOT = Path(pwd.getpwuid(os.getuid()).pw_dir)
TEST_ATTESTATIONS = None
TEST_SOCKET = None


def executable(pid):
    if sys.platform != 'darwin':
        return Path('/proc', str(pid), 'exe').resolve(strict=True)
    buffer = ctypes.create_string_buffer(4096)
    if ctypes.CDLL('/usr/lib/libproc.dylib').proc_pidpath(int(pid), buffer, len(buffer)) <= 0:
        raise ValueError('process executable unavailable')
    return Path(os.fsdecode(buffer.value)).resolve(strict=True)


def stamp(path):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid not in (0, os.getuid()) or info.st_mode & 0o022:
        raise ValueError('unsafe agent installation')
    for parent in path.parents:
        row = parent.lstat()
        if not stat.S_ISDIR(row.st_mode) or row.st_uid not in (0, os.getuid()) or row.st_mode & 0o022:
            raise ValueError('unsafe agent installation directory')
    return [str(path), info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns]


def installation(path):
    value = str(path)
    home = re.escape(str(HOME_ROOT))
    if re.fullmatch(home + r'/\.local/share/claude/versions/\d+\.\d+\.\d+(?:[-+][\w.-]+)?', value):
        return 'claude'
    if re.fullmatch(home + r'/\.codex/packages/app-server-daemon/releases/[^/]+/(?:bin/)?codex', value):
        return 'codex'
    if re.fullmatch(home + r'/\.local/share/fnm/node-versions/v[^/]+/installation/lib/node_modules/@openai/codex/node_modules/@openai/codex-[^/]+/vendor/[^/]+/(?:codex|bin)/codex', value):
        return 'codex'
    return 'agy' if path == HOME_ROOT / '.local/bin/agy' else None


def node_root(path):
    value = str(path)
    home = re.escape(str(HOME_ROOT))
    match = re.fullmatch(r'(' + home + r'/\.local/share/fnm/node-versions/v[^/]+/installation)/bin/node', value)
    if match:
        return Path(match[1]) / 'lib/node_modules'
    match = re.fullmatch(r'(/(?:opt/homebrew|usr/local)/Cellar/node(?:@\d+)?/[^/]+)/bin/node', value)
    return Path('/opt/homebrew/lib/node_modules' if value.startswith('/opt/homebrew/') else '/usr/local/lib/node_modules') if match else None


def fixture_proof(exe, argv):
    if TEST_ATTESTATIONS is None or TEST_SOCKET is None:
        return None
    module = Path(__file__).resolve()
    registry = Path(TEST_ATTESTATIONS)
    if not any(module.is_relative_to(HOME_ROOT / 'desk' / part) and registry.is_relative_to(HOME_ROOT / 'desk' / part) for part in ('lab', 'tmp')):
        raise ValueError('test attestation outside private fixtures')
    sock = Path(TEST_SOCKET)
    info = sock.lstat()
    if not re.fullmatch(r'ccmsg-lab-private-\d+', sock.name) or not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
        raise ValueError('test attestation requires a private socket')
    before = stamp(registry)
    data = json.loads(registry.read_text())
    entry = Path(argv[1]).resolve(strict=True) if exe.name == 'node' and len(argv) > 1 and not argv[1].startswith('-') else None
    for row in data:
        if row.get('app') not in ('claude', 'codex', 'agy') or row.get('executable', [None])[0] != str(exe):
            continue
        if row.get('entrypoint', [None])[0] != (str(entry) if entry else None):
            continue
        proof = dict(app=row['app'], executable=stamp(exe), entrypoint=stamp(entry) if entry else [None])
        if proof != row or stamp(registry) != before:
            raise ValueError('test actor attestation changed')
        return proof
    return None


def prove(pid):
    exe = executable(pid)
    argv = LABEL['process_argv'](pid)
    app = installation(exe)
    entry = None
    root = node_root(exe)
    if root and len(argv) > 1 and not argv[1].startswith('-'):
        candidate = Path(argv[1]).resolve(strict=True)
        entries = {'@openai/codex/bin/codex.js':'codex', '@anthropic-ai/claude-code/cli.js':'claude'}
        app = next((kind for relative, kind in entries.items() if candidate == (root / relative).resolve()), None)
        if app:
            entry = candidate
    if app is None:
        return fixture_proof(exe, argv)
    proof = dict(app=app, executable=stamp(exe), entrypoint=stamp(entry) if entry else [None])
    if executable(pid) != exe or LABEL['process_argv'](pid) != argv or stamp(exe) != proof['executable'] or entry and stamp(entry) != proof['entrypoint']:
        raise ValueError('agent executable or entrypoint changed')
    return proof
