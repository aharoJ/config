{
  "runtime": "python3",
  "shell": "fish",
  "plain_commands": ["fish", "bash", "zsh", "sh"],
  "shell_tool": "Bash",
  "environment_file": "panel-env.sh",
  "protocol_import": "import sys,json,pathlib\nsys.dont_write_bytecode=True\nroot=pathlib.Path(sys.argv[1])\nsys.path.insert(0,str(root))\nimport agentic_consumers as consumers,ledger_schema as schema\nassert all(pathlib.Path(m.__file__).resolve().parent==root.resolve() for m in (consumers,schema)), 'wrong protocol module loaded'\nvalue=json.load(sys.stdin)\n",
  "protocol_load": "print('{}')\n",
  "protocol_schema": "rules=schema._load_ledger_schema(str(root))\nprint(json.dumps(schema._js_validate(value,rules['$defs']['agentic_seat'],rules)))\n",
  "protocol_verify": "dispatch=value['dispatch']\ncontext=consumers.resolve_agentic_context(value['project_root'],topic=dispatch['topic'],cycle_type=dispatch['cycle_type'],cycle=dispatch['cycle'],round_no=dispatch['round'],dispatch_evidence_ref=value['authority'],sequence_context=dispatch.get('sequence_context'))\nerrors=consumers.validate_agentic_evidence(value['ledger'],value['project_root'],expected_context=context)\nassert not errors, '\\n'.join(errors)\nprint(json.dumps(sorted(consumers.agentic_pass_sources(value['ledger'],value['project_root'],expected_context=context))))\n"
}
