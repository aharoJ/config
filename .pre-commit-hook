#!/usr/bin/env bash
# -------------------------------------------------------------------
# path:        ~/.config/.pre-commit-hook
# description: blocks staged credentials and private identifiers
# install:     cp .pre-commit-hook .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# -------------------------------------------------------------------

RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
NC='\033[0m'

REPO_ROOT=$(git rev-parse --show-toplevel)

# ── Allowlist ─────────────────────────────────────────────────────
# Files listed in .hook-allowlist skip CONTENT scanning only.
# Path-based blocks (stripe/, gh/) are NEVER skippable.
ALLOWLIST_FILE="$REPO_ROOT/.hook-allowlist"

is_allowlisted() {
  local file="$1"
  [ -f "$ALLOWLIST_FILE" ] || return 1
  grep -qxF "$file" "$ALLOWLIST_FILE" 2>/dev/null
}

# ── 1) Block staged files inside sensitive directories ────────────
BLOCKED_DIRS='(^stripe/|^gh/)'
BLOCKED_DIR_FILES=$(git diff --cached --name-only | grep -iE "$BLOCKED_DIRS" || true)
if [ -n "$BLOCKED_DIR_FILES" ]; then
  echo -e "${RED}BLOCKED: You are about to commit files from a sensitive directory${NC}"
  echo "These files must NEVER enter git history."
  echo -e "${YELLOW}Files:${NC}"
  echo "$BLOCKED_DIR_FILES" | while read -r f; do
    echo -e "  ${CYAN}$f${NC}"
  done
  echo ""
  echo "Run: git reset HEAD <file>"
  exit 1
fi

# ── 2) Block sensitive paths (credentials, env backups, .env) ─────
BLOCKED_PATHS='(credentials|env\.bak|\.env)'
BLOCKED_FILES=$(git diff --cached --name-only | grep -iE "$BLOCKED_PATHS" || true)
if [ -n "$BLOCKED_FILES" ]; then
  echo -e "${RED}BLOCKED: Staged files match sensitive path patterns${NC}"
  echo -e "${YELLOW}Files:${NC}"
  echo "$BLOCKED_FILES" | while read -r f; do
    echo -e "  ${CYAN}$f${NC}"
  done
  echo ""
  echo "Run: git reset HEAD <file>"
  exit 1
fi

python3 - "$REPO_ROOT" <<'PY'
import json
import pathlib
import re
import subprocess
import sys
import unicodedata

root = pathlib.Path(sys.argv[1])
names = subprocess.check_output(['git', 'diff', '--cached', '--name-only', '--diff-filter=ACMR', '-z'], cwd=root).split(b'\0')
email = re.compile(r'[A-Za-z0-9_.+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}')
mac = re.compile(r'(?<![\w:])(?:[0-9a-f]{2}:){5}[0-9a-f]{2}(?![\w:])', re.I)
absolute = re.compile(r'(?:/' + r'Users/[^/\s"\x1b]+|/' + r'home/[^/\s"\x1b]+)')
private_capture = re.compile(r'(?:~/|/)(?:desk/(?:audits|incidents)|private/tmp/[^\s]*audit)[^\s]*', re.I)
ansi = re.compile(r'\x1b\[[0-9;]*m')
issues = []
for raw in names:
    if not raw:
        continue
    name = raw.decode('utf-8', errors='surrogateescape')
    result = subprocess.run(['git', 'show', ':' + name], cwd=root, capture_output=True)
    if result.returncode:
        issues.append((name, 0, 'staged blob unreadable'))
        continue
    if b'\0' in result.stdout:
        if name.startswith('tmux/tests/fixtures/'):
            issues.append((name, 0, 'binary terminal fixture'))
        continue
    fixture = name.startswith('tmux/tests/fixtures/')
    for number, line in enumerate(result.stdout.decode('utf-8', errors='replace').splitlines(), 1):
        plain = unicodedata.normalize('NFKC', ansi.sub('', line))
        for match in email.finditer(plain):
            domain = match.group().rsplit('@', 1)[1].lower()
            if domain not in {'example.org', 'example.com', 'example.net', 'example.invalid'} and match.group().lower() != 'noreply@openai.com':
                issues.append((name, number, 'personal email'))
        if mac.search(plain):
            issues.append((name, number, 'device MAC'))
        for match in absolute.finditer(plain):
            if not (name.startswith('tmux/tests/') and match.group() == '/' + 'Users/tester'):
                issues.append((name, number, 'machine-specific home path'))
        if private_capture.search(plain) and (fixture or pathlib.Path(name).suffix not in {'.fish', '.py', '.sh', '.lua'}):
            issues.append((name, number, 'private capture path'))
    if fixture and name.endswith('.json'):
        try:
            data = json.loads(result.stdout)
            def inspect(value):
                if isinstance(value, dict):
                    if 'source' in value and ('capture_file' in value or 'meta_file' in value):
                        if value.get('sanitized') is not True or not value['source'].startswith('/fixtures/'):
                            issues.append((name, 0, 'raw capture provenance'))
                    for child in value.values():
                        inspect(child)
                elif isinstance(value, list):
                    for child in value:
                        inspect(child)
            inspect(data)
        except (ValueError, TypeError):
            issues.append((name, 0, 'invalid fixture manifest'))
for name, line, kind in sorted(set(issues)):
    print(f'BLOCKED: {name}:{line}: {kind}; value redacted', file=sys.stderr)
sys.exit(bool(issues))
PY
if [ "$?" -ne 0 ]; then
  exit 1
fi

# ── 3) Scan staged content for sensitive patterns ────────────────
PATTERNS=(
  'PRIVATE KEY'
  'BEGIN RSA'
  'BEGIN EC'
  'BEGIN DSA'
  'BEGIN OPENSSH'
  'password\s*[:=]'
  'passwd\s*[:=]'
  'secret\s*[:=]'
  'api_key\s*[:=]'
  'api[-_]?secret'
  'access_token'
  'auth_token'
  'client[_-]secret'
  'tenant[_-]id'
  'AWS_ACCESS_KEY'
  'AWS_SECRET'
  'AKIA[0-9A-Z]{16}'
  'ghp_[a-zA-Z0-9]{36}'
  'sk-[a-zA-Z0-9]{48}'
  'xox[bpoas]-[0-9a-zA-Z]+'
  'mongodb(\+srv)?://[^\s]+'
  'postgres(ql)?://[^\s]+'
  'mysql://[^\s]+'
  'jdbc:[^\s]+'
  'spring\.datasource\.'
  'AZURE_'
  'MSAL_'
  'sk_test_[a-zA-Z0-9]+'
  'sk_live_[a-zA-Z0-9]+'
  'pk_test_[a-zA-Z0-9]+'
  'pk_live_[a-zA-Z0-9]+'
  'sk-[a-zA-Z0-9]{32}'              # DeepSeek / short sk- keys (32-char hex)
  'sk\\x2d[a-zA-Z0-9]{32}'          # fish_variables encodes - as \x2d
  'SETUVAR.*api[_-]?key'            # any fish universal-var API key export
  'SETUVAR.*token'                  # any fish universal-var token export
  'SETUVAR.*secret'                 # any fish universal-var secret export
  'DEEPSEEK_API_KEY'                # belt-and-suspenders for DeepSeek specifically
)

COMBINED=$(IFS='|'; echo "${PATTERNS[*]}")

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -z "$STAGED_FILES" ]; then
  echo -e "${GREEN}Pre-commit check passed.${NC}"
  exit 0
fi

FOUND_ISSUES=false

for file in $STAGED_FILES; do
  # Skip allowlisted files (documentation that references patterns)
  if is_allowlisted "$file"; then
    continue
  fi

  MATCHES=$(git diff --cached -U0 -- "$file" \
    | grep '^+' \
    | grep -v '^+++' \
    | grep -iE "$COMBINED" \
    || true)

  if [ -n "$MATCHES" ]; then
    if [ "$FOUND_ISSUES" = false ]; then
      echo -e "${RED}BLOCKED: Potential sensitive data detected in staged changes${NC}"
      echo ""
      FOUND_ISSUES=true
    fi

    echo -e "  ${CYAN}$file${NC}"
    echo "$MATCHES" | head -5 | while read -r line; do
      echo -e "    ${YELLOW}$line${NC}"
    done
    echo ""
  fi
done

if [ "$FOUND_ISSUES" = true ]; then
  echo "If this is a false positive, commit with: git commit --no-verify"
  echo "But think twice. Think three times."
  exit 1
fi

echo -e "${GREEN}Pre-commit check passed.${NC}"
exit 0
